---
import '../styles/site.css';

interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  lastDate?: string;
  // 首頁要一頁高，塞不下完整頁首頁尾：bare 模式只留頁面自己的內容
  bare?: boolean;
  // 麵包屑：不畫在畫面上（版面是一頁高，塞不下），只輸出 BreadcrumbList。
  // 首頁那一層由這裡自己補，呼叫端只給下層。
  crumbs?: Crumb[];
  // 這一頁描述的資料集。給了就輸出 Dataset：這個站的本體就是政府開放資料的加值整理，
  // Dataset 是最貼的型別，而且它的必填欄位（授權、來源機關、時間範圍）正好就是
  // 最容易被生成引擎講錯的那幾個前提。
  dataset?: {
    name: string; description: string; temporalStart?: string; spatial?: any; unit?: string;
    // 肉蛋不是農糧署的資料（毛豬走農業部、家禽走中央畜產會），來源機關要跟著換
    creator?: { name: string; url: string }; isBasedOn?: string;
  };
  // FAQPage 的問答。答案一律取自頁面上已經顯示的數字，不另外寫內容。
  faq?: { q: string; a: string }[];
  // 清單頁（榜單、品項清單、市場清單）的項目。ItemList 讓引擎知道這頁的本體是一份排序清單，
  // 「台灣現在最便宜的蔬菜」這種問法要的就是這個。
  itemList?: { name: string; path: string }[];
}
const {
  title, description, noindex = false, canonical, lastDate, bare = false,
  crumbs, dataset, faq, itemList,
} = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const url = canonical ?? `${site}${Astro.url.pathname}`;

// og:image 目前是站台圖示。要換成「帶當頁數字的圖」需要在 build 期間點陣化中文字型，
// 靜態站沒有那個相依，所以先給圖示——有總比分享出去一片空白好。
const ogImage = `${site}/icon-512.png`;

// 呼叫端傳進來的 lastDate 是民國格式（給人看的），schema.org 的 temporalCoverage 要西元 ISO
const lastDateIso = (() => {
  const m = /^(\d+)\/(\d{2})\/(\d{2})$/.exec(lastDate ?? '');
  return m ? `${Number(m[1]) + 1911}-${m[2]}-${m[3]}` : null;
})();

const LICENSE = 'https://data.gov.tw/license';
const PUBLISHER = { '@type': 'GovernmentOrganization', name: '農業部農糧署', url: 'https://www.afa.gov.tw/' };

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site}/#website`,
    name: '好康 hó-khang',
    alternateName: '好康農產品行情',
    url: `${site}/`,
    inLanguage: 'zh-Hant-TW',
    description: '台灣農產品批發行情。主數字是比近三年同一旬便宜或貴幾 %，不是價格。',
    publisher: { '@id': `${site}/#org` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site}/#org`,
    name: '好康 hó-khang',
    url: `${site}/`,
    logo: { '@type': 'ImageObject', url: `${site}/icon-512.png`, width: 512, height: 512 },
  },
  // dateModified 是新鮮度訊號：這個站的賣點就是每天更新，但沒有這個欄位，
  // 引擎只能從 sitemap 的 lastmod 猜。用資料的最後交易日，不是 build 時間。
  lastDateIso && {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${url}#page`,
    url,
    name: title,
    ...(description ? { description } : {}),
    inLanguage: 'zh-Hant-TW',
    isPartOf: { '@id': `${site}/#website` },
    dateModified: lastDateIso,
  },
  crumbs?.length && {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: '首頁', path: '/' }, ...crumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.name,
      item: `${site}${c.path}`,
    })),
  },
  dataset && {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: dataset.name,
    description: dataset.description,
    url,
    inLanguage: 'zh-Hant-TW',
    license: LICENSE,
    isAccessibleForFree: true,
    creator: dataset.creator ? { '@type': 'GovernmentOrganization', ...dataset.creator } : PUBLISHER,
    publisher: { '@type': 'Organization', name: '好康 hó-khang', url: `${site}/` },
    // AI 引擎判斷「這個數字哪裡來的」看的是 citation，不是 isBasedOn（後者是給人看的參考連結）。
    // 一律指回頁面已經在用的官方機關與來源網址，不另外編造。
    citation: {
      '@type': 'CreativeWork',
      name: `${dataset.creator?.name ?? PUBLISHER.name}官方行情資料`,
      url: dataset.creator?.url ?? PUBLISHER.url,
    },
    ...(dataset.temporalStart && lastDateIso
      ? { temporalCoverage: `${dataset.temporalStart}/${lastDateIso}` } : {}),
    spatialCoverage: dataset.spatial ?? { '@type': 'Place', name: '臺灣' },
    ...(dataset.unit ? { variableMeasured: { '@type': 'PropertyValue', name: '價格', unitText: dataset.unit } } : {}),
    isBasedOn: dataset.isBasedOn ?? 'https://data.moa.gov.tw/open_detail.aspx?id=037',
  },
  faq?.length && {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  itemList?.length && {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: title,
    numberOfItems: itemList.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: itemList.map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.name,
      url: `${site}${it.path}`,
    })),
  },
].filter(Boolean);
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url} />
    {/* SVG 給現代瀏覽器，ico 是 Google 搜尋結果與舊瀏覽器的後備（兩者都要，Google 不保證讀 SVG）；
        apple-touch-icon 是 iOS 加到主畫面時用的，沒有它 iOS 會自己截圖當圖示。 */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1e8050" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800&family=Noto+Sans+TC:wght@400;500;700;900&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content="好康 hó-khang" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />

    {/* 結構化資料。noindex 的頁不輸出——那些頁本來就不想被收錄，
        給了反而是在請引擎理解一個我們說不要收的頁面。 */}
    {!noindex && jsonLd.map((o) => (
      <script type="application/ld+json" set:html={JSON.stringify(o)} />
    ))}

    {/* Google Analytics 4。measurement ID 本來就是公開值（會出現在原始碼裡），不是密鑰。
        用 is:inline 讓 Astro 原樣輸出，不要打包成模組。 */}
    <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-M3SP6K8WTN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-M3SP6K8WTN');
    </script>

    <slot name="head" />
  </head>
  <script is:inline>
    // 買菜清單：存在這台瀏覽器裡，不上傳、不需登入。
    // 第一次來是空的，由首頁用 list-source.json 的 defaults 帶入一組家常菜。
    window.hk = {
      KEY: 'hk.list',
      read() {
        try {
          const v = JSON.parse(localStorage.getItem(this.KEY) || 'null');
          return Array.isArray(v) ? v : null;   // null = 還沒初始化過
        } catch { return null; }
      },
      write(slugs) {
        try { localStorage.setItem(this.KEY, JSON.stringify([...new Set(slugs)])); } catch {}
        document.dispatchEvent(new CustomEvent('hk:list'));
      },
      has(slug) { return (this.read() || []).includes(slug); },
      add(slug) { this.write([...(this.read() || []), slug]); },
      remove(slug) { this.write((this.read() || []).filter((s) => s !== slug)); },
      toggle(slug) { this.has(slug) ? this.remove(slug) : this.add(slug); return this.has(slug); },
    };
    // 品項頁的「加入買菜清單」按鈕
    document.addEventListener('DOMContentLoaded', () => {
      for (const btn of document.querySelectorAll('[data-add-slug]')) {
        const slug = btn.dataset.addSlug;
        const sync = () => {
          const inList = window.hk.has(slug);
          btn.dataset.in = inList ? '1' : '0';
          btn.textContent = inList ? '✓ 已在買菜清單' : '＋ 加入買菜清單';
        };
        btn.addEventListener('click', () => { window.hk.toggle(slug); sync(); });
        document.addEventListener('hk:list', sync);
        sync();
      }
    });
  </script>
  <body>
    {!bare && (
      <header class="site-hd">
        <div class="shell bar">
          <a class="brand" href="/">好康 hó-khang</a>
          <nav>
            <a href="/cheap/">這週划算</a>
            <a href="/crop/">找食材</a>
            <a href="/market/">市場</a>
            <a href="/about/">關於資料</a>
          </nav>
        </div>
      </header>
    )}

    <main>
      <slot />
    </main>

    {!bare && (
      <footer class="site-ft">
        <div class="shell">
          <p>
            資料來源：農業部農糧署「農產品交易行情」（政府資料開放授權條款第 1 版）。
            {lastDate && <> 最新交易日 {lastDate}。</>}
          </p>
          <p class="muted">
            本站只呈現農糧署輔導的行情報導站資料，並非全台所有批發市場；臺南沒有蔬果行情，只有花卉。
            批發價為交易量加權平均，單位元/公斤；零售價為臺中市公有零售市場實測，單位元/台斤。
          </p>
        </div>
      </footer>
    )}
  </body>
</html>
