---
// 看得到的問答區塊。答案一律由頁面既有的資料與數字組成（和答案句、清單同一批變數），
// 算不出來的題目由呼叫端整題拿掉。不輸出 FAQPage JSON-LD：Google 2026-05-07 起停止顯示。
interface Props { items?: { q: string; a: string }[] }
const items = Astro.props.items ?? [];
---
{items.length > 0 && (
  <section class="faq" aria-labelledby="faq-hd">
    <h2 id="faq-hd">常見問題</h2>
    {items.map((f) => (
      <div class="faq-item">
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </div>
    ))}
  </section>
)}
