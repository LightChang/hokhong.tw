---
// 價格折線圖。純 SVG，不引圖表 library（靜態站 + 規範只用 CSS custom properties）。
//
// 遵循 dataviz：
//   - 單一 y 軸（絕不雙軸）
//   - 多序列一律 emphasis：main 一色、alt 一色、其餘 mute 灰。色彩實測見 site.css 註解
//   - 線 2px、格線與軸為 hairline 實線（禁止虛線）、端點選擇性標註（不是每點都標數字）
//   - >= 2 序列必有 legend，識別不靠顏色單一通道
//   - hover crosshair + tooltip 是加分不是唯一途徑：同一份值一定有 table view
//
// props:
//   series: [{ id, label, role: 'main'|'alt'|'mute', points: [{ x: string, y: number|null }] }]
//   caption, unit, height
const { series = [], caption, unit = '元/公斤', height = 300, tableLabel = '日期' } = Astro.props;

// SVG 只畫繪圖區（線、格線、端點），所有文字都在 HTML 裡。
// 原因：SVG 會被 preserveAspectRatio="none" 拉伸以填滿面板，裡面的 <text> 會跟著縮放變形，
// 手機實測 CSS 寫 22px 的軸字實際只剩高約 13px、寬約 7px，違反最小字級 18px。
// HTML 標籤以百分比定位在繪圖區上，字級照 token，不受 SVG 縮放影響。
const W = 900;
const H = height;
const PAD = { l: 0, r: 0, t: 0, b: 0 };
const plotW = W - PAD.l - PAD.r;
const plotH = H - PAD.t - PAD.b;

// x 軸用第一個序列的點序列當基準（各序列長度可不同，缺值留空）
const base = series.find((s) => s.points?.length)?.points ?? [];
const xs = base.map((p) => p.x);
const allY = series.flatMap((s) => (s.points ?? []).map((p) => p.y)).filter((v) => v != null && Number.isFinite(v));
const yMin = allY.length ? Math.min(...allY) : 0;
const yMax = allY.length ? Math.max(...allY) : 1;
// y 軸從 0 起算只在最小值本來就接近 0 時才合理；價格序列用貼合的範圍並留 8% 餘裕
const lo = yMin > 0 && yMin / yMax > 0.35 ? yMin * 0.92 : 0;
const hi = yMax * 1.08 || 1;

const xAt = (i) => PAD.l + (xs.length <= 1 ? plotW / 2 : (i / (xs.length - 1)) * plotW);
const yAt = (v) => PAD.t + plotH - ((v - lo) / (hi - lo)) * plotH;

const ticks = 4;
const yTicks = Array.from({ length: ticks + 1 }, (_, i) => lo + ((hi - lo) * i) / ticks);
// x 刻度取首尾與中間兩點，避免標籤相撞
const xTickIdx = xs.length <= 2 ? xs.map((_, i) => i)
  : [0, Math.round((xs.length - 1) / 3), Math.round(((xs.length - 1) * 2) / 3), xs.length - 1];
// SVG 座標 → 繪圖區百分比
const pctX = (i) => `${((xAt(i) / W) * 100).toFixed(3)}%`;
const pctY = (v) => `${((yAt(v) / H) * 100).toFixed(3)}%`;
const yLabels = yTicks.map((v) => v.toFixed(0));
// y 軸欄寬以最長標籤的字元數決定（等寬字體，ch 準確）
const yAxisCh = Math.max(...yLabels.map((s) => s.length), 1);

const pathOf = (points) => {
  const byX = new Map((points ?? []).map((p) => [p.x, p.y]));
  let d = '', open = false;
  xs.forEach((x, i) => {
    const v = byX.get(x);
    if (v == null || !Number.isFinite(v)) { open = false; return; }
    d += `${open ? 'L' : 'M'}${xAt(i).toFixed(1)} ${yAt(v).toFixed(1)} `;
    open = true;
  });
  return d.trim();
};

const ordered = [...series].sort((a, b) => (a.role === 'mute' ? -1 : 0) - (b.role === 'mute' ? -1 : 0));
const mainSeries = series.find((s) => s.role === 'main') ?? series[0];
const lastPoint = (() => {
  const pts = (mainSeries?.points ?? []).filter((p) => p.y != null);
  if (!pts.length) return null;
  const p = pts.at(-1);
  return { i: xs.indexOf(p.x), ...p };
})();
const chartId = `c${Math.random().toString(36).slice(2, 8)}`;
const payload = JSON.stringify({
  xs, pad: PAD, plotW, plotH, lo, hi, unit,
  series: series.map((s) => ({ id: s.id, label: s.label, role: s.role, points: s.points ?? [] })),
});
---
<figure class="chart" style="margin:0">
  {caption && <figcaption>{caption}</figcaption>}
  <div class="chart-wrap" style={`--y-axis-ch:${yAxisCh}`}>
    <div class="y-axis" aria-hidden="true">
      {yTicks.map((v, k) => <span style={`top:${pctY(v)}`}>{yLabels[k]}</span>)}
    </div>
    <div class="plot" style={`aspect-ratio:${W}/${H}`}>
      <!-- preserveAspectRatio="none" 讓 SVG 能被拉成容器的高度：viewBox 是 900×260，
           在手機 390px 寬等比縮放後只剩 87px 高，折線會被壓成一條縫。
           這是 SVG 屬性不是 CSS 屬性，寫在樣式表裡不會生效。 -->
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={caption ?? '價格走勢'} data-chart={chartId}>
        <g class="grid">
          {yTicks.map((v) => <line x1={PAD.l} x2={W - PAD.r} y1={yAt(v)} y2={yAt(v)} />)}
        </g>
        {ordered.map((s) => <path class={`line ${s.role ?? 'main'}`} d={pathOf(s.points)} />)}
        <line class="cross" data-cross style="opacity:0" y1={PAD.t} y2={PAD.t + plotH} x1="0" x2="0" />
        <rect class="hit" data-hit x={PAD.l} y={PAD.t} width={plotW} height={plotH} />
      </svg>
      {/* 端點用 HTML 畫：SVG 的 circle 在非等比拉伸下會變成橢圓 */}
      {lastPoint && lastPoint.i >= 0 && (
        <>
          <i class="dot" style={`left:${pctX(lastPoint.i)};top:${pctY(lastPoint.y)}`}></i>
          <span class={`endlabel${yAt(lastPoint.y) / H < 0.3 ? ' below' : ''}`}
            style={`left:${pctX(lastPoint.i)};top:${pctY(lastPoint.y)}`}>{lastPoint.y.toFixed(1)}</span>
        </>
      )}
      <div class="tip" data-tip></div>
    </div>
    <div class="x-axis" aria-hidden="true">
      {xTickIdx.map((i) => (
        <span class={i === 0 ? 'start' : i === xs.length - 1 ? 'end' : 'mid'} style={`left:${pctX(i)}`}>{xs[i]}</span>
      ))}
    </div>
  </div>

  {series.length > 1 && (
    <div class="legend">
      {series.map((s) => (
        <span class={s.role ?? 'main'}><i></i>{s.label}</span>
      ))}
    </div>
  )}

  <details class="table-view">
    <summary>表格檢視（{xs.length} 筆，單位 {unit}）</summary>
    <div class="table-scroll">
      <table>
        <thead>
          <tr><th>{tableLabel}</th>{series.map((s) => <th>{s.label}</th>)}</tr>
        </thead>
        <tbody>
          {xs.map((x) => (
            <tr>
              <td>{x}</td>
              {series.map((s) => {
                const v = (s.points ?? []).find((p) => p.x === x)?.y;
                return <td>{v == null ? '—' : Number(v).toFixed(1)}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>

  <script type="application/json" data-chart-data={chartId} set:html={payload} />
</figure>

<script>
  // hover crosshair + tooltip。值不只存在 tooltip：同一份資料在 table view 裡（規範要求）
  for (const svg of document.querySelectorAll('svg[data-chart]')) {
    const id = svg.dataset.chart;
    const node = document.querySelector(`script[data-chart-data="${id}"]`);
    if (!node) continue;
    const cfg = JSON.parse(node.textContent);
    const wrap = svg.closest('.chart-wrap');
    const tip = wrap.querySelector('[data-tip]');
    const cross = svg.querySelector('[data-cross]');
    const hit = svg.querySelector('[data-hit]');
    const xAt = (i) => cfg.pad.l + (cfg.xs.length <= 1 ? cfg.plotW / 2 : (i / (cfg.xs.length - 1)) * cfg.plotW);

    const move = (ev) => {
      const box = svg.getBoundingClientRect();
      const px = ((ev.clientX - box.left) / box.width) * svg.viewBox.baseVal.width;
      let best = 0, bestD = Infinity;
      cfg.xs.forEach((_, i) => {
        const d = Math.abs(xAt(i) - px);
        if (d < bestD) { bestD = d; best = i; }
      });
      const x = cfg.xs[best];
      const lines = cfg.series
        .map((s) => {
          const v = s.points.find((p) => p.x === x)?.y;
          return v == null ? null : `${s.label} ${Number(v).toFixed(1)}`;
        })
        .filter(Boolean);
      if (!lines.length) return;
      cross.setAttribute('x1', xAt(best));
      cross.setAttribute('x2', xAt(best));
      cross.style.opacity = '1';
      // 序列名稱來自資料（作物名、市場名），一律用 textContent 寫入，不做字串拼 HTML
      tip.textContent = '';
      const strong = document.createElement('strong');
      strong.textContent = x;
      tip.append(strong, ` ${lines.join(' · ')} ${cfg.unit}`);
      tip.style.opacity = '1';
      const left = (xAt(best) / svg.viewBox.baseVal.width) * box.width;
      tip.style.left = `${Math.min(Math.max(left - tip.offsetWidth / 2, 0), box.width - tip.offsetWidth)}px`;
      tip.style.top = '0px';
    };
    const leave = () => { cross.style.opacity = '0'; tip.style.opacity = '0'; };
    hit.addEventListener('mousemove', move);
    hit.addEventListener('mouseleave', leave);
    hit.addEventListener('touchmove', (e) => { if (e.touches[0]) move(e.touches[0]); }, { passive: true });
  }
</script>
