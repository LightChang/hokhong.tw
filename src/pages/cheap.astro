---
import SiteNav from '../components/SiteNav.astro';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import MethodLink from '../components/MethodLink.astro';
import { cheapNow, latestTradedCrops, price, roc, tcLabel, dirClass, changeWord, cattyPrice } from '../lib/pagedata.mjs';

const c = await cheapNow();
const food = (arr) => arr.filter((x) => x.tcType !== 'N06');
const flower = (arr) => arr.filter((x) => x.tcType === 'N06');
const tabs = [
  { id: 'cheap', label: '蔬果變便宜' },
  { id: 'pricey', label: '蔬果變貴' },
  flower(c.cheaper).length > 0 && { id: 'flower', label: '花卉' },
].filter(Boolean);

// 最新行情：最近一次有成交、但不在這份榜單上的品項。榜單只收跟常年比得出漲跌的品項，
// 其餘可收錄品項從這裡也走得到（每天換一批）。
const latestTraded = await latestTradedCrops(20, [...c.cheaper, ...c.pricier].map((x) => x.slug));

const row = (x, i) => ({ ...x, rank: String(i + 1).padStart(2, '0') });

const heading = {
  cheap: `${c.targetXun}哪些蔬果比常年便宜？`,
  pricey: `${c.targetXun}哪些蔬果比常年貴？`,
  flower: `${c.targetXun}的花卉行情`,
};
const answer = `${c.basis}。共 ${c.candidates} 個品項納入比較，`
  + `最便宜的是${food(c.cheaper).slice(0, 3).map((x) => `${x.name}（${changeWord(x.changePct)}）`).join('、')}，`
  + `最貴的是${food(c.pricier).slice(0, 3).map((x) => `${x.name}（${changeWord(x.changePct)}）`).join('、')}。`
  + `資料截至民國 ${roc(c.lastDate)}。`;
// 同一份資料交給 <Base crumbs>（BreadcrumbList）與畫面上的 <Breadcrumbs>
const crumbs = [{ name: '這週划算', path: '/cheap/' }];
---
<Base
  title={`完整榜單：${c.targetXun}什麼便宜、什麼變貴 — 好康`}
  description={`${c.basis}。共 ${c.candidates} 個品項納入比較。`}
  lastDate={roc(c.lastDate)}
  bare={true}
  crumbs={crumbs}
  {/* 這頁的本體就是一份排序清單，「現在最便宜的蔬菜是什麼」要的正是這個 */}
  itemList={food(c.cheaper).map((x) => ({ name: `${x.name}（${changeWord(x.changePct)}）`, path: `/crop/${x.slug}/` }))}
  dataset={{
    name: `台灣農產品${c.targetXun}行情漲跌榜`,
    description: `${c.basis}。共 ${c.candidates} 個品項納入比較，依與近三年同旬的價差排序。`,
    temporalStart: '2012-01-01',
    unit: '元/公斤',
  }}
>
  <div class="shell screen">
    <div class="screen-hd">
      <a class="brand" href="/">好康 hó-khang</a>
      <SiteNav />
    </div>

    <div>
      <Breadcrumbs crumbs={crumbs} />
      {/* 標題不顯示在畫面上：導覽列已經說明你在哪一頁，內容直接開始。
          h1 仍留在 DOM（sr-only）給搜尋引擎與螢幕閱讀器。 */}
      <h1 class="sr-only">{c.targetXun}：什麼便宜、什麼變貴</h1>
      <p class="sr-only">{answer}</p>
    </div>

    <div class="tabs">
      {tabs.map((t, i) => <input type="radio" name="cheaptab" id={`ch-${t.id}`} checked={i === 0} />)}
      <div class="tab-bar">{tabs.map((t) => <label for={`ch-${t.id}`}>{t.label}</label>)}</div>
      <div class="panels">
        {tabs.map((t) => (
          <div class="panel">
            <h2 class="sr-only" id={`ch-${t.id}-hd`}>{heading[t.id]}</h2>
            {(() => {
              const list = (t.id === 'cheap' ? food(c.cheaper) : t.id === 'pricey' ? food(c.pricier)
                : [...flower(c.cheaper), ...flower(c.pricier)].slice(0, 30)).map(row);
              // 台中零售只有部分品項有；整張表都沒有就不開這一欄
              const hasRetail = list.some((x) => x.retail?.perCatty != null);
              return (
                <table class="tbl" aria-labelledby={`ch-${t.id}-hd`}>
                  <thead>
                    <tr>
                      <th scope="col">品項</th>
                      <th scope="col" class="num hide-sm">批發價 元/公斤</th>
                      <th scope="col" class="num hide-sm hide-md">常年同旬 元/公斤</th>
                      {hasRetail && <th scope="col" class="num hide-sm hide-md">台中零售 元/斤</th>}
                      <th scope="col" class="num">跟常年同旬比</th>
                    </tr>
                  </thead>
                  <tbody>
                    {list.map((x) => (
                      <tr>
                        <th scope="row">
                          <span class="muted tabular">{x.rank}</span> <a class="rl" href={`/crop/${x.slug}/`}>{x.name}</a>
                          {x.seasonal && <span class="season-tag"> · 當季</span>}
                          <span class="sub">
                            {/* 窄螢幕收起的欄在這裡補回（only-sm／only-md） */}
                            {tcLabel(x.tcType)}<span class="only-sm"> · 批發 {price(x.wholesale)} 元/公斤</span>
                            <span class="only-md"> · 常年同旬 {price(x.baseline3y)} 元/公斤
                            {cattyPrice(x.retail) ? ` · 台中零售 ${cattyPrice(x.retail)}` : ''}</span>
                          </span>
                        </th>
                        <td class="num tabular hide-sm">{price(x.wholesale)}</td>
                        <td class="num tabular hide-sm hide-md">{price(x.baseline3y)}</td>
                        {hasRetail && <td class="num tabular hide-sm hide-md">{x.retail?.perCatty ?? '—'}</td>}
                        {/* 榜單本身就是按漲跌排序的，色塊會是重複編碼 —— 只有未排序的清單才需要 */}
                        <td class={`num tabular ${dirClass(x.changePct)}`}>{changeWord(x.changePct)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              );
            })()}
          </div>
        ))}
      </div>
    </div>

    {latestTraded.length > 0 && (
      <nav class="siblings" aria-labelledby="new-hd">
        <h2 id="new-hd">最新行情<span class="muted">（不在榜單上的品項，依最近成交日排序，最新是民國 {roc(latestTraded[0].last)}）</span></h2>
        <ul>{latestTraded.map((x) => <li><a href={`/crop/${x.slug}/`}>{x.name}價格</a></li>)}</ul>
      </nav>
    )}

    <div class="screen-ft">
      更新至民國 {roc(c.lastDate)} · <MethodLink to="lists" label="怎麼排的" /> · <a href="/typhoon/">颱風與菜價</a> · <a href="/about/">資料說明</a>
    </div>
  </div>
</Base>
