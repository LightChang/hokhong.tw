---
// 節日要買什麼：這個節日的菜色 → 食材 → 現在貴不貴 → 什麼時候買
//
// 站上其他頁都是「某一樣東西多少錢」，這裡是「一頓飯要買的東西」。菜色與食材的對應
// 在 overrides/festival-menu.json（文化知識，人工維護），價格與往例由轉換層接上。
//
// 兩件事一定要講明，不然這一頁會被讀成它沒有的意思：
//   肉是原料級不是部位級（五花肉、雞腿只能對到毛豬、白肉雞的行情）
//   有些食材我們沒有價格（糯米、蝦米、粽葉、魚…），照實列出，不假裝有
//
// 入口：導覽列「每週菜單」→ /festival/ 總覽（2026-09-28 起常設；也承載季節頁 spring／summer／autumn／winter 與民俗節點頁）、首頁的下一個節日連結、彼此互連。
import SiteNav from '../../components/SiteNav.astro';
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MethodLink from '../../components/MethodLink.astro';
import { festivalMenu, price, roc, dirClass, changeWord, compareWord } from '../../lib/pagedata.mjs';

export async function getStaticPaths() {
  const data = await festivalMenu();
  return (data?.festivals ?? []).map((f) => ({ params: { slug: f.id }, props: { f, lastDate: data.lastDate } }));
}

const { f, lastDate } = Astro.props;
const menuData = await festivalMenu();
const all = menuData?.festivals ?? [];
const siblings = all.filter((x) => x.id !== f.id);
// 季節頁（kind season）顯示「這週」的菜單（不在這一季時是這一季最近的一週），並列出這一季每一週的菜
const isSeason = f.kind === 'season';
const md = (iso) => `${Number(iso.slice(5, 7))}/${Number(iso.slice(8, 10))}`;
const seasonWeeks = isSeason ? (menuData?.weeks ?? []).filter((w) => w.page === f.id) : [];
const shownWeek = isSeason ? seasonWeeks.find((w) => w.iso === f.next?.week) ?? null : null;
// 每週菜單列表：weeks 是從這週起往後 52 週，本主題的週次中間常夾著別的主題（秋季夾重陽、立冬補冬），
// 只列本主題會看起來像漏週。所以依 weeks 的順序切段：同一段內把夾在中間的別主題週也列出來、連過去；
// 相隔超過 GAP 週（例如今年秋天與明年秋天）才另起一段，段落標年份。
// GAP 取 8：冬季中間夾尾牙、送神、春節、天公生、元宵共 6 週，仍要算同一段。
const GAP = 8;
const allWeeks = menuData?.weeks ?? [];
const nameOf = new Map(all.map((x) => [x.id, x.name]));
const weekSegments = (() => {
  const idx = allWeeks.map((w, i) => (w.page === f.id ? i : -1)).filter((i) => i >= 0);
  const segs = [];
  for (const i of idx) {
    const last = segs.at(-1);
    if (last && i - last.to <= GAP) last.to = i; else segs.push({ from: i, to: i });
  }
  const firstYear = allWeeks[0]?.start.slice(0, 4);
  return segs.map(({ from, to }) => {
    const rows = [];
    for (const w of allWeeks.slice(from, to + 1)) {
      const prev = rows.at(-1);
      // 連續幾週同一個別主題（立冬補冬兩週）併成一列
      if (w.page !== f.id && prev?.other && prev.page === w.page) { prev.end = w.end; continue; }
      rows.push(w.page === f.id ? { ...w, other: false } : { other: true, page: w.page, start: w.start, end: w.end, name: nameOf.get(w.page) ?? w.name });
    }
    const year = allWeeks[from].start.slice(0, 4);
    return { year, label: year === firstYear ? `${year} 年` : `明年（${year} 年）`, rows };
  });
})();

// 現在該買：比常年便宜的排前面。沒有比較基準的排最後（不是「不划算」，是「算不出來」）
const byDeal = [...f.ingredients].sort((a, b) => (a.changePct ?? 999) - (b.changePct ?? 999));
const cheap = byDeal.filter((i) => (i.changePct ?? 0) <= -10);
const dear = byDeal.filter((i) => (i.changePct ?? 0) >= 10);
// 食材表：整張表都沒有零售價／產季就不開那一欄
const hasRetail = f.ingredients.some((i) => i.retailPerCatty);
const hasSeason = f.ingredients.some((i) => i.seasonLabel);
// 提前買：這個節日前有漲幅往例的食材（只有春節與端午算得出來，見 transform/festival.mjs）
const early = f.ingredients
  .filter((i) => i.festivalPct != null)
  .sort((a, b) => b.festivalPct - a.festivalPct);

const dishName = new Map(f.dishes.map((d) => [d.dish, d]));
const itemOf = new Map(f.ingredients.map((i) => [i.key, i]));

// 三段依序全部顯示（整頁會捲，不用分頁藏內容），上方一列頁內跳轉連結
const sections = [
  { id: 'now', label: '現在該買什麼', heading: `${f.name}的食材，現在哪些便宜？` },
  { id: 'dishes', label: '逐道菜', heading: `${f.name}有哪幾道菜、各要什麼食材？` },
  early.length > 0 && { id: 'early', label: '要提前買的', heading: `${f.name}前哪些食材會漲、要提前買？` },
].filter(Boolean);

// h1 與 <title> 同一句（去掉站名），答案句緊接在下面、畫面上看得到（答案先講）
const pageTitle = isSeason ? `${f.name}菜單：這週煮什麼、食材現在貴不貴` : `${f.name}要買什麼？食材價格與什麼時候買`;
const weekLabel = shownWeek ? (shownWeek.thisWeek ? `這週（${md(shownWeek.start)}–${md(shownWeek.end)}）` : `${md(shownWeek.start)}–${md(shownWeek.end)} 那週`) : '';

const answer = [
  isSeason && shownWeek
    ? `${weekLabel}${f.name}菜單是${f.dishes.map((d) => d.dish).join('、')}，`
    : `${f.name}（${f.when}）的 ${f.dishes.length} 道常見菜色是${f.dishes.map((d) => d.dish).join('、')}，`,
  `用到的食材有 ${f.ingredients.length} 樣查得到批發或產地價格。`,
  cheap.length ? `現在比常年同旬便宜的有${cheap.slice(0, 5).map((i) => `${i.name}（${changeWord(i.changePct)}）`).join('、')}。` : '',
  dear.length ? `比常年貴的有${dear.slice(0, 4).map((i) => `${i.name}（${changeWord(i.changePct)}）`).join('、')}。` : '',
  early.length ? `${f.name}前照往例會漲的是${early.slice(0, 3).map((i) => `${i.name}（中位漲 ${i.festivalPct}%，高峰在節前 ${i.festivalDaysBefore} 天）`).join('、')}。` : '',
  `價格截至民國 ${roc(lastDate)}。`,
].join('');

// 同一份資料交給 <Base crumbs>（BreadcrumbList）與畫面上的 <Breadcrumbs>
const crumbs = [{ name: '每週菜單', path: '/festival/' }, { name: isSeason ? `${f.name}菜單` : `${f.name}食材`, path: `/festival/${f.id}/` }];

// 看得到的問答區塊（components/Faq.astro）。答案取自本頁同一批變數；不輸出 FAQPage JSON-LD。
const faq = [
  {
    q: `${f.name}要買哪些食材？`,
    a: `${f.dishes.map((d) => d.dish).join('、')}這 ${f.dishes.length} 道菜，`
      + `用得到的食材裡有 ${f.ingredients.length} 樣查得到價格：${f.ingredients.slice(0, 10).map((i) => i.name).join('、')}。`
      + (f.noPrice.length ? `另外 ${f.noPrice.join('、')}不在農產行情資料裡，本站不顯示價格。` : ''),
  },
  cheap.length > 0 && {
    q: `${f.name}的食材現在哪些划算？`,
    a: `比近三年同一旬便宜的有${cheap.map((i) => `${i.name}${changeWord(i.changePct)}`).join('、')}（全國批發加權均價，民國 ${roc(lastDate)}）。`,
  },
  early.length > 0 && {
    q: `${f.name}的菜要提前多久買？`,
    a: early.slice(0, 6).map((i) => `${i.name}在${f.name}前通常比同時節貴 ${i.festivalPct}%，高峰落在節前 ${i.festivalDaysBefore} 天`).join('；')
      + `。想避開高峰就在那之前買。`,
  },
].filter(Boolean);
---
<Base
  title={`${pageTitle} — 好康`}
  description={`${f.name}的 ${f.dishes.length} 道常見菜色共 ${f.ingredients.length} 樣食材的批發行情：現在哪些比常年便宜、哪些要提前買。`}
  lastDate={roc(lastDate)}
  bare={true}
  crumbs={crumbs}
  itemList={f.ingredients.filter((i) => i.indexable).map((i) => ({ name: i.name, path: i.path }))}
  dataset={{
    name: `${f.name}食材的批發行情`,
    description: `${f.name}常見菜色所需食材的全國批發加權均價與跟近三年同一旬的比較。`
      + `菜色與食材的對應為人工整理（來源見各道菜），價格來自農業部農糧署行情報導站與中央畜產會。`,
    temporalStart: '2012-01-01',
    unit: '元/公斤',
  }}
>
  <div class="shell screen">
    <div class="screen-hd">
      <a class="brand" href="/">好康 hó-khang</a>
      <SiteNav />
    </div>

    <div>
      <Breadcrumbs crumbs={crumbs} />
      <h1>{pageTitle}</h1>
      <p class="answer">{answer}</p>
      <p class="fs-meta">
        {isSeason && shownWeek
          ? <>{f.when}</>
          : <>{f.when}{f.next?.daysUntil != null && <> · 還有 {f.next.daysUntil} 天</>}</>}
        {' '}· {f.dishes.length} 道菜 · {f.ingredients.length} 樣食材查得到價格
      </p>
      {f.note && <p class="note muted">{f.note}</p>}
    </div>

    <nav class="fs-jump" aria-label="本頁段落">
      {sections.map((t) => <a href={`#fs-${t.id}`}>{t.label}</a>)}
    </nav>

    <div class="fs-sections">
        {sections.map((t) => (
          <section class="fs-sec" id={`fs-${t.id}`} aria-labelledby={`fs-${t.id}-hd`}>
            <h2 id={`fs-${t.id}-hd`}>{t.heading}</h2>

            {t.id === 'now' && (
              <>
                {/* 產季、台中零售原本擠在名稱小字裡，跨列比不了；有資料就各開一欄（窄螢幕收回小字） */}
                <table class="tbl" aria-labelledby={`fs-${t.id}-hd`}>
                  <thead>
                    <tr>
                      <th scope="col">食材</th>
                      <th scope="col" class="num hide-sm">批發 元/公斤</th>
                      {hasRetail && <th scope="col" class="num hide-sm hide-md">台中零售 元/斤</th>}
                      {hasSeason && <th scope="col" class="num hide-sm hide-md">產季</th>}
                      <th scope="col" class="num">跟常年同旬比</th>
                    </tr>
                  </thead>
                  <tbody>
                    {byDeal.map((i) => (
                      <tr>
                        <th scope="row">
                          <a class="rl" href={i.path}>{i.name}</a>
                          <span class="sub">
                            {i.dishes.join('、')}
                            {i.kind === 'meat' ? ' · 原料價，不是部位價' : ''}
                            <span class="only-sm"> · 批發 {price(i.price)} 元/公斤</span>
                            <span class="only-md">
                              {i.seasonLabel ? ` · 產季 ${i.seasonLabel}` : ''}
                              {i.retailPerCatty ? ` · 台中零售 ${i.retailPerCatty} 元/斤` : ''}
                            </span>
                            {i.indexable === false ? ' · 交易量少' : ''}
                          </span>
                        </th>
                        <td class="num tabular hide-sm">{price(i.price)}</td>
                        {hasRetail && <td class="num tabular hide-sm hide-md">{i.retailPerCatty ?? '—'}</td>}
                        {hasSeason && <td class="num hide-sm hide-md">{i.seasonLabel ?? '—'}</td>}
                        <td class={`num tabular ${dirClass(i.changePct)}`}>{i.changePct == null ? '—' : changeWord(i.changePct)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <div class="list-tools" style="margin-top:0.75rem">
                  {/* 買菜清單已經在首頁，這裡只是把這個節日的食材一次丟進去（存在瀏覽器，不上傳） */}
                  <button type="button" id="fs-add" data-slugs={JSON.stringify(f.ingredients.filter((i) => i.kind === 'crop').map((i) => i.slug))}>
                    ＋ 把蔬果食材加進買菜清單
                  </button>
                  <span class="count" id="fs-msg"></span>
                </div>
                {f.noPrice.length > 0 && (
                  <p class="note">
                    <strong>這些也要買，但我們沒有價格</strong>：{f.noPrice.join('、')}。
                    <MethodLink to="festival" label="為什麼沒有？" />
                  </p>
                )}
              </>
            )}

            {t.id === 'dishes' && (
              <>
              <table class="tbl" aria-labelledby={`fs-${t.id}-hd`}>
                <thead>
                  <tr>
                    <th scope="col">菜色</th>
                    <th scope="col" class="hide-sm">食材</th>
                    <th scope="col" class="num">查得到價格</th>
                  </tr>
                </thead>
                <tbody>
                  {f.dishes.map((d) => {
                    const has = d.items.map((k) => itemOf.get(k)?.name).filter(Boolean).join('、') || '—';
                    return (
                      <tr>
                        <th scope="row">
                          {d.dish}
                          <span class="sub">
                            <span class="only-sm">查得到價格：{has}{d.noPrice.length > 0 && <>｜沒有價格：{d.noPrice.join('、')}</>}{d.avoid && '｜'}</span>
                            {d.avoid && <>這個場合習俗上不擺：{d.avoid.join('、')} · </>}
                            <a class="src" href={d.source} rel="noopener nofollow" target="_blank">{d.sourceOrg ? `來源：${d.sourceOrg}` : '食材來源'}</a>
                          </span>
                        </th>
                        <td class="hide-sm fs-items">
                          查得到價格：{has}
                          {d.noPrice.length > 0 && <span class="sub">沒有價格：{d.noPrice.join('、')}</span>}
                        </td>
                        <td class="num tabular">{d.items.length}／{d.items.length + d.noPrice.length} 樣</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
              </>
            )}

            {t.id === 'early' && (
              <>
                <table class="tbl" aria-labelledby={`fs-${t.id}-hd`}>
                  <thead>
                    <tr>
                      <th scope="col">食材</th>
                      <th scope="col" class="num hide-sm">高峰在節前</th>
                      <th scope="col" class="num">往例漲幅</th>
                    </tr>
                  </thead>
                  <tbody>
                    {early.map((i) => (
                      <tr>
                        <th scope="row">
                          <a class="rl" href={i.path}>{i.name}</a>
                          <span class="sub">
                            {i.dishes.join('、')} · <span class="only-sm">高峰在節前 {i.festivalDaysBefore} 天 · </span>
                            現在{i.changePct == null ? '比常年 —' : compareWord('常年', i.changePct)}
                          </span>
                        </th>
                        <td class="num tabular hide-sm">{i.festivalDaysBefore} 天</td>
                        <td class="num tabular up">貴 {i.festivalPct}%</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <p class="note">
                  <MethodLink to="festival" />
                </p>
              </>
            )}
          </section>
        ))}
    </div>

    {weekSegments.length > 0 && (
      <nav class="siblings" aria-labelledby="fs-weeks">
        <h2 id="fs-weeks">{isSeason ? `${f.name}每週菜單` : `${f.name}落在哪一週`}</h2>
        {weekSegments.map((seg) => (
          <>
            {weekSegments.length > 1 && <p class="week-yr">{seg.label}</p>}
            <ul class="week-mini">
              {seg.rows.map((w) => w.other ? (
                <li class="is-other">{md(w.start)}–{md(w.end)} 是<a class="inline" href={`/festival/${w.page}/`}>{w.name}</a>主題 →</li>
              ) : (
                <li>{w.thisWeek && <strong>這週 </strong>}{md(w.start)}–{md(w.end)} {w.name}：{w.dishes.map((d) => d.dish).join('、')}</li>
              ))}
            </ul>
          </>
        ))}
      </nav>
    )}

    <nav class="siblings" aria-labelledby="fs-sib">
      <h2 id="fs-sib">其他主題</h2>
      <ul>
        {siblings.map((s) => <li><a href={`/festival/${s.id}/`}>{s.name}</a></li>)}
      </ul>
      <p class="more"><a class="inline" href="/festival/">看每週菜單總覽 →</a></p>
    </nav>

    <Faq items={faq} />

    <div class="screen-ft">
      價格為農糧署批發行情與畜產會產地行情 · 更新至民國 {roc(lastDate)} · <a href="/about/">資料說明</a>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('fs-add');
      const msg = document.getElementById('fs-msg');
      if (!btn || !window.hk) return;
      btn.addEventListener('click', () => {
        const slugs = JSON.parse(btn.dataset.slugs);
        const before = (window.hk.read() || []).length;
        window.hk.write([...(window.hk.read() || []), ...slugs]);
        const after = (window.hk.read() || []).length;
        msg.textContent = `已加入 ${after - before} 樣（清單共 ${after} 樣，存在這台瀏覽器）`;
      });
    });
  </script>
</Base>
