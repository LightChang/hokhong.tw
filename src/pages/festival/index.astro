---
// 每週菜單總覽（站主 2026-09-28：一年 52 週，每週都有對應的菜單）。
// 從這週起排 52 週，每週一個主題（節日、民俗節點、有食俗的節氣或當季）與 3–6 道有來源的菜。
// 週次、主題與菜色都由 transform/festival-menu.mjs 算好（festival-menu.json 的 weeks），頁面不另算。
// 網址沿用 /festival/（舊的 /festival/<id>/ 節日頁網址不變）。
import SiteNav from '../../components/SiteNav.astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MethodLink from '../../components/MethodLink.astro';
import { festivalMenu, roc } from '../../lib/pagedata.mjs';

const data = await festivalMenu();
const weeks = data?.weeks ?? [];
const pages = new Map((data?.festivals ?? []).map((f) => [f.id, f]));
const md = (iso) => `${Number(iso.slice(5, 7))}/${Number(iso.slice(8, 10))}`;
const now = weeks.find((w) => w.thisWeek) ?? weeks[0] ?? null;
// 主題頁（節日、民俗、節氣、季節），給「全部主題」連結用；季節頁放最後
const ORDER = { festival: 0, folk: 1, term: 2, season: 3 };
const themes = [...pages.values()].sort((a, b) => (ORDER[a.kind] ?? 9) - (ORDER[b.kind] ?? 9)
  || (a.next?.date ?? '9999').localeCompare(b.next?.date ?? '9999'));

const answer = now
  ? `這週（${md(now.start)}–${md(now.end)}）的菜單主題是${now.name}：${now.dishes.map((d) => d.dish).join('、')}。`
    + `接下來 ${weeks.length} 週每週都有一份菜單，食材連到本站的行情頁。`
  : '';
const crumbs = [{ name: '每週菜單', path: '/festival/' }];
---
<Base
  title="每週菜單：一年 52 週，這週煮什麼、食材現在貴不貴 — 好康"
  description={now ? `這週菜單：${now.name}（${now.dishes.map((d) => d.dish).slice(0, 3).join('、')}）。接下來 ${weeks.length} 週每週的主題與菜色，食材附批發行情。` : '每週菜單'}
  lastDate={roc(data?.lastDate)}
  bare={true}
  crumbs={crumbs}
  itemList={themes.map((f) => ({ name: `${f.name}菜單`, path: `/festival/${f.id}/` }))}
>
  <div class="shell screen">
    <div class="screen-hd">
      <a class="brand" href="/">好康 hó-khang</a>
      <SiteNav />
    </div>

    <div>
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="sr-only">每週菜單</h1>
      <p class="sr-only">{answer}</p>
      {now && (
        <p class="typhoon-lead">
          這週（{md(now.start)}–{md(now.end)}）：<a href={`/festival/${now.page}/`}><strong>{now.name}</strong></a>
          · {now.dishes.map((d) => d.dish).join('、')}
        </p>
      )}
    </div>

    <div>
      <table class="tbl week-tbl">
        <caption class="sr-only">接下來每週的主題與菜色</caption>
        <thead>
          <tr>
            <th scope="col" class="wk">週次</th>
            <th scope="col">主題<MethodLink to="festival" /></th>
            <th scope="col" class="hide-sm">菜色</th>
          </tr>
        </thead>
        <tbody>
          {weeks.map((w) => (
            <tr class={w.thisWeek ? 'is-now' : undefined}>
              <th scope="row" class="wk tabular">{md(w.start)}–{md(w.end)}</th>
              <td class="nm">
                {w.thisWeek && <span class="season-tag">這週 · </span>}<a class="rl" href={`/festival/${w.page}/`}>{w.name}</a>
                <span class="sub only-sm">{w.dishes.map((d) => d.dish).join('、')}</span>
              </td>
              <td class="hide-sm dishes">{w.dishes.map((d) => d.dish).join('、')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <nav class="siblings" aria-labelledby="fs-all">
      <h2 id="fs-all">全部主題</h2>
      <ul>{themes.map((f) => <li><a href={`/festival/${f.id}/`}>{f.name}</a></li>)}</ul>
    </nav>

    <div class="screen-ft">
      價格為農糧署批發行情與畜產會產地行情 · 更新至民國 {roc(data?.lastDate)} · <a href="/about/">資料說明</a>
    </div>
  </div>
</Base>
