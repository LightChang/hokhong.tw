---
// 節日備菜總覽（2026-09-28 站主要求常設入口）：7 個節日依下一次日期排序，連到各節日頁。
// 倒數天數、菜色、食材數都來自 festival-menu.json（與各節日頁同一份），不另算。
import SiteNav from '../../components/SiteNav.astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { festivalMenu, roc } from '../../lib/pagedata.mjs';

const data = await festivalMenu();
const list = [...(data?.festivals ?? [])]
  .sort((a, b) => (a.next?.date ?? '9999').localeCompare(b.next?.date ?? '9999'));
const md = (iso) => (iso ? `${Number(iso.slice(5, 7))}/${Number(iso.slice(8, 10))}` : '');
const dishesOf = (f) => f.dishes.map((d) => d.dish);

const answer = list.map((f) => `${f.name}${f.next ? `（${md(f.next.date)}，還有 ${f.next.daysUntil} 天）` : ''}`
  + `：${dishesOf(f).slice(0, 3).join('、')}，${f.ingredients.length} 樣食材查得到價格`).join('；') + '。';
const crumbs = [{ name: '節日備菜', path: '/festival/' }];
---
<Base
  title="節日備菜清單：尾牙、春節、清明、端午、中元、中秋、冬至要買什麼 — 好康"
  description={`${list.map((f) => f.name).join('、')}的常見菜色與食材，現在哪些比常年便宜、哪些要提前買。下一個是${list[0]?.name ?? ''}。`}
  lastDate={roc(data?.lastDate)}
  bare={true}
  crumbs={crumbs}
  itemList={list.map((f) => ({ name: `${f.name}要買什麼`, path: `/festival/${f.id}/` }))}
>
  <div class="shell screen">
    <div class="screen-hd">
      <a class="brand" href="/">好康 hó-khang</a>
      <SiteNav />
    </div>

    <div>
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="sr-only">節日備菜清單</h1>
      <p class="sr-only">{answer}</p>
    </div>

    <div>
      <div class="rows-head two-col">
        <span>節日</span>
        <span class="num">還有幾天</span>
      </div>
      <ul class="rows two-col" style="margin-top:0">
        {list.map((f) => (
          <li>
            <a href={`/festival/${f.id}/`}>
              <span class="nm">{f.name}要買什麼<span class="sub">
                {dishesOf(f).slice(0, 3).join('、')}{f.dishes.length > 3 ? ` 等 ${f.dishes.length} 道` : ''}
                {' '}· {f.ingredients.length} 樣食材有價格
                {f.next && <> · {md(f.next.date)}</>}
              </span></span>
              <span class="num tabular">{f.next ? `${f.next.daysUntil} 天` : '—'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="screen-ft">
      價格為農糧署批發行情與畜產會產地行情 · 更新至民國 {roc(data?.lastDate)} · <a href="/about/">資料說明</a>
    </div>
  </div>
</Base>
