---
import SiteNav from '../components/SiteNav.astro';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteIndex, cheapNow, about, roc, tap, marketNameByCode, marketRest, cropProfile, volumePrice, festivalMenu, SWING_TEXT } from '../lib/pagedata.mjs';
import { METHOD, MIN_MARKET_SHARE, VARIETY_MIN_SHARE, VARIETY_MIN_SAVING, TYPHOON_MIN_VOLUME, TYPHOON_MIN_SAMPLES } from '../lib/method.mjs';

const idx = await siteIndex();
// 排行榜的門檻與候選數寫在這裡，各頁面只放一句話加連結（見 cheap.astro）
const c = await cheapNow();
// 這一頁講的是涵蓋範圍與限制，每一個數字都會隨資料變動——一律從 emit-page 算好的 about.json 讀，
// 不寫死在這裡。寫死過一次的後果：README 寫 1.00–4.01、這頁寫 1.01–3.11，實際又是別的值，
// 而生成引擎會把這種句子整句抄走（見 GEO.md）。
const a = await about();
// 產銷履歷／有機的價差：樣本不足時 tap.json 的 ready 是 false，這一段就整段不顯示。
// 來源每天只給當天，歷史要自己累積——管線已經在跑，量夠自動放行。
const tapData = await tap();
// 「資料怎麼算」章節：頁面上的方法說明與警語全部集中在這裡（規則見 CLAUDE.md），
// 定義一律讀各支轉換寫出的 definition／basis，不在這裡另寫一份數字。
const mr = await marketRest();
const profDef = (await cropProfile())?.definition ?? null;
const vpDef = (await volumePrice())?.definition ?? null;
const fesLimits = ((await festivalMenu())?.festivals ?? []).filter((f) => f.limit);
const rocYear = (iso) => (iso ? Number(iso.slice(0, 4)) - 1911 : '—');
const wan = (n) => (n == null ? '—' : Math.round(n / 10000).toLocaleString('en-US'));
const nameList = (xs) => xs.map((x) => x.name).join('、');
const tabs = [
  { id: 'price', label: '為什麼看漲跌不看價格' },
  { id: 'base', label: '跟什麼比' },
  { id: 'chain', label: '錢流到哪' },
  { id: 'scope', label: '涵蓋範圍' },
  { id: 'meat', label: '肉蛋' },
  { id: 'limit', label: '已知問題' },
];
// 同一份資料交給 <Base crumbs>（BreadcrumbList）與畫面上的 <Breadcrumbs>
const crumbs = [{ name: '關於資料', path: '/about/' }];
---
<Base
  title="這些數字怎麼來的 — 好康 hó-khang"
  description="為什麼主要看漲跌幅而不是價格、批發價和你在市場付的錢差多少、資料涵蓋哪些市場。"
  lastDate={roc(idx.lastDate)}
  bare={true}
  crumbs={crumbs}
>
  <div class="shell screen">
    <div class="screen-hd">
      <a class="brand" href="/">好康 hó-khang</a>
      <SiteNav />
    </div>

    <div>
      <Breadcrumbs crumbs={crumbs} />
      {/* 標題不顯示在畫面上：導覽列已經說明你在哪一頁，內容直接開始。
          h1 仍留在 DOM（sr-only）給搜尋引擎與螢幕閱讀器。 */}
      <h1 class="sr-only">這些數字怎麼來的</h1>
    </div>

    <div class="tabs">
      {tabs.map((t, i) => <input type="radio" name="abouttab" id={`ab-${t.id}`} checked={i === 0} />)}
      <div class="tab-bar">{tabs.map((t) => <label for={`ab-${t.id}`}>{t.label}</label>)}</div>
      <div class="panels">
        <div class="panel">
          <h2 class="sr-only">為什麼主要看漲跌幅而不是價格？</h2>
          <p>我們手上的是<strong>批發價</strong>，不是你在菜市場付的錢。</p>
          <p>
            拿臺中市公有零售市場的實測價來對照，零售的中位數大約是批發的 <strong>{a.retail.ratioMedian} 倍</strong>——
            但這個倍數從 <strong>{a.retail.ratioMin?.ratio} 倍到 {a.retail.ratioMax?.ratio} 倍</strong>都有：
            {nameList(a.retail.cheapEnd)}幾乎沒有加價，{nameList(a.retail.dearEnd)}卻高到 {a.retail.ratioMax?.ratio} 倍。
            用一個固定倍數去推估你家附近的攤價，一定會錯。
          </p>
          <p>
            「比常年便宜 38%」則不一樣：批發跌的時候零售通常也跌，幅度或許小一點，但方向一致。
            所以主數字是<strong>漲跌幅</strong>，價格只當佐證。有臺中零售實測的 {a.retail.items} 個品項會直接顯示實際攤價，其餘不推估。
            零售價取<strong>近 {a.retail.days} 個訪價日的中位數</strong>（{a.retail.markets} 個公有市場、元/台斤）。葉菜幾乎天天訪得到價，
            當季水果只有產季那幾週有，後者頁面上會標明「僅產季訪得到價」與實際筆數。
          </p>
        </div>

        <div class="panel">
          <h2 class="sr-only">跟什麼比？基準是近三年同一旬</h2>
          <p>
            農產品季節性很強，九月的高麗菜本來就比三月貴。跟上週比只看得到波動，跟去年同月比又可能剛好遇到去年的颱風。
            所以基準是<strong>近三年同一旬</strong>的平均——同月份、同上中下旬，三年平均掉單一年的異常。
          </p>
          <p>
            用「旬」不用「日」：單日價格受當天到貨量影響很大。而且未結束的旬只有一兩天資料，
            所以一律用最近一個<strong>已經結束</strong>的旬。
          </p>
          <p>
            排行榜只收<strong>該旬交易量 5,000 公斤以上、且近三年同旬都有量</strong>的品項，
            目前 {c.candidates} 個。量太少的品項一兩筆交易就能讓均價翻倍，放進榜單只會洗掉真正的行情。
          </p>
          <p class="note">
            颱風那段則是另一套統計：{a.typhoon?.firstYear} 年以來 {a.typhoon?.count} 次颱風，
            比較警報結束前 {a.typhoon?.definition?.beforeDays} 天與之後 {a.typhoon?.definition?.afterDays} 天的價格，
            只計入高峰比颱風前貴兩成以上的那幾次，「回穩」指從高峰之後回到颱風前均價的 {a.typhoon?.definition?.recoverRatio} 倍以內。這是往例，不是預測。
            逐一品項的漲幅與回穩天數見<a href="/typhoon/">颱風與菜價</a>。
          </p>
        </div>

        <div class="panel">
          <h2 class="sr-only">錢流到哪？產地、批發、零售的價差</h2>
          <p>
            有些品項會顯示產地 → 批發 → 零售的價格鏈，並算出農民拿到你付的錢的幾成。
            三個數字分別來自農糧署產地價格查報、批發市場交易行情、臺中市公有零售市場實測。
            過季水果（柿子、芒果、小番茄）的零售端只有產季那幾週訪得到價，這種情況只列出價格鏈，
            <strong>不換算農民拿幾成</strong>——樣本集中在產季，換算出來的比例會被當成全年結論。
          </p>
          <p>
            <strong>只有少數品項有這段。</strong>產地價查的是特定品種與等級，批發價卻是該作物所有品種的加權平均——
            兩邊不是同一種貨。目前 {a.chain.candidates} 個對得上產地品名的品項裡，有 {a.chain.blocked?.['wholesale-below-origin'] ?? 0} 個算出
            「農民賣得比批發市場還貴」{a.chain.worstBelowOrigin && <>，例如{a.chain.worstBelowOrigin.name}產地報 {a.chain.worstBelowOrigin.origin} 元、批發只有 {a.chain.worstBelowOrigin.wholesale} 元</>}。
          </p>
          <p>
            所以三個條件都成立才顯示：產地與批發取<strong>同一旬</strong>、批發是產地的 <strong>1 到 4 倍</strong>、
            且該作物<strong>只對到一個產地品名</strong>。目前 {a.chain.comparable} 個品項通過，{a.chain.threeLayer} 個有完整三層。
            產地價發布比批發慢約一個月，頁面上會標出是哪一旬。
          </p>
        </div>

        <div class="panel">
          <h2 class="sr-only">涵蓋範圍：哪些市場、哪些年份</h2>
          <p>
            全台果菜批發市場有 47 家（2026-09-11 農糧署回覆），但只有農糧署輔導的<strong>行情報導站</strong>每日上傳，
            所以這裡的「全國」是這 {a.markets.total} 個有資料的市場的加權平均。<strong>臺南沒有蔬果行情，只有花卉。</strong>
          </p>
          <p>
            市場清單會隨年份變動：{a.markets.joinedLater.map((m, i) => <>{i ? '、' : ''}{marketNameByCode(m.code, m.name)}從民國 {rocYear(m.firstDate)} 年</>)}才有資料。
            資料從<strong>民國 {rocYear(a.markets.firstDate)} 年</strong>到 {roc(idx.lastDate)}，共 {wan(a.coverage?.l1Rows)} 萬筆交易紀錄。
            官方平台只保留兩年，跨年比較只有這裡做得到。
          </p>
          {tapData?.ready && tapData.overall && (
            <p>
              <strong>產銷履歷與有機。</strong>有溯源標示的蔬果均價 {tapData.overall.taggedPrice} 元/公斤，
              沒有標示的 {tapData.overall.plainPrice} 元/公斤，差 {tapData.overall.premiumPct > 0 ? '+' : ''}{tapData.overall.premiumPct}%
              （{tapData.days} 個交易日、{Math.round(tapData.overall.taggedVolume / 1000)} 噸 vs {Math.round(tapData.overall.plainVolume / 1000)} 噸）。
              <span class="muted">來源的溯源代號沒有說明哪個是有機、哪個是產銷履歷，所以合併講「有標示」。</span>
            </p>
          )}
          <p class="note">
            同一種菜在批發市場分很多品種（高麗菜分初秋、改良種、進口…），站上顯示的是<strong>交易量加權平均</strong>，
            不是各品種價格的算術平均——後者會讓一筆零星交易跟一整車貨有同樣的份量。
          </p>
          <p class="note">
            <strong>市場位置與導航。</strong>座標來自 <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a>
            （© OpenStreetMap contributors，ODbL），每一筆都用縣市名核對過，對不上的不採用。
            市場的實際名稱（臺中果菜市場、西螺果菜市場…）也取自同一份資料：行情站只給「台中市」「豐原區」這種代號名稱。
            {a.markets.total} 個市場裡<strong>{nameList(a.markets.missingGeo.map((m) => ({ ...m, name: marketNameByCode(m.code, m.name) })))}查不到座標</strong>，這 {a.markets.missingGeo.length} 個不參與「依距離排序」，
            名稱是由代號名稱組出來的慣用稱呼，未經官方核對；
            導航改用市場名稱搜尋。按「依距離排序」時位置只在你的瀏覽器裡計算，不會送出。
            顯示的是<strong>直線距離</strong>，實際路程會更遠。
          </p>
        </div>

        <div class="panel">
          <h2 class="sr-only">肉蛋的資料跟蔬果有什麼不同？</h2>
          <p>
            <a href="/crop/">肉蛋</a>和蔬果是<strong>兩套不同的資料</strong>，只有「跟近三年同一旬比」這個口徑相同。
          </p>
          <ul>
            <li><strong>毛豬</strong>是批發市場成交價，單位<strong>元/公斤</strong>，依成交頭數加權，民國 98 年 11 月起。</li>
            <li><strong>家禽與蛋</strong>（白肉雞、紅羽土雞、雞蛋、鴨蛋、肉鵝、番鴨）是中央畜產會的<strong>產地行情</strong>，單位<strong>元/台斤</strong>，2010 年 10 月起。產地價不是零售價，也不是批發價，中間還有運銷成本。</li>
            <li><strong>雞蛋產地價只比得到一年。</strong>來源自民國 114 年 9 月起改採養雞協會日報表，算法換過，所以站上只拿得到一年的可比資料，不假裝有三年。</li>
            <li><strong>沒有交易量。</strong>家禽是一天一個報價，不像蔬果有成交量可以加權，所以「全國」就是那一個報價。</li>
            <li><strong>來源會出現區間報價。</strong>紅羽土雞常見「41-42」這種公告，站上取中點；「休市」「議價」當作當天沒有價格。</li>
          </ul>
        </div>

        <div class="panel">
          <h2 class="sr-only">已知問題與限制</h2>
          <ul>
            <li><strong>名字跟行情站不一樣。</strong>行情站用農業分類的正式名稱，這裡改用一般人的講法：甘藍→高麗菜、檬果→芒果、枸櫞→檸檬、韭蔥→蒜苗、隼人瓜→龍鬚菜。對照表是逐項核對各品項底下實際的批發品名做的，每頁都標出原名。萵苣底下混了大陸妹、A 菜、美生菜，這種就把講法都列出來。</li>
            <li><strong>歷史名稱會被改寫。</strong>來源回傳舊資料時用的是現行名稱，例如 113 年把火龍果改名紅龍果後，民國 101 年的資料也顯示紅龍果。</li>
            <li><strong>休市要看官方日曆。</strong>資料裡的休市記錄只出現在部分年份，而且溪湖鎮蔬菜的官方休市日曆本身不準。</li>
            <li><strong>花卉的品項對應不完整。</strong>官方統一代碼在花卉只涵蓋交易量的 {a.coverage?.byType?.N06}%，對不上的不計入作物層統計。蔬菜 {a.coverage?.byType?.N04}%、水果 {a.coverage?.byType?.N05}%。</li>
            <li><strong>來源有錯誤值。</strong>全史有 {a.coverage?.negVolumeRows} 列交易量是負數，另有 {wan(a.coverage?.nonTradedRows)} 萬列有報價但沒成交，計算時都已排除。</li>
            <li><strong>不預測價格。</strong>供給面資料是月頻或季頻的文字報告，拿來做每日價格預測只會產生看起來精確的猜測。</li>
          </ul>
        </div>
      </div>
    </div>

    <section class="method" id="method" aria-labelledby="method-hd">
      <h2 id="method-hd">資料怎麼算</h2>
      <p>各頁上的數字只給結論；口徑、門檻與限制都集中在這裡。頁面上的「怎麼算？」會連到對應的小節。</p>

      <section id={METHOD.lists}>
        <h3>清單與這週划算榜</h3>
        <ul>
          <li>榜單比的是{c.basis}。只收該旬交易量 {c.filters?.minVolumeKg?.toLocaleString('en-US')} 公斤以上、且近三年同旬都有量的品項。</li>
          <li>「找食材」只列交易天數夠的品項；交易太少的品項頁面仍存在（可從搜尋或品項×市場頁進去），只是不列在清單上。</li>
        </ul>
      </section>

      <section id={METHOD.privacy}>
        <h3>隱私</h3>
        <ul>
          <li>首頁的買菜清單只存在這台裝置的瀏覽器裡，不會上傳，也不需要登入；站方讀不到。</li>
          <li>市場清單的「依距離排序」只在你的瀏覽器裡計算，位置不會送出。</li>
          <li>本站以 Google Analytics 統計造訪量。</li>
        </ul>
      </section>

      <section id={METHOD.charts}>
        <h3>圖怎麼讀</h3>
        <ul>
          <li>折線圖上的缺口是休市，或那天沒有交易／報價，不是資料遺失。</li>
          <li>到貨量突然變少，多半是颱風或休市。</li>
          <li>「跟往年比」把近三年的逐月價格疊在一起：同月份對齊，才分得出是季節正常還是反常。</li>
          <li>全國月均價從民國 101 年起；官方平台只保留兩年。</li>
        </ul>
      </section>

      <section id={METHOD.retail}>
        <h3>品項頁：臺中零售實測與「攤子上喊多少？」</h3>
        <ul>
          <li>比的是臺中 {a.retail.markets} 個公有零售市場、近 {a.retail.days} 個訪價日的常見範圍（第 25–75 百分位，元/台斤）與中位數。</li>
          <li>其他縣市沒有開放同型資料，所以沒有零售實測的品項只給全國批發價，不推估攤價。</li>
          <li>訪價密度低（多半是只有產季才訪得到價的水果）時，頁面標「僅產季訪得到價」。</li>
        </ul>
      </section>

      <section id={METHOD.season}>
        <h3>品項頁：產季、最便宜的月份、要不要等幾天</h3>
        <ul>
          {profDef && <li>產季依 {profDef.seasonYears?.[0]}–{profDef.seasonYears?.[1]} 年各月佔全年交易量的比例，取合計達 {Math.round((profDef.seasonCover ?? 0) * 100)}% 的月份；全年都有量的講淡季。</li>}
          {profDef && <li>「十天內的價格變動」是近 {profDef.swingYears} 年相鄰兩{profDef.swingGrain}全國均價變動幅度的中位數：{Object.values(SWING_TEXT).map((t) => t.text).join('／')}。</li>}
        </ul>
      </section>

      <section id={METHOD.gap}>
        <h3>品項頁：各地價差</h3>
        <ul>
          <li>長條比的是各市場最新月份的月均價，只比該月交易量佔跨市場合計 {MIN_MARKET_SHARE * 100}% 以上的市場；一兩筆零星成交就能讓均價失真，這些市場另列連結、不進比較。</li>
          <li>「最近一個交易日」的比較只看當日量佔全國 5% 以上的市場；不足兩個就講「這一天比不出來」。</li>
          <li>「N 種」是當日該市場成交的官方作物代號數。同一個品項名底下含多個代號（品種、等級），代號組合不同，均價就不同——市場間的差距不能全算成地區價差：講的是「這個市場的成交均價較高」，不是「同一批貨在這裡賣得比較貴」。</li>
          <li>價差反映產地距離與到貨量，不是你家附近攤子的價格。最低價是 0 元時算不出倍數，改講相差幾元。</li>
        </ul>
      </section>

      <section id={METHOD.ship}>
        <h3>品項頁：要出貨的話</h3>
        <ul>
          <li>先看當日成交均價最高的市場，再看它近一年星期幾到貨最多、最少。到貨最多的那天通常是價格最差的那天，兩件事要一起看。</li>
          <li>星期節奏的算法見下方「市場頁」。</li>
        </ul>
      </section>

      <section id={METHOD.variety}>
        <h3>品項頁：品種與進口</h3>
        <ul>
          <li>品種均價是近一年各品種的交易量加權均價（元/公斤），佔比是交易量；站上其他地方的價格是這些品種的加權平均。「其他」這種統包桶不列。</li>
          <li>「想省錢可以換品種」只在便宜的品種佔近一年交易量 {VARIETY_MIN_SHARE}% 以上（不是冷門規格）、非進口、且比主流品種便宜 {VARIETY_MIN_SAVING}% 以上時出現。比的是近一年均價，不是今天的價。</li>
          <li>進口佔比依行情站品名上的「進口」標示。</li>
        </ul>
      </section>

      <section id={METHOD.why}>
        <h3>品項頁：為什麼是這個價（颱風、到貨量、年節）</h3>
        <ul>
          <li>颱風：見下方「颱風頁」。</li>
          {vpDef && <li>到貨量與價格：用{vpDef.grain}資料、{vpDef.method}，至少 {vpDef.minXun} 個旬、相關係數 {vpDef.minR} 以下才給數字；「現在量多／量少」比的是近 {vpDef.baseYears} 年同旬與前一旬。幅度超出往例的常見範圍時不換算成價差（那是把關係外推到樣本邊緣）。</li>}
          <li>年節往例已扣掉季節性：拿同一個曆日、但那年距離該節慶超過兩週的年份當對照（農曆節慶的國曆日期每年前後移動三週）。節前窗碰到颱風的年份不採計。是往例，不是預測。</li>
        </ul>
      </section>

      <section id={METHOD.chain}>
        <h3>品項頁：產地 → 批發 → 零售</h3>
        <ul>
          <li>條件與來源見上方「錢流到哪」分頁。各縣市產地價是同一旬各鄉鎮報價的中位數（元/公斤）。</li>
          <li>零售端只有產季訪得到價時，這條鏈的比例會隨產季前後變動，所以不換算農民拿多少。</li>
        </ul>
      </section>

      <section id={METHOD.cropMarket}>
        <h3>品項×市場頁</h3>
        <ul>
          <li>市場的月均價與全國同月比（全國是所有有資料市場的交易量加權平均）；近 90 天是該市場的日均價。</li>
          <li>「其他市場」依最新月均價由便宜到貴排列。交易資料偏少的頁面不列入搜尋引擎收錄。</li>
        </ul>
      </section>

      <section id={METHOD.market}>
        <h3>市場頁</h3>
        <ul>
          <li>星期節奏：近一年各星期到貨量取中位數（避開颱風與年節的極端值），高低差不到三成就不講（那是雜訊不是節奏）。常態不開秤的星期不參與比較。</li>
          {mr?.effect?.basis && <li>休市後的到貨與價格：{mr.effect.basis}。</li>}
          <li>休市日由農糧署公告，包含未來的日期；同一個市場不同類別（蔬菜、水果、花卉）的休市日不一定相同，頁面只列該類別的。</li>
          <li>市場集中度（前五大佔幾成、累積到八成要幾個品項）看的是近 90 天的交易量——要出貨的話，這決定了你的品項在這裡有沒有人收。</li>
        </ul>
      </section>

      <section id={METHOD.meat}>
        <h3>肉蛋頁</h3>
        <ul>
          <li>口徑、單位與起始年見上方「肉蛋」分頁：毛豬是批發市場成交價（元/公斤，依成交頭數加權），家禽與蛋是中央畜產會產地行情（元/台斤，一天一個報價、沒有成交量可以加權）。產地價不是零售價，也不是批發價。</li>
          <li>比較基準是近三年同一旬平均。來源起算較晚的（雞蛋產地價自民國 114 年 9 月起改採養雞協會日報表，算法換過）只比得到較少年份，頁面上「基準 N 年」就是實際比得到的年數，不假裝有三年。</li>
        </ul>
      </section>

      <section id={METHOD.typhoon}>
        <h3>颱風頁</h3>
        <ul>
          <li>基準是颱風海上警報發布前 14 天的日均價；「回穩」是回到基準的 1.1 倍以內。</li>
          <li>漲幅與回穩天數的中位數，是歷次「真的有漲」那幾次的中位數，不是每次颱風都會漲。</li>
          <li>「會漲」與「不必搶」兩份清單只收常態日均到貨量 {TYPHOON_MIN_VOLUME / 1000} 公噸以上、且至少 {TYPHOON_MIN_SAMPLES} 次颱風有紀錄的品項。</li>
          <li>歷次颱風依中位漲幅排序，列最兇的幾次。</li>
        </ul>
      </section>

      <section id={METHOD.festival}>
        <h3>節日頁</h3>
        <ul>
          <li>菜色與食材的對應是人工整理，來源列在每道菜旁；少數來源頁當時無法逐頁核對。批發行情只涵蓋蔬果與畜禽，米穀、乾貨、加工品與水產不在裡面，所以有些食材沒有價格。</li>
          {fesLimits.map((f) => <li><strong>{f.name}</strong>：{f.limit}</li>)}
          <li>節前漲幅已扣掉季節性與颱風（做法同上方「年節往例」），是往例不是預測；只有算得出對照年的節日才有頁面。</li>
        </ul>
      </section>
    </section>

    <div class="screen-ft">
      資料更新至民國 {roc(idx.lastDate)} · 每日凌晨取得並重抓最近 7 天<span class="hide-sm">（部分市場會延遲上傳，官方也會事後修正）</span>
      · 本站以 Google Analytics 統計造訪量；買菜清單只存在你的瀏覽器<span class="hide-sm">，不會上傳，站方也讀不到</span>
    </div>
  </div>
</Base>
