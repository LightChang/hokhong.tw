---
import Base from '../../layouts/Base.astro';
import { siteIndex, meatIndex, roc, TC_LABEL, changeWord, dirClass, levelClass, levelText } from '../../lib/pagedata.mjs';

const idx = await siteIndex();
const meat = await meatIndex();

// 一個地方查到所有買得到的東西：蔬菜、水果、肉蛋、花卉。
// 順序按買菜的人會想到的次序，花卉排最後（買菜的人不需要，但資料有就列）。
const cropGroup = (tc) => ({
  key: tc, label: TC_LABEL[tc],
  items: idx.crops.filter((c) => c.tcType === tc && c.indexable && c.name).map((c) => ({
    href: `/crop/${c.slug}/`, name: c.name, seasonal: c.seasonal,
    sub: c.official !== c.name ? `行情站：${c.official}` : null,
    changePct: c.changePct,
  })),
  hidden: idx.crops.filter((c) => c.tcType === tc && !c.indexable).length,
});

const groups = [
  cropGroup('N04'),
  cropGroup('N05'),
  {
    key: 'MEAT', label: '肉蛋', hidden: 0,
    items: meat.items.map((m) => ({
      href: `/meat/${m.slug}/`, name: m.item, seasonal: false,
      sub: `${m.group} · ${m.unit === '元/公斤' ? '批發' : '產地'}`,
      changePct: m.changePct,
    })),
  },
  cropGroup('N06'),
].filter((g) => g.items.length);
---
<Base
  title="找食材 — 好康 hó-khang"
  description="蔬菜、水果、肉蛋、花卉的行情清單，點進去看現在貴不貴、跟往年比如何。"
  lastDate={roc(idx.lastDate)}
  bare={true}
  crumbs={[{ name: '找食材', path: '/crop/' }]}
  itemList={groups.flatMap((g) => g.items.map((c) => ({ name: c.name, path: c.href })))}
>
  <div class="shell screen">
    <div class="screen-hd">
      <a class="brand" href="/">好康 hó-khang</a>
      <nav>
        <a href="/cheap/">這週划算</a><a href="/crop/">找食材</a><a href="/market/">市場</a><a href="/about/">關於資料</a>
      </nav>
    </div>

    <div>
      {/* 標題不顯示在畫面上：導覽列已經說明你在哪一頁，內容直接開始。
          h1 仍留在 DOM（sr-only）給搜尋引擎與螢幕閱讀器。 */}
      <h1 class="sr-only">找食材</h1>
      <div class="list-tools" style="margin-top:0.75rem">
        <label class="sr-only" for="cs-q">搜尋食材</label>
        <input id="cs-q" type="search" placeholder="找食材，例如 高麗菜、雞蛋" autocomplete="off" />
        <span class="count" id="cs-count"></span>
      </div>
    </div>

    {/* 搜尋結果：跨蔬菜／水果／肉蛋／花卉，不必先選對分頁 */}
    <div id="cs-result" hidden>
      <ul class="rows two-col" id="cs-rows"></ul>
      <p class="list-empty" id="cs-empty" hidden></p>
    </div>

    <div class="tabs" id="cs-tabs">
      {groups.map((g, i) => <input type="radio" name="croplist" id={`cl-${g.key}`} checked={i === 0} />)}
      <div class="tab-bar">
        {groups.map((g) => <label for={`cl-${g.key}`}>{g.label}（{g.items.length}）</label>)}
      </div>
      <div class="panels">
        {groups.map((g) => (
          <div class="panel">
            <h2 class="sr-only">{g.label}行情清單（{g.items.length} 項）</h2>
            <div class="rows-head two-col">
              <span>品項</span>
              <span class="num">跟常年同旬比</span>
            </div>
            <ul class="rows two-col" style="margin-top:0">
              {g.items.map((c) => (
                <li>
                  <a href={c.href}>
                    <span class="nm">
                      {c.name}
                      {c.seasonal && <span class="season-tag"> · 當季</span>}
                      {c.sub && <span class="sub">{c.sub}</span>}
                    </span>
                    <span class={`num tabular ${dirClass(c.changePct)}`}>
                      {c.changePct != null && <i class={levelClass(c.changePct)} title={levelText(c.changePct)} aria-hidden="true"></i>}
                      {c.changePct == null ? '' : changeWord(c.changePct)}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            {g.hidden > 0 && <p class="note muted">另有 {g.hidden} 個品項交易天數太少，頁面仍存在但不列於此。</p>}
            {g.key === 'MEAT' && <p class="note"><a href="/meat/">肉蛋行情總覽</a>：含價格、單位與來源口徑（毛豬是批發價、家禽與蛋是產地價）。</p>}
          </div>
        ))}
      </div>
    </div>

    <div class="screen-ft">
      蔬果花卉為農糧署批發行情，肉蛋見<a href="/about/">資料說明</a> · 更新至民國 {roc(idx.lastDate)}
    </div>
  </div>

  <script type="application/json" id="cs-source" set:html={JSON.stringify([
    ...idx.crops.filter((c) => c.name).map((c) => ({
      u: `/crop/${c.slug}/`, n: c.name, o: c.official, t: c.tcType, p: c.changePct, q: c.seasonal ? 1 : 0, i: c.indexable ? 1 : 0,
    })),
    ...meat.items.map((m) => ({ u: `/meat/${m.slug}/`, n: m.item, o: '', t: 'MEAT', p: m.changePct, q: 0, i: 1 })),
  ])} />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const all = JSON.parse(document.getElementById('cs-source').textContent);
      const q = document.getElementById('cs-q');
      const tabs = document.getElementById('cs-tabs');
      const box = document.getElementById('cs-result');
      const rows = document.getElementById('cs-rows');
      const empty = document.getElementById('cs-empty');
      const count = document.getElementById('cs-count');
      const LABEL = { N04: '蔬菜', N05: '水果', N06: '花卉', MEAT: '肉蛋' };
      const word = (p) => (p == null ? '' : (p < 0 ? '便宜 ' : '貴 ') + Math.abs(Math.round(p)) + '%');
      const dir = (p) => (p == null ? '' : p > 0 ? 'up' : p < 0 ? 'down' : '');
      // 與 pagedata.mjs 的 levelClass/levelText 同一套級距
      const lv = (p) => p == null ? 'lv' : p <= -30 ? 'lv lv-c3' : p <= -10 ? 'lv lv-c2'
        : p < 10 ? 'lv' : p < 30 ? 'lv lv-p1' : p < 100 ? 'lv lv-p2' : 'lv lv-p3';
      const lvText = (p) => p == null ? '資料不足' : p <= -30 ? '比常年便宜很多' : p <= -10 ? '比常年便宜'
        : p < 10 ? '跟常年差不多' : p < 30 ? '比常年貴一些' : p < 100 ? '比常年貴很多' : '比常年貴一倍以上';

      function render() {
        const s = q.value.trim();
        if (!s) { box.hidden = true; tabs.hidden = false; count.textContent = ''; return; }
        // 俗名和行情站官方名都比對：使用者可能記得「高麗菜」，也可能記得「甘藍」
        // 同一個名字可能對到多筆（「紅龍果」有水果兩筆、花卉一筆，其中一筆近 90 天只交易 6 天）。
        // 不刪資料——花卉的紅龍果是另一種東西——但把交易正常的排前面，別讓人先點到雜訊頁。
        const hit = all.filter((c) => c.n.includes(s) || (c.o && c.o.includes(s)))
          .sort((a, b) => (b.i - a.i)
            || ((a.t === 'N06') - (b.t === 'N06'))
            || a.n.localeCompare(b.n, 'zh-Hant'));
        tabs.hidden = true; box.hidden = false;
        rows.innerHTML = hit.map((c) => `<li>
          <a href="${c.u}">
            <span class="nm">${c.n}${c.q ? '<span class="season-tag"> · 當季</span>' : ''}
              <span class="sub">${LABEL[c.t] || ''}${c.o && c.o !== c.n ? ' · 行情站：' + c.o : ''}${c.i ? '' : ' · 交易量少'}</span></span>
            <span class="num tabular ${dir(c.p)}">${c.p == null ? '' : `<i class="${lv(c.p)}" title="${lvText(c.p)}" aria-hidden="true"></i>`}${word(c.p)}</span>
          </a></li>`).join('');
        // 查無時退回分類清單。結果區與分頁共用同一個 grid 列，兩者同時顯示會疊在一起，
        // 所以提示話改走搜尋列旁邊的 count，不留在結果區裡。
        if (!hit.length) {
          box.hidden = true;
          tabs.hidden = false;
          count.textContent = `找不到「${s}」，下面是全部食材`;
        } else {
          count.textContent = `找到 ${hit.length} 項`;
        }
        empty.hidden = true;
      }
      q.addEventListener('input', render);
    });
  </script>
</Base>
