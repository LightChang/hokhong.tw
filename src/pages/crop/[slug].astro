---
import Base from '../../layouts/Base.astro';
import PriceLine from '../../components/PriceLine.astro';
import { cropSlugs, crop, typhoon, festival, volumePrice, marketGeo, about, price, pct, volume, roc, dirClass, ymLabel,
         verdict, changeWord, cattyPrice, seasonText } from '../../lib/pagedata.mjs';

export async function getStaticPaths() {
  const slugs = await cropSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const doc = await crop(slug);
// FAQ 要講「臺中幾個公有市場」——市場數會變，從 about.json 讀（快取住，不是每頁重讀檔）
const abt = await about();
const v = verdict(doc.change?.changePct);
const season = seasonText(doc);

const monthly = doc.monthly.map((p) => ({ x: ymLabel(p.ym), y: p.price }));
const years = [...new Set(doc.monthly.map((p) => p.ym.slice(0, 4)))].sort();
const [y0, y1, y2] = [years.at(-1), years.at(-2), years.at(-3)];
const byYear = (y) =>
  Array.from({ length: 12 }, (_, i) => {
    const ym = `${y}-${String(i + 1).padStart(2, '0')}`;
    return { x: `${i + 1} 月`, y: doc.monthly.find((p) => p.ym === ym)?.price ?? null };
  });
const yoySeries = [
  y2 && { id: y2, label: `${y2} 年`, role: 'mute', points: byYear(y2) },
  y1 && { id: y1, label: `${y1} 年`, role: 'alt', points: byYear(y1) },
  y0 && { id: y0, label: `${y0} 年`, role: 'main', points: byYear(y0) },
].filter(Boolean);

const dayMap = new Map();
for (const r of doc.daily90) {
  const a = dayMap.get(r.d) ?? { pv: 0, v: 0 };
  if (r.price != null && r.volume) { a.pv += r.price * r.volume; a.v += r.volume; }
  dayMap.set(r.d, a);
}
const daily = [...dayMap].sort(([a], [b]) => a.localeCompare(b))
  .map(([d, a]) => ({ x: roc(d), y: a.v ? +(a.pv / a.v).toFixed(2) : null }));

// price 0 是來源雜訊，不是「很便宜」：實測全站只有兩列，都是屏東市、交易量 2–20 公斤。
// 留著會讓「哪個市場最便宜」答出 0.0 元/公斤，而那是個機器可讀的假事實。
const marketsWithPrice = doc.markets.filter((m) => m.latest?.price != null && m.latest.price > 0);

// 再擋零星交易。「水蓮在鳳山區只要 2.2 元」聽起來是個發現，但那個月鳳山區只成交 72 公斤、
// 佔全國 0.17%——它不是你買得到的便宜，是資料的捨入誤差。不擋的話這句話會以
// FAQ 結構化資料的形式送出去，變成一個機器可讀的假答案。
// 門檻取最新月份跨市場交易量的 1%：實測剔掉約四分之一的零星列，但沒有任何品項因此
// 少於兩個市場，價差中位數從 266% 回到 120%。這與排行榜本來就有交易量門檻是同一套想法。
const MIN_MARKET_SHARE = 0.01;
const latestVolTotal = marketsWithPrice.reduce((s, m) => s + (m.latest.volume ?? 0), 0);
const marketsMain = latestVolTotal
  ? marketsWithPrice.filter((m) => (m.latest.volume ?? 0) / latestVolTotal >= MIN_MARKET_SHARE)
  : marketsWithPrice;
// 防呆：萬一某個品項被篩到只剩一個市場，寧可全列也不要讓「各地價差」變成單根長條
const markets = marketsMain.length >= 2 ? marketsMain : marketsWithPrice;
// 被擋下的市場仍然各有一頁，而且那些頁只從這裡連得到。所以不是只給一個數字就算了——
// 要把它們當連結列出來，否則這些頁會掉到第 4 層、只剩橫向的兄弟連結。
const thinMarkets = marketsWithPrice.filter((m) => !markets.includes(m));
// 地理地圖需要每個市場的座標，開放資料湊不齊（台南只有行政區、台北 API 500、高雄無地址欄；
// 所以用長條表達「差多少」，不填不可靠的座標。
// name 在少數市場是空的（行情站沒給名稱，實測是代號 950、900、540）。
// 退回 market-geo.json 的正式名稱，最後才用代號——直接用代號會讓句子變成
// 「950最低（5.0 元/公斤）」。統一在這裡處理，不在每個使用點各寫一次 fallback：
// 漏掉一處就會產生送進 FAQ 結構化資料的錯誤事實，比畫面上少個字嚴重。
const geo = await marketGeo();
const marketName = (m) => m.name || geo[m.code]?.name || geo[m.code]?.fullName || `市場 ${m.code}`;
// 出貨的人要的是「最近一個交易日」，不是月均價。量不到當日全國 5% 的市場不進結論
// （一兩筆零星成交就能讓均價變最高價）。不足兩個量夠的市場就講「這天比不出來」。
const mdRaw = doc.marketsDay ?? null;
const mdSolid = (mdRaw?.list ?? []).filter((m) => !m.thin);
const md = mdRaw && mdSolid.length >= 2 ? mdRaw : null;
// 各市場當日成交的代號數落差本身就是「這個比較有多可信」的訊號，直接標出來
const mdCodes = mdSolid.map((m) => m.codes).filter((n) => n != null);
const mdCodeRange = mdCodes.length && Math.min(...mdCodes) !== Math.max(...mdCodes)
  ? `這天是 ${Math.min(...mdCodes)}–${Math.max(...mdCodes)} 種` : null;

const marketBars = markets.map((m) => ({ code: m.code, name: marketName(m), price: m.latest.price }))
  .sort((a, b) => a.price - b.price);
const maxMarketPrice = marketBars.length ? Math.max(...marketBars.map((m) => m.price)) : 0;
for (const m of marketBars) m.pct = maxMarketPrice ? Math.round((m.price / maxMarketPrice) * 100) : 0;
const cheapestMarket = marketBars[0] ?? null;
const priciestMarket = marketBars.at(-1) ?? null;
// 最低價可能是 0（來源偶有 0 元成交），拿它當分母會得到「相差 Infinity%」。
// 沒得算比例時就不講比例，講絕對差額。
const marketGapPct = cheapestMarket && priciestMarket && cheapestMarket.price > 0
  ? Math.round(((priciestMarket.price - cheapestMarket.price) / cheapestMarket.price) * 100)
  : null;

const tyData = await typhoon();
const tyLatest = tyData?.latest ?? null;
const tyCrop = tyData?.byCrop?.[doc.plv3Key] ?? null;
// 這個品項「現在」比颱風前貴多少（不是歷次中位數）。使用者問的是現在該不該買，
// 往例只能回答「通常要幾天」，回答不了「所以現在到底回來了沒」。
const tyNow = tyData?.now?.crops?.find((r) => r.key === doc.plv3Key && r.tcType === doc.tcType) ?? null;
const ty = {
  latest: tyLatest, crop: tyCrop, now: tyNow,
  show: !!(tyLatest && tyLatest.daysSince != null && tyLatest.daysSince <= 30 && (tyCrop?.medianRecoveryDays != null || tyNow)),
  daysLeft: tyLatest && tyCrop?.medianRecoveryDays != null
    ? Math.max(0, tyCrop.medianRecoveryDays - tyLatest.daysSince) : null,
};
// 年節往例：這個品項在春節／端午前會不會漲。效應已經扣掉季節性與颱風（做法見
// transform/festival.mjs），所以「不明顯」也是答案——買菜的人問的就是要不要提前買。
const fes = await festival();
const fesRows = ['cny', 'duanwu']
  .map((id) => ({ id, name: fes?.byFestival?.[id]?.name, label: fes?.byFestival?.[id]?.label, stat: fes?.byCrop?.[doc.plv3Key]?.[id] }))
  .filter((x) => x.name && x.stat && x.stat.samples >= 3);

// 量價關係：回答「為什麼現在這個價」。關係不明顯的品項不給數字（那本身就是答案）
const vp = (await volumePrice())?.byCrop?.[doc.plv3Key] ?? null;
const vpShow = vp && vp.tcType === doc.tcType ? vp : null;

const alt = (doc.change?.changePct ?? 0) >= 20 ? doc.alternatives?.[0] : null;

// 分頁：依這個品項實際有的資料決定，最多 5 個。
// heading 是給搜尋引擎與螢幕閱讀器的標題（label 只是點擊目標，不構成標題階層），
// 用使用者實際會打的問法，不是「14 年走勢」這種欄位名。
const tabs = [
  { id: 'trend', label: '14 年走勢', heading: `${doc.name}這些年的價格怎麼走的？` },
  yoySeries.length > 1 && { id: 'yoy', label: '跟往年比', heading: `${doc.name}比去年同月貴還是便宜？` },
  daily.length > 1 && { id: 'recent', label: '近 90 天', heading: `${doc.name}最近 90 天的價格變化` },
  marketBars.length > 1 && { id: 'gap', label: '各地價差', heading: `${doc.name}在哪個批發市場最便宜？` },
  // 這個分頁收「為什麼是這個價」的三件事：颱風、年節往例、價格鏈。
  // 三者任一有資料就要有分頁，否則年節往例會算出來卻沒有地方顯示。
  (ty.show || vpShow || fesRows.length > 0 || doc.chain?.comparable) && {
    id: 'why', label: ty.show ? '為什麼貴' : fesRows.length > 0 && !doc.chain?.comparable ? '年節與往例' : '錢流到哪',
    heading: ty.show ? `${doc.name}為什麼現在這個價？`
      : doc.chain?.comparable ? `你付的錢，${doc.name}的農民拿到多少？` : `${doc.name}年節前會漲嗎？`,
  },
].filter(Boolean);

// 一句話講完這一頁：品名、數字、單位、比較基準、日期五件事同句。
// 畫面上這些數字都在（h1 的判斷 + 四張 KPI 卡），這裡是把它們併成一個可以被單獨引用的句子——
// 搜尋引擎的摘要、生成引擎的引用、螢幕閱讀器都受惠，不必自己從卡片拼。
const answer = [
  `${doc.name}${doc.official !== doc.name ? `（行情站名稱：${doc.official}）` : ''}`,
  doc.latest?.price != null ? `目前全國批發加權均價 ${price(doc.latest.price)} 元/公斤` : '目前批發價資料不足',
  doc.change
    ? `，比近三年同一旬${changeWord(doc.change.changePct)}（常年約 ${price(doc.change.baseline3y)} 元/公斤）`
    // 沒有基準時要講明白是「沒得比」而不是「我們沒算」——不然引用的人會以為這個站漏了資料
    : (doc.yoy?.changePct != null ? `，比去年同月${changeWord(doc.yoy.changePct)}（常年同旬交易量不足，不做近三年比較）` : ''),
  doc.retail
    ? `；臺中市公有零售市場實測 ${doc.retail.perCatty} 元/台斤`
      + (doc.retail.p25 != null ? `（常見 ${doc.retail.p25}–${doc.retail.p75} 元/台斤）` : '')
    : '',
  `。資料截至民國 ${roc(doc.lastDate)}，涵蓋民國 101 年起 ${doc.quality.years} 年。`,
].join('');

// FAQ 的答案一律取自這一頁已經顯示的數字，不另外寫內容；沒有資料的題目就不出。
const faq = [
  doc.change && {
    q: `${doc.name}現在貴嗎？`,
    a: `${doc.name}比近三年同一旬${changeWord(doc.change.changePct)}。常年同期約 ${price(doc.change.baseline3y)} 元/公斤，`
      + `目前 ${price(doc.latest?.price)} 元/公斤（全國批發加權平均，民國 ${roc(doc.lastDate)}）。`,
  },
  doc.retail && {
    q: `${doc.name}零售一斤多少錢？`,
    a: `臺中市公有零售市場實測 ${doc.retail.perCatty} 元/台斤（近 ${doc.retail.days} 個訪價日的中位數）`
      + (doc.retail.p25 != null
        ? `，常見範圍 ${doc.retail.p25}–${doc.retail.p75} 元/台斤——攤與攤之間本來就有價差，`
          + `喊價高過 ${doc.retail.p75} 元就算偏貴。`
        : '。')
      + `這是臺中 ${abt.retail.markets} 個公有市場的實測價，不是全台平均；其他縣市沒有開放同型資料，本站不推估攤價。`,
  },
  doc.yoy?.changePct != null && {
    q: `${doc.name}比去年同月貴還是便宜？`,
    a: `比去年同月${changeWord(doc.yoy.changePct)}。去年同月為 ${price(doc.yoy.lastYearPrice)} 元/公斤。`,
  },
  cheapestMarket && priciestMarket && cheapestMarket.code !== priciestMarket.code && {
    q: `${doc.name}在哪個批發市場最便宜？`,
    a: `${cheapestMarket.name}最低（${price(cheapestMarket.price)} 元/公斤），${priciestMarket.name}最高`
      + `（${price(priciestMarket.price)} 元/公斤）`
      + (marketGapPct != null
        ? `，相差 ${marketGapPct}%。`
        : `，相差 ${price(priciestMarket.price - cheapestMarket.price)} 元/公斤。`)
      + `價差反映產地距離與到貨量，不等於你家附近攤子的價格。`
      + (thinMarkets.length > 0
        ? `只比較最近一個月交易量佔全國 1% 以上的市場，另有 ${thinMarkets.length} 個零星交易的市場未列入。`
        : ''),
  },
].filter(Boolean);
---
<Base
  {/* 沒有近三年同旬基準的品項（產季短、或常年同旬沒量）不要問「現在貴嗎」卻不回答——
      那會產出「巴西利現在貴嗎？ — 好康」這種問了沒答案的標題。改成直接給價格。
      不拿「跟去年同月比」去填那個位置：全站「現在貴嗎」一律是近三年同旬的口徑，
      同樣的問句換一個基準回答，比不回答更容易誤導。 */}
  title={doc.change
    ? `${doc.name}價格現在貴嗎？${changeWord(doc.change.changePct)} — 好康`
    : doc.latest?.price != null
      ? `${doc.name}批發價 ${price(doc.latest.price)} 元/公斤 — 好康`
      : `${doc.name}批發行情 — 好康`}
  description={doc.change
    ? `${doc.name}比近三年同期${changeWord(doc.change.changePct)}。${doc.retail ? `台中零售實測 ${cattyPrice(doc.retail)}。` : ''}民國 101 年起 ${doc.quality.years} 年資料。`
    : `${doc.name}最新批發均價${doc.latest?.price != null ? ` ${price(doc.latest.price)} 元/公斤` : ''}${doc.yoy?.changePct != null ? `，比去年同月${changeWord(doc.yoy.changePct)}` : ''}。常年同旬交易量不足，不做近三年比較。民國 101 年起 ${doc.quality.years} 年資料。`}
  noindex={!doc.quality.indexable}
  lastDate={roc(doc.lastDate)}
  bare={true}
  crumbs={[{ name: '找食材', path: '/crop/' }, { name: doc.name, path: `/crop/${doc.slug}/` }]}
  dataset={{
    name: `${doc.name}（${doc.official}）批發行情`,
    description: `${doc.name}在台灣農產品批發市場的交易行情：全國月加權均價、各市場價差、近 90 天日均價。`
      + `資料來自農業部農糧署行情報導站，單位元/公斤。`,
    temporalStart: '2012-01-01',
    unit: '元/公斤',
  }}
  faq={faq}
>
  <div class="shell screen">
    <div class="screen-hd">
      <a class="brand" href="/">好康 hó-khang</a>
      <nav>
        <a href="/cheap/">這週划算</a><a href="/crop/">找食材</a><a href="/market/">市場</a><a href="/about/">關於資料</a>
      </nav>
    </div>

    <div>
      <h1>
        {doc.name}<span class="muted"> {v.text}</span>
        {doc.quality.indexable && doc.tcType !== 'N06' && (
          <button class="add-btn" data-add-slug={doc.slug} data-add-name={doc.name}
                  style="font-size:var(--text-sm);vertical-align:middle;margin-left:0.75rem">＋ 加入買菜清單</button>
        )}
      </h1>
      <p class="sub">
        {doc.official !== doc.name && <>行情站叫「{doc.official}」</>}
        {doc.also?.length ? `，也有人叫${doc.also.join('、')}` : ''}
        {season && <> · <span class="season-tag">{season}</span></>}
        {!doc.quality.indexable && <span class="muted"> · 交易資料偏少</span>}
      </p>
      {/* 同一組數字，畫面上是四張 KPI 卡，這裡是併成一句的版本。不重複顯示（版面放不下），
          但搜尋引擎的摘要、生成引擎的引用、螢幕閱讀器都需要一個不必自己拼的句子。 */}
      <p class="sr-only">{answer}</p>

      <div class="kpi-row" style="margin-top:0.75rem">
        <div class="kpi">
          <div class="k">跟近三年同期比</div>
          <div class={`v ${dirClass(doc.change?.changePct)}`}>{doc.change ? changeWord(doc.change.changePct) : '—'}</div>
          <div class="d">{doc.change ? `常年約 ${price(doc.change.baseline3y)} 元/公斤` : '資料不足'}</div>
        </div>
        {doc.retail ? (
          <div class="kpi">
            <div class="k">台中零售實測</div>
            <div class="v">{doc.retail.perCatty}</div>
            {/* 訪價密度差很多（絲瓜天天有、柿子只有產季那幾週），不標的話兩者長得一樣 */}
            <div class="d">
              {doc.retail.p25 != null
                ? `元/台斤 · 常見 ${doc.retail.p25}–${doc.retail.p75}`
                : '元/台斤 · 公有市場中位數'}
              {doc.retail.cover != null && doc.retail.cover < 0.35 ? ` · 僅產季訪得到價` : ''}
            </div>
          </div>
        ) : (
          <div class="kpi">
            <div class="k">批發價</div>
            <div class="v">{price(doc.latest?.price)}</div>
            <div class="d">元/公斤 · 無零售實測，不推估攤價</div>
          </div>
        )}
        <div class="kpi">
          <div class="k">跟去年同月比</div>
          <div class={`v ${dirClass(doc.yoy?.changePct)}`}>{pct(doc.yoy?.changePct)}</div>
          <div class="d">去年同月 {price(doc.yoy?.lastYearPrice)} 元/公斤</div>
        </div>
        <div class="kpi">
          <div class="k">{alt ? '太貴的話' : '近 90 天交易'}</div>
          <div class="v">{alt ? <a href={`/crop/${alt.slug}/`}>{alt.name}</a> : doc.quality.days90}</div>
          <div class="d">{alt ? `同類，${changeWord(alt.changePct)}` : `個交易日 · ${volume(doc.quality.volume90)}`}</div>
        </div>
      </div>

      {doc.retail?.p25 != null && (
        <div class="price-check" data-p25={doc.retail.p25} data-p75={doc.retail.p75} data-med={doc.retail.perCatty}>
          <label for="pc-in">攤子上喊多少？</label>
          <input id="pc-in" type="number" inputmode="decimal" min="0" step="1" placeholder="元/台斤" />
          <span class="unit">元/台斤</span>
          {/* 判斷結果是使用者輸入後才出現的，所以要 aria-live；沒有 JS 時整塊照樣是
              「常見 33–60」這個可讀的事實，不會變成壞掉的表單 */}
          <output id="pc-out" aria-live="polite"></output>
          <span class="note muted">
            比的是臺中 {doc.retail.markets} 個公有零售市場近 {doc.retail.days} 個訪價日的常見範圍
            （{doc.retail.p25}–{doc.retail.p75} 元/台斤，中位 {doc.retail.perCatty}）。
            其他縣市沒有開放同型資料，不推估。
          </span>
        </div>
      )}
    </div>

    <div class="tabs">
      {tabs.map((t, i) => <input type="radio" name="croptab" id={`ct-${t.id}`} checked={i === 0} />)}
      <div class="tab-bar">
        {tabs.map((t) => <label for={`ct-${t.id}`}>{t.label}</label>)}
      </div>
      <div class="panels">
        {tabs.map((t) => (
          <div class="panel">
            {/* label 是點擊目標，不是標題：沒有這個 h2，整頁就只有一個 h1、沒有階層可言。
                畫面上分頁列已經標示所在位置，所以 h2 走 sr-only，用問句而非欄位名。 */}
            <h2 class="sr-only">{t.heading}</h2>
            {t.id === 'trend' && (
              <PriceLine
                series={[{ id: 'nat', label: '全國批發加權均價', role: 'main', points: monthly }]}
                caption={`${doc.name}（${doc.official}）全國月加權均價，民國 101 年起——官方平台只留兩年`}
                tableLabel="年月" height={260}
              />
            )}
            {t.id === 'yoy' && (
              <PriceLine series={yoySeries} caption={`${doc.name} 逐月價格，近三年疊圖：同月份對齊才分得出是季節正常還是反常`} tableLabel="月份" height={260} />
            )}
            {t.id === 'recent' && (
              <PriceLine
                series={[{ id: 'd', label: '全國批發加權均價', role: 'main', points: daily }]}
                caption={`${doc.name} 近 90 天全國加權均價`} tableLabel="日期" height={260}
              />
            )}
            {t.id === 'gap' && (
              <>
                {md ? (
                  <>
                    <p class="ty-note">
                      最近一個交易日（民國 {roc(md.date)}）量夠的 {md.solidMarkets} 個市場裡，
                      <strong>{md.dearest.name ?? md.dearest.code}</strong> 成交均價最高 {price(md.dearest.price)}、
                      <strong>{md.cheapest.name ?? md.cheapest.code}</strong> 最低 {price(md.cheapest.price)} 元/公斤
                      {md.gapPct != null ? `，差 ${md.gapPct}%` : ''}。
                    </p>
                    <ul class="rest-days">
                      {mdSolid.map((m) => (
                        <li>
                          <a href={`/crop/${doc.slug}/${m.code}/`}>{m.name ?? m.code}</a>
                          {' '}{price(m.price)}
                          <span class="muted"> · 當日量 {Math.round(m.share * 100)}%{m.codes ? ` · ${m.codes} 種` : ''}</span>
                        </li>
                      ))}
                    </ul>
                    {mdCodeRange && (
                      <p class="note muted">
                        「種」是當日該市場成交的官方作物代號數（{mdCodeRange}）。
                        代號組合不同，均價就不同——市場間的差距不能全算成地區價差。
                      </p>
                    )}
                  </>
                ) : mdRaw ? (
                  <p class="ty-note">
                    最近一個交易日（民國 {roc(mdRaw.date)}）只有 {mdRaw.markets} 個市場有 {doc.name} 的成交
                    {mdRaw.solidMarkets < mdRaw.markets ? `（其中 ${mdRaw.markets - mdRaw.solidMarkets} 個量太少）` : ''}，
                    這一天比不出哪個市場高。下面是近一個月的月均價。
                  </p>
                ) : null}
                {/* 每條長條自己是 hit target（dataviz：bars 不用 crosshair，mark 自己帶 tooltip
                    並在 hover/focus 時有反應）。值同時在右欄直接標示，tooltip 只是增強不是唯一途徑。 */}
                <div class="bars">
                  {marketBars.map((m) => (
                    <div class="bar-row" tabindex="0"
                         data-bar-name={m.name ?? m.code}
                         data-bar-value={`${price(m.price)} 元/公斤`}
                         data-bar-rank={m.code === cheapestMarket?.code ? '最便宜'
                           : m.code === priciestMarket?.code ? '最貴' : ''}>
                      <a class="bar-name" href={`/crop/${doc.slug}/${m.code}/`}>{m.name ?? m.code}</a>
                      <div class="bar-track">
                        <div class={`bar-fill ${m.code === cheapestMarket?.code ? 'is-low' : m.code === priciestMarket?.code ? 'is-high' : ''}`} style={`width:${m.pct}%`}></div>
                      </div>
                      <div class="bar-val tabular">{price(m.price)}</div>
                    </div>
                  ))}
                  <div class="bar-tip" data-bar-tip hidden></div>
                </div>
                <p class="note">
                  {cheapestMarket && priciestMarket && cheapestMarket.code !== priciestMarket.code && (
                    <>最貴的<strong>{priciestMarket.name}</strong>比最便宜的<strong>{cheapestMarket.name}</strong>
                    {marketGapPct != null
                      ? <>高<strong> {marketGapPct}%</strong>。</>
                      : <>高<strong> {price(priciestMarket.price - cheapestMarket.price)} 元/公斤</strong>（最低價是 0，算不出倍數）。</>}
                    </>
                  )} 價差反映產地距離與到貨量，不是你家附近攤子的價格。
                  同一個品項名底下含多個官方作物代號，市場之間的差距有一部分是品種與等級組合不同，
                  講的是「這個市場的成交均價較高」，不是「同一批貨在這裡賣得比較貴」。
                  {thinMarkets.length > 0 && (
                    <> 另有 {thinMarkets.length} 個市場最近一個月的交易量不到全國的 1%，
                    一兩筆零星成交就能讓均價失真，未列入比較：
                    {thinMarkets.map((m, i) => (
                      <>{i > 0 && '、'}<a href={`/crop/${doc.slug}/${m.code}/`}>{marketName(m)}</a></>
                    ))}。</>
                  )}
                </p>
              </>
            )}
            {t.id === 'why' && (
              <>
                {ty.show && (
                  <div class="typhoon">
                    {/* 這個面板底下是兩個獨立的問題（颱風、價格鏈），各自該有自己的標題 */}
                    <h3 class="sr-only">{ty.latest.name}颱風之後，{doc.name}還要多久回穩？</h3>
                    <p class="typhoon-lead">
                      <strong>{ty.latest.name}颱風</strong>（{ty.latest.start.slice(5).replace('-', '/')}–{ty.latest.end.slice(5).replace('-', '/')}，{ty.latest.intensity}）結束後第 <strong>{ty.latest.daysSince}</strong> 天。
                    </p>
                    {ty.now && (
                      <p class={ty.now.recovered ? 'down' : 'up'}>
                        {/* 回穩的判準是「基準的 1.1 倍以內」，所以「已回穩」也可能還貴幾 %。
                            那種情況寫「已經回到颱風前的價格」會跟旁邊的數字自相矛盾。 */}
                        {Math.round(ty.now.pct) < 1 && ty.now.pct > 0
                          ? `${doc.name}現在跟颱風前差不多（颱風前 ${price(ty.now.baseline)} → 現在 ${price(ty.now.price)} 元/公斤）。`
                          : ty.now.pct <= 0
                          ? `${doc.name}已經回到颱風前的價格（颱風前 ${price(ty.now.baseline)} → 現在 ${price(ty.now.price)} 元/公斤）。`
                          : ty.now.recovered
                            ? `${doc.name}差不多回到颱風前的水準（颱風前 ${price(ty.now.baseline)} → 現在 ${price(ty.now.price)} 元/公斤，還貴 ${Math.round(ty.now.pct)}%）。`
                            : `${doc.name}現在 ${price(ty.now.price)} 元/公斤，比颱風前的 ${price(ty.now.baseline)} 元貴 ${Math.round(ty.now.pct)}%。`}
                      </p>
                    )}
                    {ty.crop?.medianRecoveryDays != null && (
                      <p>
                        {doc.name}在歷次颱風後通常漲 <strong>{ty.crop.medianPeakPct}%</strong>，約 <strong>{ty.crop.medianRecoveryDays} 天</strong>回到颱風前價格（{ty.crop.affectedCount}/{ty.crop.samples} 次颱風有明顯影響）。
                      </p>
                    )}
                    {ty.daysLeft != null && !ty.now?.recovered && (
                      <p class={ty.daysLeft > 0 ? 'up' : 'down'}>
                        {ty.daysLeft > 0 ? `照往例還要再 ${ty.daysLeft} 天左右才會回穩。` : '已超過往例的回穩天數，價格應該陸續回來了。'}
                      </p>
                    )}
                    <p class="note"><a href="/typhoon/">這次颱風後還有哪些沒回穩、哪些已經可以買</a></p>
                  </div>
                )}
                {vpShow && (
                  <div class={ty.show ? 'festival' : 'festival is-first'}>
                    <h3 class="sr-only">{doc.name}的價格跟到貨量有多相關？</h3>
                    <p>
                      {doc.name}的到貨量少一成，價格往例上大約貴 <strong>{vpShow.pct10}%</strong>
                      <span class="muted">（全國旬資料 {vpShow.n} 個旬，相關 {vpShow.r}）</span>。
                    </p>
                    {vpShow.now && (
                      <p class={(vpShow.now.prevPct ?? vpShow.now.volPct ?? 0) < 0 ? 'up' : 'down'}>
                        {vpShow.now.xun}全國到貨量
                        {vpShow.now.volPct != null && (
                          <>比近 {vpShow.now.baseYears} 年同旬{vpShow.now.volPct < 0 ? '少' : '多'} <strong>{Math.abs(vpShow.now.volPct)}%</strong></>
                        )}
                        {vpShow.now.prevPct != null && (
                          <>{vpShow.now.volPct != null ? '、' : ''}比前一旬（{vpShow.now.prevXun}）
                          {vpShow.now.prevPct < 0 ? '少' : '多'} <strong>{Math.abs(vpShow.now.prevPct)}%</strong></>
                        )}
                        {/* 換算只用「跟上一旬比」的幅度，因為迴歸本身就是用相鄰旬的變動估的；
                            幅度太大就不換算，那是把迴歸外推到樣本邊緣。 */}
                        {vpShow.now.prevPct == null ? '。'
                          : vpShow.now.impliedOutOfRange
                            ? '。這個幅度超出往例的常見範圍，不換算成價差。'
                            : `，照上面的關係大約對應價格${vpShow.now.impliedPricePct > 0 ? '貴' : '便宜'} ${Math.abs(vpShow.now.impliedPricePct)}%。`}
                      </p>
                    )}
                  </div>
                )}
                {fesRows.length > 0 && (
                  <div class={ty.show ? 'festival' : 'festival is-first'}>
                    <h3 class="sr-only">{doc.name}年節前會漲嗎？</h3>
                    {fesRows.map((f) => (
                      <p>
                        {f.stat.medianPeakPct != null
                          ? <>{f.name}前，{doc.name}通常比同時節貴 <strong>{f.stat.medianPeakPct}%</strong>，
                              高峰落在{f.label}前 <strong>{f.stat.medianDaysBefore} 天</strong>
                              （{f.stat.samples} 個年份裡 {f.stat.affectedCount} 次明顯漲）。</>
                          : <>{f.name}前，{doc.name}的漲幅不明顯：{f.stat.samples} 個年份裡只有 {f.stat.affectedCount} 次比同時節明顯貴，不必提前搶。</>}
                      </p>
                    ))}
                    <p class="note muted">
                      年節效應已扣掉季節性：拿同一個曆日、但那年距離該節慶超過兩週的年份當對照
                      （農曆節慶的國曆日期每年前後移動三週）。節前窗碰到颱風的年份不採計。
                    </p>
                  </div>
                )}
                {doc.chain?.comparable && (
                  <div style={ty.show ? 'margin-top:1rem' : ''}>
                    <h3 class="sr-only">{doc.name}從產地到你手上，價格怎麼變的？</h3>
                    <div class="chain">
                      <div class="chain-step">
                        <div class="chain-k">產地<span class="muted"> · 農民賣出</span></div>
                        <div class="chain-v">{doc.chain.origin}</div>
                        <div class="chain-d">元/公斤 · {doc.chain.xun}</div>
                      </div>
                      <div class="chain-arrow">×{doc.chain.originToWholesale}</div>
                      <div class="chain-step">
                        <div class="chain-k">批發<span class="muted"> · 果菜市場</span></div>
                        <div class="chain-v">{doc.chain.wholesale}</div>
                        <div class="chain-d">元/公斤 · 全國加權</div>
                      </div>
                      {doc.chain.retailPerKg && (
                        <>
                          <div class="chain-arrow">×{doc.chain.wholesaleToRetail}</div>
                          <div class="chain-step">
                            <div class="chain-k">零售<span class="muted"> · 你買到的</span></div>
                            <div class="chain-v">{doc.chain.retailPerKg}</div>
                            <div class="chain-d">元/公斤 · 台中公有市場</div>
                          </div>
                        </>
                      )}
                    </div>
                    {doc.chain.farmerShare != null && (
                      doc.chain.retailCover != null && doc.chain.retailCover < 0.35 ? (
                        // 低訪價密度時不端出「農民拿 X 元」——那個數字會被當結論讀，
                        // 但它的零售端只來自產季那幾週，講清楚基礎比給一個好記的數字誠實
                        <p class="note">
                          零售端只有產季訪得到價（{doc.chain.retailSamples} 筆），
                          這條鏈的比例會隨產季前後變動，這裡不換算農民拿多少。
                        </p>
                      ) : (
                        <p class="note">你付的每 100 元裡，農民拿到約 <strong>{doc.chain.farmerShare} 元</strong>。</p>
                      )
                    )}
                  </div>
                )}
              </>
            )}
          </div>
        ))}
      </div>
    </div>

    <div class="screen-ft">
      農糧署批發行情，更新至民國 {roc(doc.lastDate)} · 價格為交易量加權平均 · <a href="/about/">資料說明</a>
    </div>
  </div>

  <script>
    // 各地價差長條：每條自己帶 tooltip（dataviz — bars 不用 crosshair，mark 自己是 hit target），
    // 鍵盤 focus 與滑鼠 hover 給一樣的內容。市場名是資料，一律 textContent 寫入。
    for (const bars of document.querySelectorAll('.bars')) {
      const tip = bars.querySelector('[data-bar-tip]');
      if (!tip) continue;
      const show = (row) => {
        const value = document.createElement('strong');   // 值是主角，名稱次之
        value.textContent = row.dataset.barValue ?? '';
        tip.textContent = '';
        tip.append(`${row.dataset.barName ?? ''} `, value);
        if (row.dataset.barRank) tip.append(` · ${row.dataset.barRank}`);
        tip.hidden = false;
      };
      const hide = () => { tip.hidden = true; };
      for (const row of bars.querySelectorAll('.bar-row')) {
        row.addEventListener('pointerenter', () => show(row));
        row.addEventListener('focus', () => show(row));
        row.addEventListener('pointerleave', hide);
        row.addEventListener('blur', hide);
      }
      bars.addEventListener('pointerleave', hide);
    }
  </script>
  {doc.retail?.p25 != null && (
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const box = document.querySelector('.price-check');
        if (!box) return;
        const inp = box.querySelector('#pc-in');
        const out = box.querySelector('#pc-out');
        const p25 = +box.dataset.p25, p75 = +box.dataset.p75, med = +box.dataset.med;
        const say = () => {
          const v = parseFloat(inp.value);
          if (!Number.isFinite(v) || v <= 0) { out.textContent = ''; out.className = ''; return; }
          // 判準就是價帶：落在 p25–p75 之間算正常，超出就講差多少 %。
          // 不自己再發明一套「偏貴幾成算貴」的級距——那會變成沒有資料根據的斷言。
          if (v < p25) {
            out.textContent = `比常見範圍還低 ${Math.round(((p25 - v) / p25) * 100)}%，算便宜`;
            out.className = 'down';
          } else if (v > p75) {
            out.textContent = `比常見範圍高 ${Math.round(((v - p75) / p75) * 100)}%，偏貴`;
            out.className = 'up';
          } else {
            out.textContent = v <= med ? '落在常見範圍內，偏便宜那半' : '落在常見範圍內，算正常';
            out.className = '';
          }
        };
        inp.addEventListener('input', say);
      });
    </script>
  )}
</Base>
