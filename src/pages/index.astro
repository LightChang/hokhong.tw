---
import SiteNav from '../components/SiteNav.astro';
import Base from '../layouts/Base.astro';
import MethodLink from '../components/MethodLink.astro';
import HomeWeek from '../components/HomeWeek.astro';
import { home, typhoon, festival, festivalMenu, siteIndex, listSource, popularCrops, latestTradedCrops, meatIndex, roc, changeWord, cattyPrice, price } from '../lib/pagedata.mjs';

// 首頁只回答一件事：這週買菜，什麼划算、什麼先別買。
// 一頁寬一頁高 → 沒有圖表、沒有長清單、沒有資料集自我介紹。
const h = await home();
const ty = (await typhoon())?.latest ?? null;
const tyNote = ty && ty.daysSince != null && ty.daysSince <= 21 ? ty : null;
// 颱風剛過那三週，「這週什麼划算」的前提整個變了——貴不是因為季節，是因為颱風。
// 首頁只給一句話跟一個出口，清單在 /typhoon/（首頁是一螢幕高，塞不下清單）。
const tyNow = tyNote ? (await typhoon())?.now ?? null : null;

// 年節前六週才講這件事，其餘時間首頁不該被它佔位置（往例永久留在品項頁）。
// 名字用「除夕」而不是「春節」：買菜的人排的是除夕前那幾天的行程。
const FES_WINDOW = 42;
const fes = await festival();
const fesNext = fes?.next && fes.next.daysUntil <= FES_WINDOW ? fes.next : null;
// 有漲幅往例的節日才講「往年這時候開始漲的是…」；尾牙、元宵、中元、冬至沒有往例
// （理由見 transform/festival.mjs），那就只給節日食材頁的入口，不要硬湊一句話。
const fesList = fesNext ? fes.byFestival?.[fesNext.type] ?? null : null;
// 節日食材頁的網址是小寫 id，跟往例的鍵不一定同字（midautumn vs midAutumn）
const fesMenu = fesNext ? ((await festivalMenu())?.festivals ?? []).find((x) => (x.key ?? x.id) === fesNext.type) ?? null : null;
// 年節資料用官方作物名（柿、蕹菜），首頁一律講俗名（柿子、空心菜）並連到品項頁
const fesNamed = fesList
  ? await (async () => {
      const byKey = new Map((await siteIndex()).crops.map((c) => [`${c.tcType}-${c.plv3Key}`, c]));
      return fesList.crops.map((c) => ({ ...c, site: byKey.get(`${c.tcType}-${c.key}`) ?? null })).slice(0, 4);
    })()
  : [];

// 首頁分頁「這週青菜／這週水果／這週肉類」（站主 2026-09-28）。蔬果依類別切（transform 的 home.byType），
// 三塊跟原本「這週行情」一樣：划算、先別買、當季。價格一律附單位。
const cropRow = (c) => ({
  href: `/crop/${c.slug}/`, name: c.name, seasonal: c.seasonal, changePct: c.changePct,
  sub: (cattyPrice(c.retail) ? `台中零售 ${cattyPrice(c.retail)}` : `批發 ${price(c.wholesale)} 元/公斤`)
    + (c.also?.length ? ` · 又叫${c.also[0]}` : ''),
});
const weekCols = (t) => !t ? [] : [
  { title: '這些划算', cls: 'down', rows: t.cheap.map(cropRow) },
  { title: '這些先別買', cls: 'up', rows: t.pricey.map((c) => ({
    ...cropRow(c),
    sub: c.alternatives?.length ? `改買 ${c.alternatives.map((a) => a.name).join('、')}` : cropRow(c).sub,
  })) },
  // 當季：便宜的在前——當季又便宜才是真的該買
  { title: `${h.month} 月當季`, rows: t.seasonalNow.map((c) => ({
    href: `/crop/${c.slug}/`, name: c.name, changePct: c.changePct,
    sub: (cattyPrice(c.retail) ? `台中零售 ${cattyPrice(c.retail)}`
      : c.wholesale != null ? `批發 ${price(c.wholesale)} 元/公斤` : '交易量少')
      + (c.counties?.length ? ` · 產地 ${c.counties.slice(0, 2).join('、')}` : ''),
  })) },
];
// 這週肉類：直接用肉蛋清單頁的資料（/meat/ 同一份 meat/index.json、同一個比較基準），不另算；肉蛋沒有「當季」。
const meatItems = (await meatIndex().catch(() => null))?.items ?? [];
const meatRow = (m) => ({
  href: `/meat/${m.slug}/`, name: m.item, changePct: m.changePct,
  sub: m.retail?.[0] ? `台中零售 ${m.retail[0].column} ${m.retail[0].perCatty} 元/斤`
    : `${m.unit === '元/公斤' ? '批發' : '產地'} ${price(m.price)} ${m.unit}`,
});
const meatCols = [
  { title: '這些划算', cls: 'down', rows: meatItems.filter((m) => m.changePct != null && m.changePct < 0)
    .sort((a, b) => a.changePct - b.changePct).slice(0, 6).map(meatRow) },
  { title: '這些先別買', cls: 'up', rows: meatItems.filter((m) => m.changePct != null && m.changePct > 0)
    .sort((a, b) => b.changePct - a.changePct).slice(0, 6).map(meatRow) },
];

// 每週菜單的常設入口（站主 2026-09-28）：一行連結，不佔版面；週次與菜色由 festival-menu.json 的 weeks 算好
const weekNow = ((await festivalMenu())?.weeks ?? []).find((w) => w.thisWeek) ?? null;

// 買菜清單的資料整包內嵌（20 KB）：靜態站沒有後端，清單存在瀏覽器，
// 前端要能自己查「這 16 樣現在貴不貴」，內嵌比再發一次請求單純。
const src = await listSource();

// 常查品項：首頁是全站最強的入口，大家天天查價格的品項要從這裡連得到
const popular = await popularCrops(20);
// 最新行情：最近一次有成交的品項（避開這一頁其他地方已列過的），讓入口頁每天連到資料剛變動的品項頁
const latestTraded = await latestTradedCrops(20, [
  ...popular.map((c) => c.slug), ...['N04', 'N05'].flatMap((tc) => ['cheap', 'pricey', 'seasonalNow'].flatMap((k) => (h.byType?.[tc]?.[k] ?? []).map((c) => c.slug))),
]);
---
<Base
  title="這週買菜，什麼划算 — 好康 hó-khang"
  description={`${h.targetXun}的農產品行情：${h.cheap.slice(0, 3).map((c) => `${c.name}${changeWord(c.changePct)}`).join('、')}。比的是近三年同期，不是昨天。`}
  lastDate={roc(h.lastDate)}
  bare={true}
>
  <div class="shell home" data-fes-key={fesNext?.type ?? ''} data-fes-name={fesNext?.label ?? ''} data-fes-days={fesNext?.daysUntil ?? ''}>
    <div class="home-hd">
      <a class="brand" href="/">好康 hó-khang</a>
      <SiteNav />
    </div>

    <div>
      {/* 標題不顯示在畫面上：導覽列已經說明你在哪一頁，內容直接開始。
          h1 仍留在 DOM（sr-only）給搜尋引擎與螢幕閱讀器。 */}
      <h1 class="sr-only">這週買菜，這些划算</h1>
      {fesNext && (
        <p class="ty-note">
          距離<strong>{fesNext.label}</strong>還有 {fesNext.daysUntil} 天。
          {fesList && fesNamed.length > 0 && (
            <>往年這時候開始漲的是
              {fesNamed.map((c, i) => (
                <>{i > 0 && '、'}
                  {c.site ? <a href={`/crop/${c.site.slug}/`}>{c.site.name}</a> : c.plv3}
                  （貴 {c.medianPeakPct}%）</>
              ))}
              <span class="muted">，高峰多半落在{fesNext.label}前 {fesList.medianDaysBefore} 天。</span>{' '}
            </>
          )}
          {fesMenu && <a href={`/festival/${fesMenu.id}/`}>{fesMenu.name}要買什麼（{fesMenu.ingredients.length} 樣食材）</a>}
        </p>
      )}
      {tyNow && tyNow.notRecovered > 0 && (
        <p class="ty-note">
          <strong>{tyNow.name}颱風</strong>過後第 {tyNow.daysSince} 天，
          <a href="/typhoon/">{tyNow.notRecovered} 個品項還沒回到颱風前的價格</a>
          <span class="muted">（{tyNow.recovered} 個已經回穩）</span>
        </p>
      )}
      {weekNow && (
        <p class="note"><a href={`/festival/${weekNow.page}/`}>這週菜單：{weekNow.name}（{weekNow.dishes.slice(0, 3).map((d) => d.dish).join('、')}）→</a></p>
      )}
    </div>

    <div class="tabs">
      <input type="radio" name="hometab" id="ht-veg" checked />
      <input type="radio" name="hometab" id="ht-fruit" />
      <input type="radio" name="hometab" id="ht-meat" />
      <input type="radio" name="hometab" id="ht-list" />
      <input type="radio" name="hometab" id="ht-where" />
      <div class="tab-bar">
        <label for="ht-veg">這週青菜</label>
        <label for="ht-fruit">這週水果</label>
        <label for="ht-meat">這週肉類</label>
        <label for="ht-list">我的買菜清單</label>
        <label for="ht-where">常查品項</label>
      </div>

      <div class="panels">
        <div class="panel"><HomeWeek cols={weekCols(h.byType?.N04)} empty="這一旬沒有足夠的蔬菜可跟常年比較。" /></div>
        <div class="panel"><HomeWeek cols={weekCols(h.byType?.N05)} empty="這一旬沒有足夠的水果可跟常年比較。" /></div>
        <div class="panel"><HomeWeek cols={meatCols} empty="這一旬沒有足夠的肉蛋品項可跟常年比較。"
                                     more={{ href: '/meat/', label: '全部肉蛋行情（豬肉、雞肉、雞蛋、鴨鵝）' }} /></div>

        <div class="panel">
          <div class="list-tools">
            <label class="sr-only" for="hk-q">搜尋品項</label>
            <input id="hk-q" type="search" placeholder="找菜" autocomplete="off" />
            <label class="sr-only" for="hk-add">加入品項</label>
            <select id="hk-add">
              <option value="">＋ 加一項…</option>
            </select>
            <button type="button" id="hk-reset"><span class="hide-sm">恢復</span>預設清單</button>
            <span class="count" id="hk-count"></span>
          </div>
          <ul class="rows editable" id="hk-list"></ul>
          <p class="list-empty" id="hk-empty" hidden>清單是空的。用上面的選單加入你常買的菜。</p>
          <p class="note muted"><MethodLink to="privacy" label="隱私" /></p>
        </div>

        <div class="panel">
          <nav class="siblings" style="margin-top:0;border-top:0;padding-top:0" aria-labelledby="hw-pop">
            <h2 id="hw-pop">常查品項價格<span class="muted">（近 90 天全國交易量最大）</span></h2>
            <ul>{popular.map((c) => <li><a href={`/crop/${c.slug}/`}>{c.name}價格</a></li>)}</ul>
          </nav>
          {latestTraded.length > 0 && (
            <nav class="siblings" aria-labelledby="hw-new">
              <h2 id="hw-new">最新行情<span class="muted">（依最近成交日排序，最新是民國 {roc(latestTraded[0].last)}）</span></h2>
              <ul>{latestTraded.map((c) => <li><a href={`/crop/${c.slug}/`}>{c.name}價格</a></li>)}</ul>
            </nav>
          )}
        </div>
      </div>
    </div>

    <div class="home-ft">
      {/* 侷限的完整說明（哪些市場、零售只有臺中、口徑）在 /about，首頁不重述——
          那段字會佔掉主榜的位置，每天來看行情的人也不需要每次重讀。
          但來源機關與授權要留在首頁：這是全站權重最強的一頁，也是生成引擎最常抓的一頁，
          沒有它就只剩一堆數字，說不出這些數字是誰發布的。 */}
      <p class="home-src">
        資料來源：農業部農糧署「農產品交易行情」（政府資料開放授權條款第 1 版），
        更新至民國 {roc(h.lastDate)}。<a href="/about/">資料說明</a>
      </p>
    </div>
  </div>

  <script type="application/json" id="hk-source" set:html={JSON.stringify(src)} />

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const src = JSON.parse(document.getElementById('hk-source').textContent);
      // 下一個節日的鍵與名稱（伺服器端算好，前端只負責挑該節日的往例數字）
      const fesDs = document.querySelector('.shell.home')?.dataset ?? {};
      const fesKey = fesDs.fesKey || '';
      const fesName = fesDs.fesName || '';
      const fesDays = Number(fesDs.fesDays || '');
      const bySlug = new Map(src.crops.map((c) => [c.slug, c]));
      const byName = new Map(src.crops.map((c) => [c.name, c]));
      const defaults = src.defaults.map((n) => byName.get(n)?.slug).filter(Boolean);

      const sel = document.getElementById('hk-add');
      const listEl = document.getElementById('hk-list');
      const emptyEl = document.getElementById('hk-empty');
      const countEl = document.getElementById('hk-count');

      const chgWord = (p) => (p == null ? '—' : (p < 0 ? '便宜 ' : '貴 ') + Math.abs(Math.round(p)) + '%');
      const dir = (p) => (p == null ? '' : p > 0 ? 'up' : p < 0 ? 'down' : '');
      // 與 pagedata.mjs 的 levelClass/levelText 同一套級距（色塊只編碼程度，文字色仍由 dir 決定）
      const lv = (p) => p == null ? 'lv' : p <= -30 ? 'lv lv-c3' : p <= -10 ? 'lv lv-c2'
        : p < 10 ? 'lv' : p < 30 ? 'lv lv-p1' : p < 100 ? 'lv lv-p2' : 'lv lv-p3';
      const lvText = (p) => p == null ? '資料不足' : p <= -30 ? '比常年便宜很多' : p <= -10 ? '比常年便宜'
        : p < 10 ? '跟常年差不多' : p < 30 ? '比常年貴一些' : p < 100 ? '比常年貴很多' : '比常年貴一倍以上';

      // 第一次來：帶入預設家常菜。之後完全依使用者自己的清單（就算清空也不會又跑回來）
      const current = () => {
        const saved = window.hk.read();
        if (saved === null) { window.hk.write(defaults); return defaults.slice(); }
        return saved;
      };

      // 一百多項擠在一個 select 裡太長，兩手一起用：打字縮短、再依買菜分類分組
      function fillPicker() {
        const set = new Set(current());
        const q = document.getElementById('hk-q').value.trim();
        const groups = new Map();
        for (const c of src.crops) {
          // menu: false＝只為了讓節日頁加進來的品項能顯示，不列在選單裡（見 transform/festival-menu.mjs）
          if (c.menu === false || set.has(c.slug) || (q && !c.name.includes(q))) continue;
          if (!groups.has(c.cat)) groups.set(c.cat, []);
          groups.get(c.cat).push(c);
        }
        const n = [...groups.values()].reduce((s, a) => s + a.length, 0);
        const head = q ? (n ? `＋ 加入（${n} 項符合）` : `找不到「${q}」`) : '＋ 加一項…';
        sel.innerHTML = `<option value="">${head}</option>` +
          [...groups].map(([cat, cs]) =>
            `<optgroup label="${cat}">${cs.map((c) => `<option value="${c.slug}">${c.name}</option>`).join('')}</optgroup>`
          ).join('');
        sel.disabled = n === 0;
      }

      function render() {
        const slugs = current();
        const items = slugs.map((s) => bySlug.get(s)).filter(Boolean)
          .sort((a, b) => (b.changePct ?? -999) - (a.changePct ?? -999));   // 貴的排前面，先看到該避開的

        listEl.innerHTML = items.map((c) => {
          // 清單上的每一項都接上解釋層：為什麼貴、是不是產季、節前會不會漲。
          // 只講算得出來的，沒有資料就不出現那個標籤。
          const tags = [];
          if (c.tyPct != null) tags.push(`颱風後還比颱風前貴 ${Math.round(c.tyPct)}%`);
          if (c.inSeason === false && c.cheapestMonth) tags.push(`非產季，最便宜是 ${c.cheapestMonth}`);
          if (fesKey && c.fesPct && c.fesPct[fesKey] != null) tags.push(`${fesName}前往例漲 ${Math.round(c.fesPct[fesKey])}%${fesDays ? `（還有 ${fesDays} 天）` : ''}`);
          const base = c.alt && (c.changePct ?? 0) >= 20
            ? `改買 ${c.alt}`
            : (c.retailPerCatty ? `台中零售 ${c.retailPerCatty} 元/斤` : (c.wholesale ? `批發 ${c.wholesale} 元/公斤` : ''));
          const sub = [base, ...tags].filter(Boolean).join(' · ');
          return `<li>
            <a href="/crop/${c.slug}/">
              <span class="nm">${c.name}${c.seasonal ? '<span class="season-tag"> · 當季</span>' : ''}
                <span class="sub">${sub}</span></span>
              <span class="num tabular ${dir(c.changePct)}"><i class="${lv(c.changePct)}" title="${lvText(c.changePct)}" aria-hidden="true"></i>${chgWord(c.changePct)}</span>
            </a>
            <button type="button" class="list-row-del" data-del="${c.slug}" aria-label="從清單移除 ${c.name}">移除</button>
          </li>`;
        }).join('');

        const cheap = items.filter((c) => (c.changePct ?? 0) <= -10).length;
        const pricey = items.filter((c) => (c.changePct ?? 0) >= 20).length;
        countEl.textContent = items.length ? `共 ${items.length} 項 · ${cheap} 項划算 · ${pricey} 項偏貴` : '';
        emptyEl.hidden = items.length > 0;
        fillPicker();
      }

      document.getElementById('hk-q').addEventListener('input', fillPicker);
      sel.addEventListener('change', () => { if (sel.value) { window.hk.add(sel.value); sel.value = ''; } });
      listEl.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-del]');
        if (btn) window.hk.remove(btn.dataset.del);
      });
      document.getElementById('hk-reset').addEventListener('click', () => window.hk.write(defaults));
      document.addEventListener('hk:list', render);
      render();
    });
  </script>
</Base>
