---
import Base from '../../layouts/Base.astro';
import PriceLine from '../../components/PriceLine.astro';
import { meat, meatSlugs, meatIndex, roc, changeWord, dirClass, price, verdict } from '../../lib/pagedata.mjs';

export async function getStaticPaths() {
  return (await meatSlugs()).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const doc = await meat(slug);
const v = verdict(doc.changePct);

// 月價序列：毛豬有 17 年、雞蛋產地價只有 1 年（來源 114/09 才換算法），所以標題要講清楚年數
const years = doc.monthly.length ? Math.round(doc.monthly.length / 12 * 10) / 10 : 0;
const tabs = [
  doc.monthly.length > 1 && { id: 'trend', label: '長期走勢', heading: `${doc.item}這些年的價格怎麼走的？` },
  doc.daily.length > 1 && { id: 'recent', label: '近 90 天', heading: `${doc.item}最近 90 天的報價` },
].filter(Boolean);

// 這 16 頁原本只從 /crop/ 的肉蛋分頁連得到，彼此不相通。互連之後入鏈從 1 變成十幾個，
// 使用者也才能從雞蛋直接跳到鴨蛋，不必退回上一層。
const siblings = (await meatIndex()).items.filter((m) => m.slug !== slug);

// 毛豬走批發市場成交價、家禽與蛋走中央畜產會產地行情——來源與單位都不同，
// 引用時最容易把產地價當成零售價，所以答案句裡直接講明是哪一種價。
const isHog = doc.unit === '元/公斤';
const priceKind = isHog ? '批發市場成交價' : '產地行情價';

// 台中公有零售市場的實測：肉蛋原本只有產地價／批發價，那不是買菜的人付的價。
// 一個品項可能對到多個零售欄（毛豬 → 里肌／後腿／五花），主要那一欄拿來做攤位價判斷。
const cuts = doc.retail ?? [];
const mainCut = cuts.find((c) => !c.approx) ?? cuts[0] ?? null;
const answer = [
  `${doc.item}目前 ${price(doc.price)} ${doc.unit}（${priceKind}，${doc.xunLabel}，${doc.days} 個報價日）`,
  doc.changePct != null ? `，比近 ${doc.refYears} 年同一旬${changeWord(doc.changePct)}` : '',
  doc.refPrice != null ? `（常年約 ${price(doc.refPrice)} ${doc.unit}）` : '',
  `。${isHog ? '' : '產地價不是零售價，也不是批發價，中間還有運銷成本。'}`,
  mainCut
    ? `臺中市公有零售市場的${mainCut.column}實測 ${mainCut.perCatty} 元/台斤，常見 ${mainCut.p25}–${mainCut.p75}`
      + `${mainCut.ratio ? `，是${priceKind}的 ${mainCut.ratio} 倍` : ''}。`
    : '',
  `資料截至民國 ${roc(doc.lastDate)}。`,
].join('');

const faq = [
  doc.changePct != null && {
    q: `${doc.item}現在貴嗎？`,
    a: `${doc.item}比近 ${doc.refYears} 年同一旬${changeWord(doc.changePct)}。`
      + `目前 ${price(doc.price)} ${doc.unit}${doc.refPrice != null ? `，常年同期約 ${price(doc.refPrice)} ${doc.unit}` : ''}`
      + `（${priceKind}，民國 ${roc(doc.lastDate)}）。`,
  },
  {
    q: `${doc.item}的價格是哪一種價？`,
    a: isHog
      ? `這是農業部毛豬交易行情的批發市場成交價，單位元/公斤，依成交頭數加權，民國 98 年 11 月起。`
      : `這是中央畜產會的產地行情，單位元/台斤，2010 年 10 月起。產地價不是零售價，也不是批發價，`
        + `中間還有運銷成本。家禽是一天一個報價，沒有成交量可以加權。`,
  },
  mainCut && {
    q: `${doc.item.replace(/（.*/, '')}零售一斤多少錢？`,
    a: `臺中市公有零售市場的「${mainCut.column}」實測 ${mainCut.perCatty} 元/台斤（近 ${mainCut.days} 個訪價日、`
      + `${mainCut.markets} 個市場的中位數），常見範圍 ${mainCut.p25}–${mainCut.p75} 元/台斤，`
      + `喊價高過 ${mainCut.p75} 元就算偏貴。`
      + (mainCut.ratio ? `這是${priceKind} ${mainCut.basePerCatty} 元/台斤的 ${mainCut.ratio} 倍。` : '')
      + `這是臺中的實測價，不是全台平均；其他縣市沒有開放同型資料，本站不推估攤價。`,
  },
  doc.refYears < 3 && {
    q: `為什麼${doc.item}只比得到 ${doc.refYears} 年？`,
    a: `來源自民國 114 年 9 月起改採養雞協會日報表，算法換過，所以只拿得到 ${doc.refYears} 年的可比資料，不假裝有三年。`,
  },
].filter(Boolean);
---
<Base
  title={`${doc.item}價格現在貴嗎？${changeWord(doc.changePct)} — 好康`}
  {/* 雞蛋只比得到一年（來源 114/09 換算法），description 不能一律寫「近三年」 */}
  description={`${doc.item}目前 ${price(doc.price)} ${doc.unit}（${priceKind}），比近 ${doc.refYears} 年同一旬${changeWord(doc.changePct)}。`}
  lastDate={roc(doc.lastDate)}
  bare={true}
  crumbs={[{ name: '肉蛋', path: '/meat/' }, { name: doc.item, path: `/meat/${slug}/` }]}
  dataset={{
    name: `${doc.item}${priceKind}`,
    description: `${doc.item}的${priceKind}月均價與近 90 天報價，單位${doc.unit}。`,
    temporalStart: isHog ? '2009-11-01' : '2010-10-01',
    unit: doc.unit,
    creator: isHog
      ? { name: '農業部', url: 'https://www.moa.gov.tw/' }
      : { name: '中央畜產會', url: 'https://www.naif.org.tw/' },
    isBasedOn: isHog ? 'https://data.gov.tw/dataset/7296' : 'https://www.naif.org.tw/',
  }}
  faq={faq}
>
  <div class="shell screen">
    <div class="screen-hd">
      <a class="brand" href="/">好康 hó-khang</a>
      <nav>
        <a href="/cheap/">這週划算</a><a href="/crop/">找食材</a><a href="/market/">市場</a><a href="/about/">關於資料</a>
      </nav>
    </div>

    <div>
      <h1>{doc.item}<span class="muted"> {v.text}</span></h1>
      <p class="sub">
        <a href="/meat/">回到肉蛋行情</a> · {doc.group} · <a href="/crop/">找食材</a>
      </p>
      <p class="sr-only">{answer}</p>

      <div class="kpi-row" style="margin-top:0.75rem">
        <div class="kpi">
          <div class="k">跟近三年同期比</div>
          <div class={`v ${dirClass(doc.changePct)}`}>{changeWord(doc.changePct)}</div>
          <div class="d">{doc.refPrice != null ? `常年約 ${price(doc.refPrice)} ${doc.unit}` : '資料不足'}</div>
        </div>
        <div class="kpi">
          <div class="k">目前價格</div>
          <div class="v">{price(doc.price)}</div>
          <div class="d">{doc.unit} · {doc.xunLabel}，{doc.days} 個報價日</div>
        </div>
        <div class="kpi">
          <div class="k">比較基準</div>
          <div class="v">{doc.refYears} 年</div>
          {/* 雞蛋產地價在民國 114/09 換成養雞協會日報表，所以只比得到一年，不能假裝有三年 */}
          <div class="d">{doc.refYears < 3 ? '來源起算較晚，只比得到這些年' : '近三年同一旬平均'}</div>
        </div>
        {mainCut ? (
          <div class="kpi">
            <div class="k">台中零售實測</div>
            <div class="v">{mainCut.perCatty}</div>
            <div class="d">元/台斤 · 常見 {mainCut.p25}–{mainCut.p75}{mainCut.ratio ? ` · ${priceKind}的 ${mainCut.ratio} 倍` : ''}</div>
          </div>
        ) : (
          <div class="kpi">
            <div class="k">資料長度</div>
            <div class="v">{years}</div>
            <div class="d">年的月均價</div>
          </div>
        )}
      </div>

      {mainCut && (
        <div class="price-check" data-cuts={JSON.stringify(cuts.map((c) => ({ c: c.column, a: c.p25, b: c.p75, m: c.perCatty })))}>
          {/* 部位差很多（五花 170–195 vs 後腿 125–150），所以多個部位時讓使用者自己選，
              不要替他挑一個。只有一個部位時不顯示選單。 */}
          {cuts.length > 1 && (
            <>
              <label class="sr-only" for="pc-cut">部位</label>
              <select id="pc-cut">
                {cuts.map((c, i) => <option value={i}>{c.column}</option>)}
              </select>
            </>
          )}
          <label for="pc-in">攤子上喊多少？</label>
          <input id="pc-in" type="number" inputmode="decimal" min="0" step="1" placeholder="元/台斤" />
          <span class="unit">元/台斤</span>
          <output id="pc-out" aria-live="polite"></output>
          <span class="note muted" id="pc-note"></span>
        </div>
      )}
    </div>

    <div class="tabs">
      {tabs.map((t, i) => <input type="radio" name="meatitem" id={`mi-${t.id}`} checked={i === 0} />)}
      <div class="tab-bar">{tabs.map((t) => <label for={`mi-${t.id}`}>{t.label}</label>)}</div>
      <div class="panels">
        {tabs.map((t) => (
          <div class="panel">
            <h2 class="sr-only">{t.heading}</h2>
            {t.id === 'trend' && (
              <PriceLine
                series={[{ id: 'm', label: doc.item, role: 'main', points: doc.monthly }]}
                caption={`${doc.item} 月均價（${doc.unit}）`}
                unit={doc.unit.replace('元/', '')} tableLabel="年月" height={260}
              />
            )}
            {t.id === 'recent' && (
              <PriceLine
                series={[{ id: 'd', label: doc.item, role: 'main', points: doc.daily }]}
                caption={`${doc.item} 近 90 天每日報價——缺口是休市或當天沒有報價`}
                unit={doc.unit.replace('元/', '')} tableLabel="日期" height={260}
              />
            )}
          </div>
        ))}
      </div>
    </div>

    {siblings.length > 0 && (
      <nav class="siblings" aria-labelledby="sib-hd">
        <h2 id="sib-hd">其他肉蛋行情<span class="muted">（比常年便宜／貴幾 %）</span></h2>
        <ul>
          {siblings.map((m) => (
            <li>
              <a href={`/meat/${m.slug}/`}>
                {m.item}<span class={`tabular ${dirClass(m.changePct)}`}> {changeWord(m.changePct)}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="screen-ft">
      {doc.unit === '元/公斤' ? '農業部毛豬交易行情' : '中央畜產會家禽產地行情'}，
      更新至民國 {roc(doc.lastDate)} · <a href="/about/">資料說明</a>
    </div>
  </div>
  {mainCut && (
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const box = document.querySelector('.price-check');
        if (!box) return;
        const cuts = JSON.parse(box.dataset.cuts);
        const inp = box.querySelector('#pc-in');
        const out = box.querySelector('#pc-out');
        const note = box.querySelector('#pc-note');
        const sel = box.querySelector('#pc-cut');
        const cur = () => cuts[sel ? +sel.value : 0];
        const say = () => {
          const c = cur();
          note.textContent = `「${c.c}」在臺中公有零售市場的常見範圍是 ${c.a}–${c.b} 元/台斤（中位 ${c.m}）。`;
          const v = parseFloat(inp.value);
          if (!Number.isFinite(v) || v <= 0) { out.textContent = ''; out.className = ''; return; }
          if (v < c.a) {
            out.textContent = `比常見範圍還低 ${Math.round(((c.a - v) / c.a) * 100)}%，算便宜`;
            out.className = 'down';
          } else if (v > c.b) {
            out.textContent = `比常見範圍高 ${Math.round(((v - c.b) / c.b) * 100)}%，偏貴`;
            out.className = 'up';
          } else {
            out.textContent = v <= c.m ? '落在常見範圍內，偏便宜那半' : '落在常見範圍內，算正常';
            out.className = '';
          }
        };
        inp.addEventListener('input', say);
        if (sel) sel.addEventListener('change', say);
        say();
      });
    </script>
  )}
</Base>
