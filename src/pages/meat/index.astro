---
import Base from '../../layouts/Base.astro';
import { meatIndex, roc, changeWord, dirClass, price } from '../../lib/pagedata.mjs';

const idx = await meatIndex();
// 分組順序固定：買的人先想到蛋與雞，最後才是鵝鴨
const ORDER = ['蛋', '雞', '豬', '鵝鴨'];
const groups = ORDER.map((g) => ({ g, items: idx.items.filter((i) => i.group === g) })).filter((x) => x.items.length);
---
<Base
  title="肉蛋行情 — 好康 hó-khang"
  description={`雞蛋、雞肉、豬肉的產地與批發行情，跟近三年同一旬比。資料為${idx.xunLabel}。`}
  lastDate={roc(idx.lastDate)}
  bare={true}
>
  <div class="shell screen">
    <div class="screen-hd">
      <a class="brand" href="/">好康 hó-khang</a>
      <nav>
        <a href="/cheap/">完整榜單</a><a href="/crop/">品項</a><a href="/meat/">肉蛋</a><a href="/market/">市場</a><a href="/about/">關於資料</a>
      </nav>
    </div>

    <div>
      <h1>肉蛋行情</h1>
      <p class="sub">
        跟<strong>近三年同一旬</strong>比，口徑與蔬果頁一致。但來源不同：
        毛豬是<strong>批發市場成交價</strong>（元/公斤，依成交頭數加權），家禽與蛋是<strong>產地價</strong>（元/台斤），
        兩者都不是你在超市看到的價格。資料為 {idx.xunLabel}，更新至民國 {roc(idx.lastDate)}。
      </p>
    </div>

    <div class="tabs">
      {groups.map((g, i) => <input type="radio" name="meattab" id={`mt-${g.g}`} checked={i === 0} />)}
      <div class="tab-bar">
        {groups.map((g) => <label for={`mt-${g.g}`}>{g.g}（{g.items.length}）</label>)}
      </div>
      <div class="panels">
        {groups.map((g) => (
          <div class="panel">
            <ul class="rows" style="margin-top:0">
              {g.items.map((it) => (
                <li>
                  <a href={`/meat/${it.slug}/`}>
                    <span class="nm">{it.item}<span class="sub">
                      {price(it.price)} {it.unit}
                      {it.refPrice != null && ` · 常年約 ${price(it.refPrice)}`}
                      {it.refYears < 3 && ` · 只比得到 ${it.refYears} 年`}
                    </span></span>
                    <span class={`num ${dirClass(it.changePct)}`}>{changeWord(it.changePct)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="screen-ft">
      毛豬來自農業部畜禽交易行情；家禽與蛋為中央畜產會產地行情 ·
      <a href="/about/">資料說明</a>
    </div>
  </div>
</Base>
