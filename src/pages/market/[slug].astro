---
import SiteNav from '../../components/SiteNav.astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MethodLink from '../../components/MethodLink.astro';
import PriceLine from '../../components/PriceLine.astro';
import { marketSlugs, cropSlugs, market, marketNames, cropMarketSlugs, marketRest, MIX_TEXT, price, volume, roc, tcLabel, dirClass, changeWord, compareWord, levelClass, levelText, restDate, shortDate, xunText } from '../../lib/pagedata.mjs';

export async function getStaticPaths() {
  const slugs = await marketSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const doc = await market(slug);
// 名稱與座標一律讀對照表 overrides/market-names.json，不用行情站每天給的名稱（見 pagedata.mjs marketNames）
const nm = marketNames(doc.code, doc.tc_type, doc.name);
const gm = { fullName: nm.full, lat: nm.lat, lon: nm.lon };
// 有座標就導到座標，沒有就讓 Google Maps 用市場名稱搜尋（三個市場在 OSM 查無）
const navDest = gm.lat != null ? `${gm.lat},${gm.lon}` : (nm.nav ?? nm.full);
const tc = doc.tc_type;
// 畫面上的問句標題用「台東果菜市場」而不是只寫地名「台東」
const name = nm.title;
const rawName = doc.name ?? doc.code;
const daily = doc.daily.map((p) => ({ x: roc(p.d), y: p.volume == null ? null : +(p.volume / 1000).toFixed(1) }));
const totalVol = doc.daily.reduce((s, p) => s + (p.volume ?? 0), 0);
const latest = doc.daily.at(-1);
const cheap = doc.cheapest ?? [];
// 最近交易日的全品項行情表（emit-page 的 latestDay）。舊資料沒有這個欄位時整個表不出現。
const day = doc.latestDay?.items?.length ? doc.latestDay : null;
const cropExists = new Set(await cropSlugs());
const dayMd = day ? shortDate(day.date, doc.lastDate) : (latest ? shortDate(latest.d, doc.lastDate) : '');
// 同一個市場的蔬菜（N04）與水果（N05）是兩頁：標題分開寫「蔬菜行情」「水果行情」，頁首互連。
// 花卉（N06）是另一個地方，不互連。
const kindWord = tc === 'N06' ? '' : tcLabel(tc);
// 蔬菜／水果兩頁互搶同一個查詢字時，指定一頁當主頁（2026-10-02，台東：GSC「台東果菜市場行情」
// n04／n05 互搶，排名 8.6／9.8）。primary 保留「{市場}行情」字串（水果標在括號裡），
// secondary 改以「{地名}{蔬菜|水果}批發行情」為主詞，內文與副標仍寫完整市場名。代號是設計常數。
const SPLIT = { '930': { primary: 'N05' } };
const split = SPLIT[doc.code] && (tc === 'N04' || tc === 'N05') ? SPLIT[doc.code] : null;
const isPrimary = split?.primary === tc;
const isSecondary = split && !isPrimary;
const heading = isPrimary ? `${nm.title}行情（${kindWord}）`
  : isSecondary ? `${nm.short}${kindWord}批發行情`
  : `${nm.title}${kindWord}行情`;
// 表格標題：primary 把括號移到尾端，不要「行情（水果）表」
const boardHeading = isPrimary ? `${nm.title}行情表（${kindWord}）` : `${heading}表`;
const titleTail = isSecondary ? `${nm.title}${kindWord}批發價格表` : isPrimary ? `${kindWord}批發價格表` : '批發價格表';
// 標題顯示的日期：最近一次交易距資料截止日超過 7 天就不放（過期日期會讓人以為今天沒更新或已停擺）。
// 7 天是設計常數：蔬果市場一週內一定開市，連續一週沒交易的頁不拿舊日期當賣點。
const STALE_DAYS = 7;
const gapDays = latest ? Math.round((Date.parse(doc.lastDate) - Date.parse(latest.d)) / 86400000) : 0;
const titleDate = gapDays > STALE_DAYS ? '' : dayMd;
const pairTc = tc === 'N04' ? 'N05' : tc === 'N05' ? 'N04' : null;
const pairSlug = pairTc ? `${pairTc.toLowerCase()}-${doc.code}` : null;
const pair = pairSlug && (await marketSlugs()).includes(pairSlug)
  ? { href: `/market/${pairSlug}/`, text: isPrimary ? `${nm.short}${tcLabel(pairTc)}批發行情` : isSecondary ? `${nm.title}行情（${tcLabel(pairTc)}）` : `${nm.title}${tcLabel(pairTc)}行情` } : null;
const pricey = doc.priciest ?? [];
// 最近交易日對前一個交易日的漲跌（emit-page 的 dodPct，一位小數）。前一交易日沒成交就是「—」。
const dodText = (v) => (v == null ? '—' : v === 0 ? '持平' : `${v > 0 ? '漲' : '跌'} ${Math.abs(v).toFixed(1)}%`);
const dodClass = (v) => (v == null || v === 0 ? '' : v > 0 ? 'up' : 'down');
const prevMd = day?.prevDate ? shortDate(day.prevDate, doc.lastDate) : '';

// 西螺：GSC「西螺果菜市場交易行情查詢」排 8.6、0 點擊，標題與表頭補上查詢字「交易行情」（2026-10-02）。
const TRADE_WORD = new Set(['648']);
const tradeHeading = TRADE_WORD.has(doc.code) && tc !== 'N06' ? `${nm.title}${kindWord}交易行情` : null;
const mainHeading = tradeHeading ?? heading;
const mainBoardHeading = tradeHeading ? `${tradeHeading}表` : boardHeading;
const pageTitleTail = tradeHeading ? `${kindWord}批發價格表` : titleTail;
const mktWord = tc === 'N06' ? '花卉市場' : '果菜市場';
// 下面兩句同時用在畫面（副標、頁尾）與 Dataset description，同一個字串，不各寫一份
const kindLabel = `${tcLabel(tc)}批發市場`;
const sourceLine = `農糧署批發行情，更新至民國 ${roc(doc.lastDate)}`;
// 休市：這是全站唯一「講未來」的資料——官方已經公告到年底，出貨的人要看這個。
// 買菜的人會以為「休市後菜價會漲」，實測 15 年、1 萬多個樣本不是這樣，所以連同
// 量價變化一起講清楚（數字在 transform/market-rest.mjs 算）。
const mr = await marketRest();
const restUpcoming = mr?.upcoming?.[doc.code]?.dates?.filter((d) => d.tcTypes.includes(tc)) ?? [];
const restEffect = mr?.effect ?? null;
const restOne = restEffect?.byRunLen?.find((b) => b.runLen === '1') ?? null;
// 星期節奏：哪天到貨最多。高低差不到三成就不講（那是雜訊不是節奏），
// 常態不開秤的星期（多數市場的週一）不參與比較但要說明
const rhythm = mr?.rhythm?.[doc.code]?.[tc] ?? null;
const restTwo = restEffect?.byRunLen?.find((b) => b.runLen === '2') ?? null;

const tabs = [
  day && { id: 'day', label: `${dayMd} 全部品項`, heading: `${heading}：民國 ${roc(day.date)} 各品項批發價` },
  cheap.length > 0 && { id: 'cheap', label: '這旬比常年便宜', heading: `${name}這一旬什麼比常年便宜？` },
  pricey.length > 0 && { id: 'pricey', label: '這旬比常年貴', heading: `${name}這一旬什麼比常年貴？` },
  daily.length > 1 && { id: 'vol', label: '到貨量', heading: `${name}每天到多少貨？` },
  restUpcoming.length > 0 && { id: 'rest', label: '休市日', heading: `${nm.title}接下來哪幾天休市？` },
].filter(Boolean);

// 這個市場交易量最大的品項，連到「該品項 × 這個市場」的頁。
// 那 3,049 頁原本只從品項總覽頁連得到，從市場這一側完全沒有路；補上之後它們多一個
// 來源不同的入鏈，使用者也才有「這個市場主力賣什麼」的入口。
const cmExists = new Set(await cropMarketSlugs());
const topCrops = (doc.topCrops ?? [])
  .map((c) => ({ ...c, cropSlug: `${c.tcType.toLowerCase()}-${c.plv3Key}` }))
  .filter((c) => cmExists.has(`${c.cropSlug}-${doc.code}`));



// 摘要先給行情搜尋者要的東西（最近交易日、到貨、當旬最便宜／最貴），
// 全部取頁面既有欄位，不新算數字。
const top = day?.items.find((x) => x.price != null) ?? null;
const descParts = [
  latest ? `${mainHeading} ${dayMd}${gapDays > STALE_DAYS ? ' 最近一次交易' : ''}（民國 ${roc(latest.d)}）：到貨 ${volume(latest.volume)}、${latest.crops ?? '—'} 個品項` : `${heading}：目前沒有交易資料。`,
  latest && top ? `，量最大的${top.name}均價每公斤 ${price(top.price)} 元。` : latest ? '。' : '',
  cheap.length ? `${doc.xun ?? '最近一旬'}最便宜的是${cheap[0].name}（${compareWord('常年', cheap[0].changePct)}）` : '',
  cheap.length && pricey.length ? `，最貴的是${pricey[0].name}（${compareWord('常年', pricey[0].changePct)}）。`
    : pricey.length ? `${doc.xun ?? '最近一旬'}最貴的是${pricey[0].name}（${compareWord('常年', pricey[0].changePct)}）。` : '',
];

const answer = [
  `${gm.fullName ?? name}（${tcLabel(tc)}批發市場，行情站代號 ${doc.code}）`,
  latest ? `最近交易日民國 ${roc(latest.d)}，當日到貨 ${volume(latest.volume)}、${latest.crops ?? '—'} 個品項` : '最近沒有交易資料',
  `。近 90 天有 ${doc.quality.days90} 個交易日、共 ${(totalVol / 1000).toFixed(0)} 公噸。`,
  cheap.length ? `${doc.xun ?? '最近一旬'}最便宜的是${cheap[0].name}（${compareWord('常年', cheap[0].changePct)}）` : '',
  pricey.length ? `，最貴的是${pricey[0].name}（${compareWord('常年', pricey[0].changePct)}）` : '',
  cheap.length || pricey.length ? '。' : '',
  // 出貨的人問「這裡收不收我的貨」，買菜的人問「這個市場賣什麼」，答案是同一個數字
  doc.mix ? `近 90 天有 ${doc.mix.crops} 個品項成交，前五大佔 ${doc.mix.top5Pct}%，`
    + `累積到八成需要 ${doc.mix.cropsFor80} 個品項，屬於${MIX_TEXT[doc.mix.kind]}市場。` : '',
].join('');
// 第一屏（2026-10-04）：查「XX果菜市場行情／交易行情」的人要的三件事先講——最近交易日到多少貨、
// 主力品項多少錢、跟常年同期比。數字全部來自 emit-page（volumeVsUsual、latestDay 的 xunPct），頁面不另算。
// h2 帶「交易行情」：GSC 西螺、溪湖等頁的「交易行情查詢」變體已有曝光（seo-ops serp-intent 2026-10-02）。
// title／meta 不動（10/23 前在標題觀察窗內）。
const leadHeading = isPrimary ? `${nm.title}交易行情（${kindWord}）`
  : isSecondary ? `${nm.short}${kindWord}交易行情`
  : `${nm.title}${kindWord}交易行情`;
const vu = doc.volumeVsUsual ?? null;
const xunShort = xunText(doc.xun);
// 到貨量多或少沒有好壞，用「多／少」，不上漲跌色
const volWord = (p) => (p == null ? '—' : Math.abs(p).toFixed(0) === '0' ? '跟常年差不多' : `${p > 0 ? '多' : '少'} ${Math.abs(p).toFixed(0)}%`);
const leadItems = (day?.items ?? []).filter((x) => x.price > 0).slice(0, 5);
// 同一份資料交給 <Base crumbs>（BreadcrumbList）與畫面上的 <Breadcrumbs>
const crumbs = [{ name: '市場', path: '/market/' }, { name: gm.fullName ?? name, path: `/market/${slug}/` }];
---
<Base
  {/* 標題用搜尋者的詞。GSC 實測（2026-09-25 抓近 28 天）：市場頁吃掉全站 40% 曝光、
      排名 8–11 但點擊 0，而帶「行情／批發價／拍賣」的查詢是最大的一簇
      （台東果菜市場行情、溪湖果菜市場行情表、花蓮果菜市場批發價…）。
      2026-10-02（站主核可，提前結束 9/25 起的觀察窗）：地名去掉市／鎮（overrides/market-names.json），
      蔬菜／水果兩頁分開寫「蔬菜行情」「水果行情」，帶最近交易日。日期取自資料，不看時鐘。 */}
  title={titleDate ? `${mainHeading} ${titleDate}｜${pageTitleTail} — 好康` : `${mainHeading}｜${pageTitleTail} — 好康`}
  description={descParts.join('')}
  noindex={!doc.quality.indexable}
  lastDate={roc(doc.lastDate)}
  bare={true}
  crumbs={crumbs}
  dataset={{
    name: `${gm.fullName ?? name}${tcLabel(tc)}批發行情`,
    description: `${gm.fullName ?? name}（${kindLabel}，代號 ${doc.code}）的每日到貨量，以及當旬最便宜與最貴的品項。`
      + `資料來源：${sourceLine}。`,
    temporalStart: '2012-01-01',
    spatial: { '@type': 'Place', name: `${gm.fullName ?? name}批發市場` },
    unit: '元/公斤',
  }}
>
  <div class="shell screen">
    <div class="screen-hd">
      <a class="brand" href="/">好康 hó-khang</a>
      <SiteNav />
    </div>

    <div>
      <Breadcrumbs crumbs={crumbs} />
      <h1>{heading}<a class="nav-btn" style="margin-left:0.75rem;vertical-align:middle" target="_blank" rel="noopener"
        href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(navDest)}`}>📍 導航</a></h1>
      <p class="sub">
        {nm.full} · {kindLabel} · 行情站寫「{rawName}」· 代號 {doc.code}
        {doc.changeCount > 0 && <> · {doc.xun} 有 {doc.changeCount} 個品項可跟常年比較</>}
        {!doc.quality.indexable && <span class="muted"> · 交易資料偏少</span>}
      </p>
      {pair && <p class="sub"><a class="nav-btn" href={pair.href}>{isPrimary ? `${tcLabel(pairTc)}行情看這裡：${pair.text}` : `看${pair.text}`} →</a></p>}
      <p class="sr-only">{answer}</p>

      <section class="lead" aria-labelledby="lead-hd">
        <h2 id="lead-hd">{leadHeading}{dayMd ? ` ${dayMd}` : ''}</h2>
        <div class="kpi-row">
          <div class="kpi">
            <div class="k">{gapDays > STALE_DAYS ? '最近一次交易' : '最近交易日'} {dayMd} 到貨</div>
            <div class="v">{latest ? volume(latest.volume) : '—'}</div>
            <div class="d">{latest ? `民國 ${roc(latest.d)} · ${latest.crops ?? '—'} 個品項` : '最近沒有交易'}</div>
          </div>
          {vu && (
            <div class="kpi">
              <div class="k">到貨跟常年同期比</div>
              <div class="v">{volWord(vu.changePct)}</div>
              <div class="d">{xunShort}每個交易日平均 {volume(vu.perDay)}，常年 {volume(vu.baselinePerDay)}</div>
            </div>
          )}
          <div class="kpi">
            <div class="k">近 90 天</div>
            <div class="v">{doc.quality.days90}</div>
            <div class="d">個交易日 · 共 {(totalVol / 1000).toFixed(0)} 公噸</div>
          </div>
        </div>
        {leadItems.length > 0 && (
          <table class="tbl lead-tbl" aria-labelledby="lead-hd">
            <thead>
              <tr>
                <th scope="col">主力品項</th>
                <th scope="col" class="num">{dayMd} 均價 元/公斤</th>
                <th scope="col" class="num">{xunShort}跟常年同期比</th>
              </tr>
            </thead>
            <tbody>
              {leadItems.map((x) => (
                <tr>
                  <th scope="row">{cropExists.has(x.slug) ? <a class="rl" href={`/crop/${x.slug}/`}>{x.name}</a> : x.name}</th>
                  <td class="num tabular">{price(x.price)}</td>
                  <td class={`num tabular ${dirClass(x.xunPct)}`}>{changeWord(x.xunPct)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </section>
    </div>

    {tabs.length > 0 ? (
      <section class="board" aria-labelledby="board-hd">
      {/* 搜尋者的詞是「XX果菜市場行情表／批發價」（GSC 2026-09-28 近 28 天，市場頁排名 9 上下、0 點擊）。
          第一個分頁是最近交易日的全品項表（上價／均價／下價／交易量）；
          「這旬比常年便宜／貴」兩頁是旬均價，分頁名與欄名照實寫，不叫「今日」。 */}
      <div class="board-hd">
        <h2 id="board-hd">{mainBoardHeading}{day ? ` ${dayMd}` : ''}</h2>
        <p class="sub">{day ? `民國 ${roc(day.date)} 批發價 · ${day.items.length} 個品項` : `${doc.xun ?? '最近一旬'} 批發均價`} · 元/公斤 · 更新至民國 {roc(doc.lastDate)} <MethodLink to="market" /></p>
      </div>
      <div class="tabs">
        {tabs.map((t, i) => <input type="radio" name="mkttab" id={`mt-${t.id}`} checked={i === 0} />)}
        <div class="tab-bar">{tabs.map((t) => <label for={`mt-${t.id}`}>{t.label}</label>)}</div>
        <div class="panels">
          {tabs.map((t) => (
            <div class="panel">
              <h2 class="sr-only" id={`mt-${t.id}-hd`}>{t.heading}</h2>
              {t.id === 'day' && (
                <table class="tbl" aria-labelledby={`mt-${t.id}-hd`}>
                  <thead>
                    <tr>
                      <th scope="col">品項</th>
                      <th scope="col" class="num hide-sm">上價</th>
                      <th scope="col" class="num">平均價 元/公斤</th>
                      <th scope="col" class="num hide-sm">下價</th>
                      {prevMd && <th scope="col" class="num">與前一交易日（{prevMd}）漲跌</th>}
                      <th scope="col" class="num hide-sm">交易量 公斤</th>
                    </tr>
                  </thead>
                  <tbody>
                    {day.items.map((x) => (
                      <tr>
                        <th scope="row">
                          {cropExists.has(x.slug) ? <a class="rl" href={`/crop/${x.slug}/`}>{x.name}</a> : x.name}
                          <span class="sub only-sm"><span class="g">上價 {price(x.max)} · 下價 {price(x.min)}</span> <span class="g">· {volume(x.volume)}</span></span>
                        </th>
                        <td class="num tabular hide-sm">{price(x.max)}</td>
                        <td class="num tabular">{price(x.price)}</td>
                        <td class="num tabular hide-sm">{price(x.min)}</td>
                        {prevMd && <td class={`num tabular ${dodClass(x.dodPct)}`}>{dodText(x.dodPct)}</td>}
                        <td class="num tabular hide-sm">{Number(x.volume).toLocaleString('zh-TW', { maximumFractionDigits: 0 })}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
              {(t.id === 'cheap' || t.id === 'pricey') && (
                <table class="tbl" aria-labelledby={`mt-${t.id}-hd`}>
                  <thead>
                    <tr>
                      <th scope="col">品項</th>
                      <th scope="col" class="num hide-sm">{doc.xun ?? '本旬'}均價</th>
                      <th scope="col" class="num hide-sm">常年同旬 元/公斤</th>
                      <th scope="col" class="num">跟常年同旬比</th>
                    </tr>
                  </thead>
                  <tbody>
                    {(t.id === 'cheap' ? cheap : pricey).map((x) => (
                      <tr>
                        <th scope="row">
                          <a class="rl" href={`/crop/${x.slug}/`}>{x.name}</a>
                          {t.id === 'cheap' && x.seasonal && <span class="season-tag"> · 當季</span>}
                          <span class="sub only-sm"><span class="g">旬均 {price(x.price)}</span> <span class="g">· 常年同旬 {price(x.baseline3y)} <span class="u">元/公斤</span></span></span>
                        </th>
                        <td class="num tabular hide-sm">{price(x.price)}</td>
                        <td class="num tabular hide-sm">{price(x.baseline3y)}</td>
                        <td class={`num tabular ${dirClass(x.changePct)}`}>
                          <i class={levelClass(x.changePct)} title={levelText(x.changePct)} aria-hidden="true"></i>
                          {changeWord(x.changePct)}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
              {t.id === 'vol' && (
                <>
                  <PriceLine
                    series={[{ id: 'v', label: '到貨量', role: 'main', points: daily }]}
                    caption={`${name} 每日到貨量`}
                    unit="公噸" tableLabel="日期" height={240}
                  />
                  {rhythm?.meaningful && (
                    <p class="note">
                      近一年<strong>{rhythm.peak}</strong>到貨最多、<strong>{rhythm.low}</strong>最少，
                      差 <strong>{rhythm.spreadPct}%</strong>。
                      {rhythm.rareDays?.length > 0 && <>{rhythm.rareDays.join('、')}常態不開秤。</>}
                      要挑貨多的那天就避開{rhythm.low}；要出貨避開大盤日則相反。
                      <MethodLink to="market" />
                    </p>
                  )}
                </>
              )}
              {t.id === 'rest' && (
                <>
                  <ul class="rest-days">
                    {restUpcoming.map((d) => <li>{restDate(d.date)}</li>)}
                  </ul>
                  {restOne && restTwo && (
                    <p class="note">
                      休市隔天不必搶：復市第一天的到貨量比平常多
                      （連休 1 天 {restOne.volumePct > 0 ? '+' : ''}{restOne.volumePct}%、
                      連休 2 天 {restTwo.volumePct > 0 ? '+' : ''}{restTwo.volumePct}%），
                      但均價幾乎不動（{restOne.pricePct > 0 ? '+' : ''}{restOne.pricePct}%、
                      {restTwo.pricePct > 0 ? '+' : ''}{restTwo.pricePct}%）。
                      也就是休市過後貨反而多、好挑。
                      <MethodLink to="market" />
                    </p>
                  )}
                </>
              )}
            </div>
          ))}
        </div>
      </div>
      </section>
    ) : (
      <p class="note">這個市場在 {doc.xun ?? '最近一旬'} 沒有足夠品項可跟常年比較。</p>
    )}

    {topCrops.length > 0 && (
      <nav class="siblings" aria-labelledby="top-hd">
        <h2 id="top-hd">{name}的主力品項<span class="muted">（近 90 天交易量最大，點進去看該品項在這個市場的行情）</span></h2>
        {doc.mix && (
          <p class="note">
            近 90 天有 <strong>{doc.mix.crops}</strong> 個品項成交，前五大就佔 <strong>{doc.mix.top5Pct}%</strong>；
            累積到八成需要 {doc.mix.cropsFor80} 個品項，屬於<strong>{MIX_TEXT[doc.mix.kind]}</strong>市場。
            <MethodLink to="market" />
          </p>
        )}
        <ul>
          {topCrops.map((c) => (
            <li><a href={`/crop/${c.cropSlug}/${doc.code}/`}>{c.name}</a></li>
          ))}
        </ul>
      </nav>
    )}

    <div class="screen-ft">
      {sourceLine} · <a href="/about/">資料說明</a>
    </div>
  </div>
</Base>

