---
// 市場總覽：同一個市場的蔬菜與水果合在一頁，承接「台東果菜市場行情」「台東批發市場」這種
// 不分類的查詢。為什麼要有這一頁、哪些市場才有，見 src/lib/pagedata.mjs 的 marketHubs()。
// 這一頁不新算任何數字：全部取自兩個子頁已經顯示的欄位（當旬最便宜、到貨量、休市日、主力品項）。
import Base from '../../layouts/Base.astro';
import { marketHubs, market, marketGeo, marketRest, cropMarketSlugs, popularCrops, MIX_TEXT, price, volume, roc, tcLabel, dirClass, changeWord, restDate } from '../../lib/pagedata.mjs';

export async function getStaticPaths() {
  const hubs = await marketHubs();
  return hubs.map((h) => ({ params: { code: h.code } }));
}

const { code } = Astro.params;
const hub = (await marketHubs()).find((h) => h.code === code);
const gm = (await marketGeo())[code] ?? {};
const navDest = gm.lat != null ? `${gm.lat},${gm.lon}` : hub.fullName;

// 子頁：蔬菜、水果（花卉若同代號也有頁，一併連出去，但不併進總覽的數字）
const kids = await Promise.all(hub.children.map(async (m) => ({ ...m, doc: await market(m.slug) })));
const food = kids.filter((k) => k.tcType !== 'N06');
const flower = kids.find((k) => k.tcType === 'N06') ?? null;
const veg = food.find((k) => k.tcType === 'N04');
const fruit = food.find((k) => k.tcType === 'N05');

const lastDate = food.map((k) => k.doc.lastDate).sort().at(-1);
const latestOf = (k) => k.doc.daily.at(-1) ?? null;

// 休市日：兩類合併，標出是哪一類休（同一個市場兩類的休市日不一定相同）
const mr = await marketRest();
const restMap = new Map();
for (const d of mr?.upcoming?.[code]?.dates ?? []) {
  const tcs = d.tcTypes.filter((t) => t === 'N04' || t === 'N05');
  if (tcs.length) restMap.set(d.date, tcs);
}
const rests = [...restMap].sort(([a], [b]) => a.localeCompare(b)).map(([date, tcs]) => ({
  date, label: tcs.length === 2 ? '蔬菜水果都休' : `${tcLabel(tcs[0])}休`,
}));
const nextRest = rests[0] ?? null;

const cheapOf = (k) => (k?.doc.cheapest ?? []).slice(0, 8);
const vegCheap = cheapOf(veg);
const fruitCheap = cheapOf(fruit);

// 主力品項 → 該品項在這個市場的頁
const cmExists = new Set(await cropMarketSlugs());
const topOf = (k) => (k.doc.topCrops ?? [])
  .map((c) => ({ ...c, cropSlug: `${c.tcType.toLowerCase()}-${c.plv3Key}` }))
  .filter((c) => cmExists.has(`${c.cropSlug}-${code}`))
  .slice(0, 8);
const tops = food.flatMap((k) => topOf(k).map((c) => ({ ...c, tc: k.tcType })));

const popular = await popularCrops(12);

const sn = hub.searchName;
const xun = veg?.doc.xun ?? fruit?.doc.xun ?? '最近一旬';
const tabs = [
  vegCheap.length > 0 && { id: 'veg', label: '蔬菜最便宜', heading: `${sn}現在什麼蔬菜最便宜？` },
  fruitCheap.length > 0 && { id: 'fruit', label: '水果最便宜', heading: `${sn}現在什麼水果最便宜？` },
  rests.length > 0 && { id: 'rest', label: '休市日', heading: `${sn}接下來哪幾天休市？` },
].filter(Boolean);

// 兩類的最近交易日不一定同一天（台東的蔬菜可能停了幾天、水果照常），日期跟著類別走
const volLine = food.map((k) => {
  const l = latestOf(k);
  return l ? `${tcLabel(k.tcType)}民國 ${roc(l.d)} 到貨 ${volume(l.volume)}` : null;
}).filter(Boolean).join('、');
const lastTrade = food.map((k) => latestOf(k)?.d).filter(Boolean).sort().at(-1) ?? null;

const answer = [
  `${hub.fullName}（行情站代號 ${code}，寫作「${hub.name}」）有蔬菜與水果兩類拍賣。`,
  volLine ? `最近交易：${volLine}。` : '',
  vegCheap.length ? `${xun}蔬菜最便宜的是${vegCheap[0].name}（比常年${changeWord(vegCheap[0].changePct)}）` : '',
  vegCheap.length && fruitCheap.length ? '，' : '',
  fruitCheap.length ? `水果最便宜的是${fruitCheap[0].name}（比常年${changeWord(fruitCheap[0].changePct)}）` : '',
  vegCheap.length || fruitCheap.length ? '。' : '',
  nextRest ? `下一個休市日是 ${restDate(nextRest.date)}，${nextRest.label}。` : '',
].join('');

const description = [
  `${sn}今日行情：${volLine ? `${volLine}。` : '最近沒有交易資料。'}`,
  vegCheap.length ? `蔬菜最便宜${vegCheap[0].name}（${changeWord(vegCheap[0].changePct)}）` : '',
  vegCheap.length && fruitCheap.length ? '、' : '',
  fruitCheap.length ? `水果最便宜${fruitCheap[0].name}（${changeWord(fruitCheap[0].changePct)}）` : '',
  vegCheap.length || fruitCheap.length ? '。' : '',
  nextRest ? `下次休市 ${restDate(nextRest.date)}。` : '',
].join('');

const faq = [
  nextRest && {
    q: `${sn}什麼時候休市？`,
    a: `接下來的休市日：${rests.slice(0, 4).map((r) => `${restDate(r.date)}${r.label}`).join('、')}。休市日由農糧署公告。`,
  },
  vegCheap.length > 0 && {
    q: `${sn}現在什麼蔬菜最便宜？`,
    a: `${xun}比常年同旬便宜最多的蔬菜：${vegCheap.slice(0, 3).map((x) => `${x.name} ${price(x.price)} 元/公斤（${changeWord(x.changePct)}）`).join('、')}。`,
  },
  fruitCheap.length > 0 && {
    q: `${sn}現在什麼水果最便宜？`,
    a: `${fruit.doc.xun ?? xun}比常年同旬便宜最多的水果：${fruitCheap.slice(0, 3).map((x) => `${x.name} ${price(x.price)} 元/公斤（${changeWord(x.changePct)}）`).join('、')}。`,
  },
].filter(Boolean);
---
<Base
  title={`${sn}行情｜今日蔬菜水果批發價與休市日 — 好康`}
  description={description}
  noindex={false}
  lastDate={roc(lastDate)}
  bare={true}
  crumbs={[{ name: '市場', path: '/market/' }, { name: hub.fullName, path: hub.path }]}
  dataset={{
    name: `${hub.fullName}蔬菜水果批發行情`,
    description: `${hub.fullName}的蔬菜與水果每日到貨量、當旬最便宜的品項與休市日。資料來自農業部農糧署行情報導站。`,
    temporalStart: '2012-01-01',
    spatial: { '@type': 'Place', name: hub.fullName },
    unit: '元/公斤',
  }}
  faq={faq}
>
  <div class="shell screen">
    <div class="screen-hd">
      <a class="brand" href="/">好康 hó-khang</a>
      <nav>
        <a href="/cheap/">這週划算</a><a href="/crop/">找食材</a><a href="/market/">市場</a><a href="/about/">關於資料</a>
      </nav>
    </div>

    <div>
      <h1>{sn}行情<a class="nav-btn" style="margin-left:0.75rem;vertical-align:middle" target="_blank" rel="noopener"
        href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(navDest)}`}>📍 導航</a></h1>
      <p class="sub">
        {hub.fullName} · 行情站寫「{hub.name}」· 代號 {code} ·{' '}
        {food.map((k, i) => <>{i > 0 && ' · '}<a href={`/market/${k.slug}/`}>{tcLabel(k.tcType)}完整行情</a></>)}
        {flower && <> · <a href={`/market/${flower.slug}/`}>花卉行情</a></>}
      </p>
      <p class="sr-only">{answer}</p>

      <div class="kpi-row" style="margin-top:0.75rem">
        <div class="kpi">
          <div class="k">最近交易日</div>
          <div class="v">{roc(lastTrade)}</div>
          <div class="d">{nextRest ? `下次休市 ${restDate(nextRest.date)}` : '近期沒有公告休市'}</div>
        </div>
        {food.map((k) => {
          const l = latestOf(k);
          return (
            <div class="kpi">
              <div class="k">{tcLabel(k.tcType)}到貨{l ? `（${roc(l.d).slice(4)}）` : ''}</div>
              <div class="v">{volume(l?.volume)}</div>
              <div class="d">{l?.crops ?? '—'} 個品項 · 近 90 天交易 {k.doc.quality.days90} 天{k.doc.mix ? ` · ${MIX_TEXT[k.doc.mix.kind]}` : ''}</div>
            </div>
          );
        })}
      </div>
    </div>

    {tabs.length > 0 && (
      <div class="tabs">
        {tabs.map((t, i) => <input type="radio" name="hubtab" id={`hb-${t.id}`} checked={i === 0} />)}
        <div class="tab-bar">{tabs.map((t) => <label for={`hb-${t.id}`}>{t.label}</label>)}</div>
        <div class="panels">
          {tabs.map((t) => (
            <div class="panel">
              <h2 class="sr-only">{t.heading}</h2>
              {(t.id === 'veg' || t.id === 'fruit') && (
                <>
                  <ul class="rows">
                    {(t.id === 'veg' ? vegCheap : fruitCheap).map((x) => (
                      <li>
                        <a href={cmExists.has(`${x.slug}-${code}`) ? `/crop/${x.slug}/${code}/` : `/crop/${x.slug}/`}>
                          <span class="nm">{x.name}{x.seasonal && <span class="season-tag"> · 當季</span>}
                            <span class="sub">常年同旬 {price(x.baseline3y)} 元/公斤</span></span>
                          <span class="num tabular">{price(x.price)}</span>
                          <span class={`num tabular ${dirClass(x.changePct)}`}>{changeWord(x.changePct)}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <p class="note">
                    <a href={`/market/${(t.id === 'veg' ? veg : fruit).slug}/`}>
                      {sn}{t.id === 'veg' ? '蔬菜' : '水果'}完整行情（含最貴的品項與每日到貨量）
                    </a>
                  </p>
                </>
              )}
              {t.id === 'rest' && (
                <>
                  <ul class="rest-days">
                    {rests.map((r) => <li>{restDate(r.date)} <span class="muted">{r.label}</span></li>)}
                  </ul>
                  <p class="note muted">休市日由農糧署公告，包含未來的日期；同一個市場蔬菜與水果的休市日不一定相同。</p>
                </>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    {tops.length > 0 && (
      <nav class="siblings" aria-labelledby="top-hd">
        <h2 id="top-hd">{sn}的主力品項<span class="muted">（近 90 天交易量最大，點進去看在這個市場的價格）</span></h2>
        <ul>
          {tops.map((c) => <li><a href={`/crop/${c.cropSlug}/${code}/`}>{c.name}</a></li>)}
        </ul>
      </nav>
    )}

    {popular.length > 0 && (
      <nav class="siblings" aria-labelledby="pop-hd">
        <h2 id="pop-hd">全國常查品項價格</h2>
        <ul>
          {popular.map((c) => <li><a href={`/crop/${c.slug}/`}>{c.name}價格</a></li>)}
        </ul>
      </nav>
    )}

    <div class="screen-ft">
      農糧署批發行情，更新至民國 {roc(lastDate)} · <a href="/market/">全部批發市場</a> · <a href="/about/">資料說明</a>
    </div>
  </div>
</Base>
