---
import SiteNav from '../../components/SiteNav.astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { siteIndex, marketNames, marketRest, MIX_TEXT, roc, TC_LABEL, restDate } from '../../lib/pagedata.mjs';

const idx = await siteIndex();
// 名稱與座標讀對照表 overrides/market-names.json（見 pagedata.mjs marketNames）
const gOf = (m) => { const n = marketNames(m.code, m.tcType, m.name); return { ...n, fullName: n.full }; };

// 「果菜市場休市」是使用者真的會查的事，而且休市日是官方預先公告的未來事實。
// 每個市場列出下一個休市日，細節（接下來八次、量價變化）在各市場自己的頁上。
const mr = await marketRest();
const nextRest = (code, tc) => mr?.upcoming?.[code]?.dates?.find((d) => d.tcTypes.includes(tc))?.date ?? null;
const restOne = mr?.effect?.byRunLen?.find((b) => b.runLen === '1') ?? null;
const restTwo = mr?.effect?.byRunLen?.find((b) => b.runLen === '2') ?? null;
const groups = ['N04', 'N05', 'N06'].map((tc) => ({
  tc, label: TC_LABEL[tc],
  items: idx.markets.filter((m) => m.tcType === tc).sort((a, b) => b.days90 - a.days90),
})).filter((g) => g.items.length);
// 同一份資料交給 <Base crumbs>（BreadcrumbList）與畫面上的 <Breadcrumbs>
const crumbs = [{ name: '市場', path: '/market/' }];
---
<Base
  title="全台果菜批發市場行情與休市日 — 好康 hó-khang"
  description="農糧署輔導的行情報導站清單，分蔬菜、水果、花卉：各市場到多少貨、當旬什麼比常年便宜，以及接下來哪幾天休市。"
  lastDate={roc(idx.lastDate)}
  bare={true}
  crumbs={crumbs}
  itemList={groups.flatMap((g) => g.items.filter((m) => m.indexable).map((m) => ({
    name: gOf(m).fullName, path: `/market/${m.slug}/`,
  })))}
>
  <div class="shell screen">
    <div class="screen-hd">
      <a class="brand" href="/">好康 hó-khang</a>
      <SiteNav />
    </div>

    <div>
      <Breadcrumbs crumbs={crumbs} />
      {/* 標題不顯示在畫面上：導覽列已經說明你在哪一頁，內容直接開始。
          h1 仍留在 DOM（sr-only）給搜尋引擎與螢幕閱讀器。 */}
      <h1 class="sr-only">批發市場</h1>
      {/* 定位只在瀏覽器端算距離，座標不會送到任何地方（靜態站也沒有後端可送） */}
      <div class="list-tools" style="margin-top:0.75rem">
        <button type="button" id="near-me">📍 依距離排序</button>
        <span class="count" id="near-msg"></span>
      </div>
      {restOne && restTwo && (
        <p class="ty-note">
          休市隔天不必提前搶：復市第一天的到貨量比平常多
          （連休 1 天 {restOne.volumePct > 0 ? '+' : ''}{restOne.volumePct}%、連休 2 天 {restTwo.volumePct > 0 ? '+' : ''}{restTwo.volumePct}%），
          均價幾乎不動（{restOne.pricePct > 0 ? '+' : ''}{restOne.pricePct}%、{restTwo.pricePct > 0 ? '+' : ''}{restTwo.pricePct}%）。
          <span class="muted">各市場的休市日點進去看。</span>
        </p>
      )}
    </div>

    <div class="tabs">
      {groups.map((g, i) => <input type="radio" name="mktlist" id={`ml-${g.tc}`} checked={i === 0} />)}
      <div class="tab-bar">
        {groups.map((g) => <label for={`ml-${g.tc}`}>{g.label}（{g.items.length}）</label>)}
      </div>
      <div class="panels">
        {groups.map((g) => (
          <div class="panel">
            <h2 class="sr-only" id={`ml-${g.tc}-hd`}>{g.label}批發市場清單（{g.items.length} 個）</h2>
            {/* 真的表格（2026-09-28）：原本休市日、品項數、類型全擠在名稱底下一行小字，跨列比不了。
                窄螢幕收起 hide-sm 欄、改在名稱小字（only-sm）補回，外觀維持兩行列。 */}
            <table class="tbl" aria-labelledby={`ml-${g.tc}-hd`}>
              <thead>
                <tr>
                  <th scope="col">市場</th>
                  <th scope="col" class="num hide-sm">下次休市</th>
                  <th scope="col" class="num hide-sm hide-md">品項數</th>
                  <th scope="col" class="num hide-sm hide-md">類型（前五大佔比）</th>
                  <th scope="col" class="num hide-sm">近 90 天交易日</th>
                  <th scope="col" class="w-nav"><span class="sr-only">導航</span></th>
                </tr>
              </thead>
              <tbody data-mkt-list>
                {g.items.map((m) => {
                  const gm = gOf(m);
                  // 導航目標：有座標就用座標（準），沒有就用市場名稱搜尋（三個市場在 OSM 查無）
                  const dest = gm.lat != null
                    ? `${gm.lat},${gm.lon}`
                    : (gm.nav ?? gm.fullName);
                  const rest = nextRest(m.code, m.tcType);
                  const mixShort = m.mix ? `${MIX_TEXT[m.mix.kind]}（${m.mix.top5Pct}%）` : '—';
                  return (
                  <tr data-lat={gm.lat ?? ''} data-lon={gm.lon ?? ''}>
                    <th scope="row">
                      {m.indexable
                        ? <a class="rl" href={`/market/${m.slug}/`}>{gm.fullName}</a>
                        : <span class="muted">{gm.fullName}</span>}
                      <span class="sub">
                        {/* 每一段（.g）不在中間斷行，只在「·」前面換行 */}
                        <span class="g">行情站寫「{m.name ?? m.code}」</span> <span class="g">· 代號 {m.code}</span>{!m.indexable && <> <span class="g">· 資料不足</span></>}
                        {rest && <> <span class="g only-sm">· 下次休市 {restDate(rest)}</span></>}
                        {m.mix && <> <span class="g only-md">· {m.mix.crops} 個品項</span> <span class="g only-md">· {MIX_TEXT[m.mix.kind]}（前五大 {m.mix.top5Pct}%）</span></>}
                        {' '}<span class="g only-sm">· 近 90 天交易 {m.days90} 天</span><span class="dist" hidden></span>
                      </span>
                    </th>
                    <td class="num hide-sm">{rest ? restDate(rest) : "—"}</td>
                    <td class="num tabular hide-sm hide-md">{m.mix ? m.mix.crops : '—'}</td>
                    <td class="num hide-sm hide-md">{mixShort}</td>
                    <td class={`num tabular hide-sm${m.indexable ? '' : ' muted'}`}>{m.days90} 天</td>
                    <td class="act">
                      <a class="nav-btn" target="_blank" rel="noopener"
                         href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(dest)}`}>導航</a>
                    </td>
                  </tr>
                )})}
              </tbody>
            </table>
          </div>
        ))}
      </div>
    </div>

    <div class="screen-ft">
      農糧署批發行情，更新至民國 {roc(idx.lastDate)} · <a href="/about/">資料說明</a>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('near-me');
      const msg = document.getElementById('near-msg');
      if (!navigator.geolocation) { btn.hidden = true; return; }

      // 直線距離（haversine）。實際路程一定更遠，所以文案寫「直線」，不寫「距離」
      const km = (a, b, c, d) => {
        const R = 6371, r = Math.PI / 180;
        const dLat = (c - a) * r, dLon = (d - b) * r;
        const h = Math.sin(dLat / 2) ** 2 + Math.cos(a * r) * Math.cos(c * r) * Math.sin(dLon / 2) ** 2;
        return 2 * R * Math.asin(Math.sqrt(h));
      };

      btn.addEventListener('click', () => {
        msg.textContent = '定位中…';
        navigator.geolocation.getCurrentPosition((pos) => {
          const { latitude: la, longitude: lo } = pos.coords;
          let sorted = 0, nocoord = 0;
          for (const tb of document.querySelectorAll('[data-mkt-list]')) {
            const items = [...tb.children];   // <tr>
            for (const li of items) {
              const lat = parseFloat(li.dataset.lat), lon = parseFloat(li.dataset.lon);
              const el = li.querySelector('.dist');
              if (Number.isFinite(lat) && Number.isFinite(lon)) {
                const d = km(la, lo, lat, lon);
                li.dataset.km = d;
                el.textContent = ` · 直線 ${d < 10 ? d.toFixed(1) : Math.round(d)} 公里`;
                el.hidden = false;
                sorted++;
              } else {
                li.dataset.km = Number.MAX_SAFE_INTEGER;   // 沒座標的排最後，但不隱藏
                el.textContent = ' · 無座標，不排距離';
                el.hidden = false;
                nocoord++;
              }
            }
            items.sort((x, y) => x.dataset.km - y.dataset.km).forEach((li) => tb.appendChild(li));
          }
          msg.textContent = `已依直線距離排序${nocoord ? `（${nocoord} 個市場查不到座標，排在最後）` : ''}`;
        }, (err) => {
          msg.textContent = err.code === err.PERMISSION_DENIED
            ? '你沒有允許定位，清單維持原本的排序' : '拿不到位置，清單維持原本的排序';
        }, { enableHighAccuracy: false, timeout: 10000, maximumAge: 600000 });
      });
    });
  </script>
</Base>
