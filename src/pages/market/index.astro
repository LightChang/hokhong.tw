---
import Base from '../../layouts/Base.astro';
import { siteIndex, marketGeo, roc, TC_LABEL, tcLabel } from '../../lib/pagedata.mjs';

const idx = await siteIndex();
const geo = await marketGeo();
const groups = ['N04', 'N05', 'N06'].map((tc) => ({
  tc, label: TC_LABEL[tc],
  items: idx.markets.filter((m) => m.tcType === tc).sort((a, b) => b.days90 - a.days90),
})).filter((g) => g.items.length);
---
<Base
  title="批發市場 — 好康 hó-khang"
  description="農糧署輔導的行情報導站清單，分蔬菜、水果、花卉。"
  lastDate={roc(idx.lastDate)}
  bare={true}
  crumbs={[{ name: '市場', path: '/market/' }]}
  itemList={groups.flatMap((g) => g.items.filter((m) => m.indexable).map((m) => ({
    name: (geo[m.code] ?? {}).fullName ?? m.name ?? m.code, path: `/market/${m.slug}/`,
  })))}
>
  <div class="shell screen">
    <div class="screen-hd">
      <a class="brand" href="/">好康 hó-khang</a>
      <nav>
        <a href="/cheap/">這週划算</a><a href="/crop/">找食材</a><a href="/market/">市場</a><a href="/about/">關於資料</a>
      </nav>
    </div>

    <div>
      {/* 標題不顯示在畫面上：導覽列已經說明你在哪一頁，內容直接開始。
          h1 仍留在 DOM（sr-only）給搜尋引擎與螢幕閱讀器。 */}
      <h1 class="sr-only">批發市場</h1>
      {/* 定位只在瀏覽器端算距離，座標不會送到任何地方（靜態站也沒有後端可送） */}
      <div class="list-tools" style="margin-top:0.75rem">
        <button type="button" id="near-me">📍 依距離排序</button>
        <span class="count" id="near-msg"></span>
      </div>
    </div>

    <div class="tabs">
      {groups.map((g, i) => <input type="radio" name="mktlist" id={`ml-${g.tc}`} checked={i === 0} />)}
      <div class="tab-bar">
        {groups.map((g) => <label for={`ml-${g.tc}`}>{g.label}（{g.items.length}）</label>)}
      </div>
      <div class="panels">
        {groups.map((g) => (
          <div class="panel">
            <h2 class="sr-only">{g.label}批發市場清單（{g.items.length} 個）</h2>
            <div class="rows-head two-col with-head-nav">
              <span>市場</span>
              <span class="num hide-sm">近 90 天交易日</span>
            </div>
            <ul class="rows two-col with-nav" style="margin-top:0" data-mkt-list>
              {g.items.map((m) => {
                const gm = geo[m.code] ?? {};
                // 導航目標：有座標就用座標（準），沒有就用市場名稱搜尋（三個市場在 OSM 查無）
                const dest = gm.lat != null
                  ? `${gm.lat},${gm.lon}`
                  : `${m.name ?? m.code}${m.tcType === 'N06' ? '花卉' : '果菜'}批發市場`;
                return (
                <li data-lat={gm.lat ?? ''} data-lon={gm.lon ?? ''}>
                  {m.indexable ? (
                    <a href={`/market/${m.slug}/`}>
                      <span class="nm">{gm.fullName ?? m.name ?? m.code}<span class="sub">
                        {tcLabel(m.tcType)} · 行情站寫「{m.name ?? m.code}」· 代號 {m.code}
                        <span class="only-sm"> · 近 90 天交易 {m.days90} 天</span><span class="dist" hidden></span>
                      </span></span>
                      <span class="num tabular hide-sm">{m.days90} 天</span>
                    </a>
                  ) : (
                    <span class="norow">
                      <span class="nm muted">{gm.fullName ?? m.name ?? m.code}<span class="sub">
                        {tcLabel(m.tcType)} · 行情站寫「{m.name ?? m.code}」· 資料不足
                        <span class="only-sm"> · 近 90 天交易 {m.days90} 天</span><span class="dist" hidden></span>
                      </span></span>
                      <span class="num tabular muted hide-sm">{m.days90} 天</span>
                    </span>
                  )}
                  <a class="nav-btn" target="_blank" rel="noopener"
                     href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(dest)}`}>導航</a>
                </li>
              )})}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="screen-ft">
      農糧署批發行情，更新至民國 {roc(idx.lastDate)} · <a href="/about/">資料說明</a>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('near-me');
      const msg = document.getElementById('near-msg');
      if (!navigator.geolocation) { btn.hidden = true; return; }

      // 直線距離（haversine）。實際路程一定更遠，所以文案寫「直線」，不寫「距離」
      const km = (a, b, c, d) => {
        const R = 6371, r = Math.PI / 180;
        const dLat = (c - a) * r, dLon = (d - b) * r;
        const h = Math.sin(dLat / 2) ** 2 + Math.cos(a * r) * Math.cos(c * r) * Math.sin(dLon / 2) ** 2;
        return 2 * R * Math.asin(Math.sqrt(h));
      };

      btn.addEventListener('click', () => {
        msg.textContent = '定位中…';
        navigator.geolocation.getCurrentPosition((pos) => {
          const { latitude: la, longitude: lo } = pos.coords;
          let sorted = 0, nocoord = 0;
          for (const ul of document.querySelectorAll('[data-mkt-list]')) {
            const items = [...ul.children];
            for (const li of items) {
              const lat = parseFloat(li.dataset.lat), lon = parseFloat(li.dataset.lon);
              const el = li.querySelector('.dist');
              if (Number.isFinite(lat) && Number.isFinite(lon)) {
                const d = km(la, lo, lat, lon);
                li.dataset.km = d;
                el.textContent = ` · 直線 ${d < 10 ? d.toFixed(1) : Math.round(d)} 公里`;
                el.hidden = false;
                sorted++;
              } else {
                li.dataset.km = Number.MAX_SAFE_INTEGER;   // 沒座標的排最後，但不隱藏
                el.textContent = ' · 無座標，不排距離';
                el.hidden = false;
                nocoord++;
              }
            }
            items.sort((x, y) => x.dataset.km - y.dataset.km).forEach((li) => ul.appendChild(li));
          }
          msg.textContent = `已依直線距離排序${nocoord ? `（${nocoord} 個市場查不到座標，排在最後）` : ''}`;
        }, (err) => {
          msg.textContent = err.code === err.PERMISSION_DENIED
            ? '你沒有允許定位，清單維持原本的排序' : '拿不到位置，清單維持原本的排序';
        }, { enableHighAccuracy: false, timeout: 10000, maximumAge: 600000 });
      });
    });
  </script>
</Base>
