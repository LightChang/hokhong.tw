---
// 台灣當季蔬果表（12 個月）：承接「當季水果表」「台灣 水果 產季」「當季蔬菜表」。
// 一列一個月，列出盛產表在那個月的水果與蔬菜，連到各月頁與品項頁。資料同 /season/<月>/（season.json）。
import FeedbackLink from '../../components/FeedbackLink.astro';
import SiteNav from '../../components/SiteNav.astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MethodLink from '../../components/MethodLink.astro';
import { seasonData, roc } from '../../lib/pagedata.mjs';

const sd = await seasonData();
const now = sd.months.find((x) => x.isDataMonth);
const byName = (xs) => [...xs].sort((a, b) => a.name.localeCompare(b.name, 'zh-Hant'));
const answer = `現在（${now.month} 月）當季的蔬菜水果有：蔬菜${now.veg.slice(0, 8).map((x) => x.name).join('、')}${now.veg.length > 8 ? ' 等' : ''} ${now.veg.length} 種，`
  + `水果${now.fruit.slice(0, 8).map((x) => x.name).join('、')}${now.fruit.length > 8 ? ' 等' : ''} ${now.fruit.length} 種。下表列出 1 到 12 月每個月的當季水果與蔬菜。`;
// 標題蔬菜在前（2026-11-22 改回）：10/31 曾改成水果在前（2aa8876），想接「當季水果」。GSC 10/24–10/30 對
// 11/14–11/20：本頁「當季蔬菜／現在當季蔬菜／季節蔬菜」這群查詢從名次 4.9、420 次曝光掉到 24.5、24 次，
// 「當季水果」也沒接到（名次 39.5），等於兩頭落空。改回蔬菜在前，尾巴留「當季水果表」。
const heading = `${now.month} 月當季蔬菜、水果有哪些？1 到 12 月蔬菜盛產表、當季水果表`;
const crumbs = [{ name: '當季蔬果', path: '/season/' }];
// 「當季又比常年便宜」的品項數，跟 /season/<這個月>/#ss-cheap 那份清單同一個篩法（season.json 的 now.changePct）
const cheapCount = [...now.fruit, ...now.veg].filter((x) => x.now?.changePct != null && Math.round(x.now.changePct) < 0 && x.now.price != null).length;
---
<Base
  title={`${heading} — 好康`}
  description={`${now.month} 月當季蔬菜 ${now.veg.length} 種、水果 ${now.fruit.length} 種；1 到 12 月每個月盛產的蔬菜、水果一覽，依農糧署盛產表，點月份看價格。`}
  lastDate={roc(sd.lastDate)}
  bare={true}
  crumbs={crumbs}
  itemList={sd.months.map((x) => ({ name: `${x.month} 月當季蔬果`, path: `/season/${x.month}/` }))}
>
  <div class="shell screen season-all">
    <div class="screen-hd">
      <a class="brand" href="/">好康 hó-khang</a>
      <SiteNav />
    </div>

    <div>
      <Breadcrumbs crumbs={crumbs} />
      <h1>{heading}</h1>
      <p class="answer">{answer}</p>
      <p class="fs-meta">
        <a href={`/season/${now.month}/`}>{now.month} 月當季蔬果現在便宜嗎 →</a>
        {cheapCount > 0 && <> · <a href={`/season/${now.month}/#ss-cheap`}>當季又比常年便宜的 {cheapCount} 種</a></>}
        <span class="print-act" hidden> · <button type="button" class="print-btn" id="season-print">列印這張表</button></span>
        · <MethodLink to="seasonal" />
      </p>
    </div>

    <div>
      <p class="print-only">台灣 1 到 12 月當季蔬菜水果表（農業部農糧署盛產表）· 好康 hokhong.tw/season/</p>
      <table class="tbl season-tbl">
        <caption class="sr-only">1 到 12 月的當季水果與蔬菜</caption>
        <thead>
          <tr>
            <th scope="col" class="wk">月份</th>
            <th scope="col">當季水果</th>
            <th scope="col" class="hide-sm">當季蔬菜</th>
          </tr>
        </thead>
        <tbody>
          {sd.months.map((x) => (
            <tr class={x.isDataMonth ? 'is-now' : undefined}>
              <th scope="row" class="wk"><a href={`/season/${x.month}/`}>{x.month} 月</a>{x.isDataMonth && <span class="season-tag"> · 現在</span>}</th>
              <td class="dishes">
                {byName(x.fruit).map((c, k, a) => <span class="nb"><a href={`/crop/${c.slug}/`}>{c.name}</a>{k < a.length - 1 && '、'}</span>)}
                <span class="sub only-sm"><strong>蔬菜：</strong>{byName(x.veg).map((c, k, a) => <span class="nb"><a href={`/crop/${c.slug}/`}>{c.name}</a>{k < a.length - 1 && '、'}</span>)}</span>
              </td>
              <td class="dishes hide-sm">{byName(x.veg).map((c, k, a) => <span class="nb"><a href={`/crop/${c.slug}/`}>{c.name}</a>{k < a.length - 1 && '、'}</span>)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="screen-ft">
      當季品項取自農業部農糧署盛產表 · 價格更新至民國 {roc(sd.lastDate)} · <a href="/today/">今日菜價查詢</a> · <a href="/about/">資料說明</a><FeedbackLink />
    </div>
  </div>

  <script is:inline>
    // 列印鈕只是加分：沒有 JS 時照樣可以用瀏覽器選單列印，印出來的版面一樣（見下方 @media print）
    document.addEventListener('DOMContentLoaded', () => {
      const b = document.getElementById('season-print');
      if (!b) return;
      b.closest('.print-act').hidden = false;
      b.addEventListener('click', () => { try { gtag('event', 'season_print'); } catch {} window.print(); });
    });
  </script>
</Base>

<style is:global>
  /* 只作用在本頁（.season-all）；用 global 而不是 scoped，scoped 會在表格每個連結上加屬性，頁面大三成 */
  .season-all .print-btn { font: inherit; color: var(--color-link); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; }
  .season-all .print-only { display: none; }

  /* 教學與排菜單用：A4 橫式一張，只留表格與出處。窄螢幕的「蔬菜併進水果欄」在紙上不需要，兩欄都展開。 */
  @media print {
    @page { size: A4 landscape; margin: 8mm; }
    .season-all .screen-hd, .season-all .crumbs, .season-all h1, .season-all .answer, .season-all .fs-meta { display: none; }
    body:has(.season-all) { background: none; }
    .season-all.screen { color: var(--text-primary); padding: 0; gap: 0; max-width: none; padding-inline: 0; }
    .season-all .print-only { display: block; font-size: var(--text-xs); font-weight: 700; margin: 0 0 var(--space-1); }
    .season-all .season-tbl { width: 100%; margin: 0; font-size: var(--text-xs); line-height: 1.25; }
    .season-all .season-tbl th, .season-all .season-tbl td { padding: 0.15rem 0.3rem; font-size: var(--text-xs); }
    .season-all .season-tbl th.hide-sm, .season-all .season-tbl td.hide-sm { display: table-cell; }
    .season-all .season-tbl .sub.only-sm { display: none; }
    .season-all .season-tbl tr { break-inside: avoid; }
    .season-all .season-tbl a { color: var(--text-primary); text-decoration: none; }
    .season-all .season-tbl tr.is-now { background: none; }
    .season-all .screen-ft a { color: var(--text-secondary); text-decoration: none; }
  }
</style>
