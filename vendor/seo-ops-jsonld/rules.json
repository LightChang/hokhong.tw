  "global": {
    "scriptTag": {
      "rule": "JSON-LD 放在 <script type=\"application/ld+json\">；Google 建議 JSON-LD 格式。",
      "mimeType": "application/ld+json",
      "source": "https://developers.google.com/search/docs/appearance/structured-data/sd-policies",
      "verifiedAt": "2026-09-27"
    },
    "jsonParse": {
      "rule": "每個 ld+json 區塊必須是合法 JSON，否則整塊被忽略（Search Console「無法剖析的結構化資料」）。",
      "severity": "error",
      "source": "https://developers.google.com/search/docs/appearance/structured-data/sd-policies",
      "verifiedAt": "2026-09-27"
    },
    "scriptContent": {
      "rule": "script 內容遇到 </script（不分大小寫）就結束；字串裡的 </script、<!--、<script 必須跳脫（例如把 < 輸出成 \\u003c）。",
      "forbiddenSequences": [
        "</script",
        "<!--",
        "<script"
      ],
      "severity": "error",
      "source": "https://html.spec.whatwg.org/multipage/scripting.html#restrictions-for-contents-of-script-elements",
      "verifiedAt": "2026-09-27"
    },
    "astroOutput": {
      "rule": "Astro 的 set:html 不會自動跳脫；<script> 只要有 src 以外的屬性（如 type=\"application/ld+json\"）Astro 就不處理，is:inline 可加可不加。官方範例為 set:html={JSON.stringify(obj)}，但文件未處理 </script> 截斷，需自行把 < 換成 \\u003c。",
      "recommended": "<script type=\"application/ld+json\" set:html={JSON.stringify(obj).replace(/</g, \"\\\\u003c\")} />",
      "source": "https://docs.astro.build/en/reference/directives-reference/#sethtml",
      "verifiedAt": "2026-09-27"
    },
    "astroBuildDone": {
      "rule": "astro:build:done 參數：{ pages: { pathname }[], dir: URL, assets: Map<string, URL[]>, logger }；dir 是輸出目錄，用 fileURLToPath(dir) 取路徑。",
      "source": "https://docs.astro.build/en/reference/integrations-reference/#astrobuilddone",
      "verifiedAt": "2026-09-27"
    },
    "visibleContent": {
      "rule": "不要標記讀者看不到的內容；結構化資料放在它描述的那一頁。驗證器無法機器檢查，列為人工檢查項。",
      "machineCheck": false,
      "source": "https://developers.google.com/search/docs/appearance/structured-data/sd-policies",
      "verifiedAt": "2026-09-27"
    },
    "imagesCrawlable": {
      "rule": "結構化資料中的圖片網址必須可被檢索與索引。驗證器只檢查是否為絕對網址。",
      "machineCheck": false,
      "source": "https://developers.google.com/search/docs/appearance/structured-data/sd-policies",
      "verifiedAt": "2026-09-27"
    },
    "noGuarantee": {
      "rule": "即使標記正確，Google 也不保證顯示強化結果。",
      "source": "https://developers.google.com/search/docs/appearance/structured-data/sd-policies",
      "verifiedAt": "2026-09-27"
    },
    "absoluteUrls": {
      "rule": "下列屬性若為字串，必須是 http(s) 絕對網址。依據：carousel 文件要求 item.url 為 fully-qualified URL、breadcrumb／site names 範例皆為絕對網址。Google 文件沒有對「所有屬性一律絕對」的明文，這條是本規則檔的站內政策（house policy）。",
      "policy": "house",
      "properties": [
        "url",
        "item",
        "@id",
        "image",
        "logo",
        "contentUrl",
        "sameAs",
        "license",
        "isBasedOn"
      ],
      "allowFragmentId": false,
      "severity": "error",
      "source": "https://developers.google.com/search/docs/appearance/structured-data/carousel",
      "verifiedAt": "2026-09-27"
    },
    "context": {
      "rule": "@context 使用 https://schema.org（官方範例寫法）。",
      "expected": [
        "https://schema.org",
        "https://schema.org/",
        "http://schema.org",
        "http://schema.org/"
      ],
      "severity": "warning",
      "source": "https://developers.google.com/search/docs/appearance/structured-data/sd-policies",
      "verifiedAt": "2026-09-27"
    }
  },
