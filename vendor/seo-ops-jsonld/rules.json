      "match": [
        "ItemList"
      ],
      "optIn": true,
      "optInNote": "ItemList 本身在 Google 沒有獨立功能；只有當清單是 carousel（課程清單等）時這些必填才有意義。站台在 jsonld-pages.json 對該頁型寫 \"apply\": [\"ItemList\"] 才套用。",
      "scope": "top-level",
      "required": [
        "itemListElement",
        "itemListElement[].position",
