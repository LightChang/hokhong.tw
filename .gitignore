# 依賴
node_modules/

# 建置產出（每天由 transform/run.mjs 重新產生）
dist/
.astro/

# llms.txt（導覽＋引用前提）與 llms-full.txt（可引用全文）都是 transform/emit-llms-full.mjs
# 每次 transform 重新產出的：裡面的涵蓋範圍與價格會跟著當天資料變，不進版控（同 dist/ 的理由）。
# 文案本身在那支程式裡，要改措辭改程式，不要改產出的 txt。
public/llms.txt
public/llms-full.txt

# 原始資料與衍生資料：好幾百 MB（現值 node scripts/status.mjs data），且都可以重新抓取／重算，
# 不進版控。
#   ingest/raw/    ← 各來源的原始回應（gz），farm-trans 一個交易日一個檔
#   data/parquet/  ← 由 raw 轉出的欄式儲存
#   data/page/     ← 由 parquet 算出的 per-page JSON（3,440 個）
#   data/identity/ 與 data/observation/ ← 身分對應與觀測歷史，同樣可重算
# 重建方式見 README 與 transform/STORAGE.md。
ingest/raw/
ingest/log/
data/

# 執行狀態：記錄每個來源上次抓取時間與本機絕對路徑，屬於執行環境而非專案內容
ingest/state.json

# scripts/publish-data.sh 產生的暫存打包檔（數百 MB，上傳 release 後就刪）
# 曾經因為在它執行到一半時跑 git add -A，把 569 MB 的 tar 加進 commit
*.tar.gz
*.tgz

# 本機工具設定與日誌（與專案內容無關）
.claude/
*.log

# 作業系統與編輯器
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
